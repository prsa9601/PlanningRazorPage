@page
@model PlanningRazorPage.Pages.Auth.RequestNewPasswordModel
@{
    Layout = "../Shared/_Layout";
    ViewData["Title"] = "🔑 درخواست تغییر پسورد";
}

@section Header {
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #FF6B6B 0%, #FFE66D 100%);
            --secondary-gradient: linear-gradient(135deg, #4ECDC4 0%, #45B7AF 100%);
            --glass-effect: linear-gradient(145deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05));
            --neon-shadow: 0 0 20px rgba(255,107,107,0.3);
            --success-color: #2ecc71;
            --danger-color: #e74c3c;
        }

        .auth-container {
            min-height: 100vh;
            background: var(--primary-gradient);
            position: relative;
            overflow: hidden;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(15px);
            border-radius: 2rem;
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            border: 2px solid #FF6B6B;
            padding: 2.5rem;
            margin: 2rem;
        }

        .request-header {
            text-align: center;
            position: relative;
            margin-bottom: 3rem;
        }

        .request-icon {
            font-size: 5rem;
            color: #FF6B6B;
            animation: pulse 2s infinite;
        }

        .status-box {
            margin-top: 20px;
            padding: 10px;
            border: 1px solid #ccc;
            display: none; /* مخفی کردن باکس وضعیت در ابتدا */
            border-radius: 1rem;
            text-align: center;
        }

        .status-success {
            color: var(--success-color);
            background: rgba(46, 204, 113, 0.1);
        }

        .status-error {
            color: var(--danger-color);
            background: rgba(231, 76, 60, 0.1);
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-top: 3rem;
        }

        .btn-glow {
            background: var(--secondary-gradient);
            color: white !important;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            border: none;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .btn-glow:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(78, 205, 196, 0.4);
            }
    </style>
}

<div class="auth-container">
    <div class="glass-card" data-aos="zoom-in">
        <div class="request-header">
            <i class="fas fa-key request-icon"></i>
            <h1 class="display-5 fw-bold">درخواست تغییر پسورد</h1>
        </div>

        <form id="requestPasswordForm" method="post">
            <input type="email" id="Email" name="Email" placeholder="ایمیل خود را وارد کنید" required class="form-control mb-3" />
            <div id="status" class="status-box"></div> <!-- باکس وضعیت -->

            <div class="action-buttons">
                <button type="button" class="btn-glow" id="sendEmailButton">
                    <i class="fas fa-paper-plane"></i>
                    ارسال ایمیل
                </button>
                <a href="/" class="btn-glow">
                    <i class="fas fa-home"></i>
                    بازگشت به خانه
                </a>
            </div>
        </form>
    </div>
</div>
<div id="ajax-token">
    @Html.AntiForgeryToken()
</div>
@section Scripts {
    <script>
        document.getElementById('sendEmailButton').addEventListener('click', async function(event) {
            event.preventDefault(); // جلوگیری از ارسال فرم به صورت پیش‌فرض

             //emailInput = document.querySelector('input[name="Email"]');
            emailInput = document.getElementById('Email');
             email = emailInput.value;
             statusBox = document.getElementById('status');
            statusBox.style.display = 'block'; // نمایش باکس وضعیت
            alert(email);
            try {
                         response = await fetch('?handler=Send', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: new URLSearchParams({
                'email': email // نام پارامتر باید با سی شارپ همخوانی داشته باشد
            })
        });

                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }

                 data = await response.json();
                if (data.success) {
                    statusBox.textContent = 'ایمیل با موفقیت ارسال شد!';
                    statusBox.className = 'status-box status-success';
                } else {
                    statusBox.textContent = 'مشکلی در ارسال ایمیل پیش آمد: ' + data.message;
                    statusBox.className = 'status-box status-error';
                }
            } catch (error) {
                console.error('Error sending email:', error);
                statusBox.textContent = 'خطا در ارسال ایمیل. لطفاً دوباره تلاش کنید.';
                statusBox.className = 'status-box status-error';
            }
        });

