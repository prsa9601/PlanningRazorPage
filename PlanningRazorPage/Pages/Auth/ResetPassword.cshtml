@page
@model PlanningRazorPage.Pages.Auth.ResetPasswordModel
@{
    Layout = "../Shared/_Layout";
    ViewData["Title"] = "🌈 تنظیم رمز عبور جدید";
}

@section Header {
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #FF6B6B 0%, #FFE66D 100%);
            --glass-effect: linear-gradient(145deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05));
            --neon-shadow: 0 0 20px rgba(255,107,107,0.3);
        }

        .auth-container {
            min-height: 100vh;
            background: var(--primary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(15px);
            border-radius: 2rem;
            box-shadow: var(--neon-shadow);
            padding: 3rem;
            width: 100%;
            max-width: 500px;
        }

        .password-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .password-icon {
            font-size: 3rem;
            color: #FF6B6B;
            margin-bottom: 1rem;
        }

        .form-password-toggle {
            margin-bottom: 1.5rem;
        }

        .btn-glow {
            background: var(--primary-gradient);
            color: white !important;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            border: none;
            width: 100%;
            transition: all 0.3s ease;
        }
    </style>
}

<div class="auth-container">
    <div class="glass-card" data-aos="zoom-in">
        <div class="password-header">
            <i class="fas fa-lock password-icon"></i>
            <h2 class="fw-bold">رمز عبور جدید را وارد کنید</h2>
            <p class="text-muted">رمز عبور جدید باید حداقل 8 کاراکتر و ترکیبی از حروف و اعداد باشد</p>
        </div>

        <form method="post" id="resetForm">
 @*            <input type="hidden" asp-for="Model.Token" />
            <input type="hidden" asp-for="Model.Email" /> *@

            <div class="form-password-toggle">
                <div class="input-group">
                    <input type="password"
                           class="form-control"
                           asp-for="@Model.NewPassword"
                           placeholder="رمز عبور جدید">
                    <span class="input-group-text cursor-pointer">
                        <i class="mdi mdi-eye-off-outline"></i>
                    </span>
                </div>
                <span asp-validation-for="@Model.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-password-toggle">
                <div class="input-group">
                    <input type="password"
                           class="form-control"
                           asp-for="@Model.ConfirmPassword"
                           placeholder="تکرار رمز عبور">
                    <span class="input-group-text cursor-pointer">
                        <i class="mdi mdi-eye-off-outline"></i>
                    </span>
                </div>
                <span asp-validation-for="@Model.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-glow mt-4">
                <i class="fas fa-key me-2"></i>
                ثبت رمز جدید
            </button>
        </form>

        <div class="text-center mt-3">
            <a asp-page="Login" class="text-decoration-none">
                <i class="fas fa-arrow-right me-2"></i>
                بازگشت به صفحه ورود
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById('resetForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const form = e.target;
            const formData = new FormData(form);

            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken':
                        document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => {
                if(response.redirected) {
                    window.location.href = response.url;
                }
                else if(response.ok) {
                    return response.json();
                }
            })
            .then(result => {
                if(result && result.IsSuccess) {
                    Swal.fire({
                        icon: 'success',
                        title: 'موفقیت آمیز!',
                        text: 'رمز عبور شما با موفقیت تغییر یافت',
                        confirmButtonColor: '#FF6B6B'
                    }).then(() => {
                        window.location.href = '/Auth/Login';
                    });
                }
            })
            .catch(error => {
                Swal.fire({
                    icon: 'error',
                    title: 'خطا!',
                    text: 'مشکلی در تغییر رمز عبور رخ داد',
                    confirmButtonColor: '#FF6B6B'
                });
            });
        });
    </script>
}