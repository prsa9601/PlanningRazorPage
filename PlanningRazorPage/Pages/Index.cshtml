               //updateEventDate
                function updateEventOnServer(event) {
          const eventId = event.id;
          const newStart = event.start;
          const newEnd = event.end || newStart; // اگر end وجود نداشت از start استفاده کن
          console.log(event.id);
          var token = $("#ajax-token input[name='__RequestVerificationToken']").val();
          $.ajax({
            url: "index?handler=UpdateEventDate",
            type: "post",
            data: {
              id: eventId,
              newStart: newStart.toISOString(),
              newEnd: newEnd ? newEnd.toISOString() : null,
              __RequestVerificationToken: token
            }
          }).done(function(data) {
            console.log('تاریخ رویداد با موفقیت آپدیت شد.');
          }).fail(function(jqXHR, textStatus, errorThrown) {
            console.error('خطا در آپدیت تاریخ رویداد:', errorThrown);
            alert('خطا در آپدیت تاریخ رویداد.');
          });
        }
            // Init FullCalendar
