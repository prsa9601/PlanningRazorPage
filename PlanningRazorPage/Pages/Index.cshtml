                // Submit the form when all fields are valid
                // defaultSubmit: new FormValidation.plugins.DefaultSubmit(),
                autoFocus: new FormValidation.plugins.AutoFocus()
              }
            }).on('core.form.valid', function () {
              // Jump to the next step when all fields in the current step are valid
              isFormValid = true;
            });

            // Sidebar Toggle Btn
            if (btnToggleSidebar) {
              btnToggleSidebar.addEventListener('click', e => {
                btnCancel.classList.remove('d-none');
              });
            }

            // AddEvent
            // ------------------------------------------------
             function addEvent(eventData) {
                // Add new event data to current events object and refetch it to display on calendar
                // You can write below code to AJAX call success response
                var eventTitle = document.getElementById("eventTitle").value;
                var eventLabel = document.getElementById("eventLabel").value; // این متغیر تعریف شده است
                var eventStartDate = document.getElementById("eventStartDate").value;
                var eventEndDate = document.getElementById("eventEndDate").value;
                var allDaySwitch = document.querySelector(".allDay-switch").checked;
                var eventUrl = document.getElementById("eventURL").value;
                var eventGuests = Array.from(document.getElementById("eventGuests").selectedOptions).map(option => option.value);
                var eventLocation = document.getElementById("eventLocation").value;
                var eventDescription = document.getElementById("eventDescription").value;
                var AccessNotification = true;
                if(allDaySwitch == false){
                    AccessNotification = false;
                }
                if(allDaySwitch == true){
                    AccessNotification = true;
                }

                var token = $("#ajax-token input[name='__RequestVerificationToken']").val();
                // alert(token);

                $.ajax({
                    url: "index?handler=Add",
                    type: "post",
                    data: {
                        title: eventTitle
                        ,startTime: eventStartDate
                        ,endTime: eventEndDate
                        ,link: eventUrl
                        ,eventAddress: eventLocation
                        ,Tag: eventLabel
                        ,description: eventDescription
                        ,friendUserNames: eventGuests
                        ,accessNotification: AccessNotification
                        ,notification: "sms"
                        ,__RequestVerificationToken: token
                    }
                }).done(function(data) {
                // در صورت موفقیت‌آمیز بودن درخواست، رویداد را در تقویم به‌روزرسانی کنید
                currentEvents.push(eventData);
