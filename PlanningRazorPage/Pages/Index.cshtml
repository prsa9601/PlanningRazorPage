        //GetEvents
        function fetchEvents(info, successCallback) {
            var token = $("#ajax-token input[name='__RequestVerificationToken']").val();

            $.ajax({
                url: "index?handler=Events",
                type: "get",
                data: {
                    __RequestVerificationToken: token
                }
            }).done(function(data) {
                console.log('داده‌های خام دریافتی:', data);

                // تبدیل داده‌ها به فرمت FullCalendar با بررسی کامل
                let formattedEvents = data.map(event => {
                    // اعتبارسنجی فیلدهای ضروری
                    if (!event.id || !event.start || !event.end) {
                        console.warn('رویداد نامعتبر:', event);
                        return null;
                    }

                    // تبدیل تاریخ‌ها با استفاده از JDate برای تاریخ شمسی
                    // const startDate = new JDate(event.start);
                    // const endDate = new JDate(event.end);
                    //         var q = document.querySelector("input#eventUR.form-control");
                    // q.value=event.url;
                    // console.log(q.value);
                    return {
                        id: event.id, // تبدیل به string برای مطابقت با FullCalendar
                        title: event.title || 'بدون عنوان',
                        start: new Date(event.start), // تبدیل به تاریخ میلادی
                        end:new Date(event.end),
                        allDay: event.allDay || false,
                        extendedProps: {
                            calendar: (event.extendedProps.calendar || 'ETC').trim(),/* .toLowerCase() */ // تبدیل به حروف کوچک
                            location: event.location || '',
                            description: event.description || '',
                            guests: event.guests || [],
                        },
                        url: event.url || '',
                        // url: event.url || '',
                        // description: event.description,
                        display: 'auto'
                    };
                }).filter(event => event !== null); // حذف رویدادهای نامعتبر

                console.log('داده‌های تبدیل شده:', formattedEvents);

                // ذخیره در currentEvents
                currentEvents = formattedEvents;

                // دریافت تقویم‌های انتخاب شده
                let calendars = selectedCalendars();
                console.log('تقویم‌های انتخاب شده:', calendars);

                // فیلتر نهایی
                let selectedEvents = currentEvents.filter(event => {
                    const eventCalendar = event.extendedProps.calendar.toLowerCase();
                    return calendars.includes(eventCalendar);
                });

                console.log('رویدادهای فیلتر شده:', selectedEvents);

                // ارسال به FullCalendar
              if (selectedEvents.length > 0) {

                successCallback(selectedEvents);

              }

            }).fail(function(jqXHR, textStatus, errorThrown) {
                console.error('خطا در دریافت رویدادها:', errorThrown);
                alert('خطا در دریافت رویدادها');
            });
