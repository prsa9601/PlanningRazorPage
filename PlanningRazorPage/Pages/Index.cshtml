               document.addEventListener('DOMContentLoaded', function() {
            const token = document.querySelector('#ajax-token input[name="__RequestVerificationToken"]').value;
            const notificationList = document.querySelector('.dropdown-notifications-list');

            async function markAsRead(notificationId, type, element) {
                try {
                    if (!element.classList.contains('unread')) return;

                    const response = await fetch('/Index?handler=MarkNotificationAsRead', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: new URLSearchParams({
                            'notificationId': notificationId,
                            'type': type
                        })
                    });

                    if (response.ok) {
                        const data = await response.json();
                        if (data.success) {
                            element.classList.remove('unread');
                            const badge = element.querySelector('.badge-dot');
                            if (badge) badge.remove();

                            updateNotificationCount();
                        }
                    }
                } catch (error) {
                    console.error('خطا در بروزرسانی نوتیفیکیشن:', error);
                }
            }

            function updateNotificationCount() {
                const notificationCount = document.querySelector('.notification-count');
                const unreadItems = document.querySelectorAll('.dropdown-notifications-item.unread');
                const mainBadge = document.getElementById('notificationBadge');

                if (notificationCount) {
                    notificationCount.textContent = unreadItems.length;

                    if (unreadItems.length === 0 && mainBadge) {
                        mainBadge.remove();
                    } else if (unreadItems.length > 0 && !mainBadge) {
                        const newBadge = document.createElement('span');
                        newBadge.id = 'notificationBadge';
                        newBadge.className = 'position-absolute top-0 start-50 translate-middle-y badge badge-dot bg-danger mt-2 border';
                        document.querySelector('.nav-link').appendChild(newBadge);
                    }
                }
            }

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const element = entry.target;
                        const notificationId = element.dataset.notificationId;
                        const type = element.dataset.notificationType || 'Notification'; // مقدار پیشفرض

                        markAsRead(notificationId, type, element);
                        observer.unobserve(element);
                    }
                });
            }, { threshold: 0.5 });

            // اضافه کردن ویژگی data-type به آیتم‌های نوتیفیکیشن
            document.querySelectorAll('.dropdown-notifications-item').forEach(item => {
                item.dataset.type = 'Notification'; // یا 'UserNotification' بسته به نوع
                observer.observe(item);
            });
        });
    </script>
    <div id="ajax-token">
        @Html.AntiForgeryToken()
    </div>

