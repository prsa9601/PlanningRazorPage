@page
@using PlanningRazorPage.Infrastructure
@model PlanningRazorPage.Pages.Admin.User.IndexModel
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "🌈 مدیریت کاربران";
}

@section Header {
    
    <style>
        /* به روزرسانی کلاس اصلی دکمه‌ها */
        .btn-edit,
        .btn-delete,
        .btn-roles,
        .btn-details { /* اضافه کردن btn-details به کلاس اصلی */
            padding: 0.8rem 1.5rem;
            border-radius: 1.5rem;
            border: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
        }

        /* استایل خاص دکمه جزئیات */
        .btn-details {
            background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
            color: white !important;
            box-shadow: 0 4px 15px rgba(46, 204, 113, 0.3);
            position: relative;
            overflow: hidden;
        }

            .btn-details:hover {
                transform: translateY(-3px) scale(1.05);
                box-shadow: 0 8px 25px rgba(46, 204, 113, 0.4);
            }

            .btn-details span::after {
                content: '📄'; /* آیکون جدید */
                margin-right: 0.5rem;
                transition: all 0.3s ease;
                display: inline-block;
                filter: drop-shadow(0 2px 4px rgba(46, 204, 113, 0.3));
            }

            .btn-details:hover span::after {
                transform: rotate(15deg) scale(1.2) translateY(-2px);
                filter: drop-shadow(0 3px 6px rgba(46, 204, 113, 0.4));
            }

            /* افکت نور یکسان با سایر دکمه‌ها */
            .btn-details::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient(45deg, transparent, rgba(255,255,255,0.3), transparent);
                animation: shine 3s infinite;
                opacity: 0.3;
            }
        .pagination {
            --pagination-color: #FF6B6B;
            --pagination-active-bg: var(--success-color);
            --pagination-hover-color: #e55a5a;
        }

        .page-item.active .page-link {
            background-color: var(--pagination-active-bg);
            border-color: var(--pagination-active-bg);
            color: white;
        }

        .page-link {
            color: var(--pagination-color);
            border: 2px solid rgba(255,107,107,0.3);
            margin: 0 4px;
            border-radius: 1rem !important;
            transition: all 0.3s ease;
        }

            .page-link:hover {
                color: var(--pagination-hover-color);
                background-color: rgba(255,107,107,0.1);
                border-color: var(--pagination-color);
            }

        .page-item:first-child .page-link,
        .page-item:last-child .page-link {
            border-radius: 1rem !important;
        }
        :root {
            --primary-gradient: linear-gradient(135deg, #FF6B6B 0%, #FFE66D 100%);
            --secondary-gradient: linear-gradient(135deg, #4ECDC4 0%, #45B7AF 100%);
            --glass-effect: linear-gradient(145deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05));
            --neon-shadow: 0 0 20px rgba(255,107,107,0.3);
            --success-color: #2ecc71;
            --danger-color: #e74c3c;
        }

        .user-management-card {
            border-radius: 2rem;
            background: rgba(255,255,255,0.95);
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            margin: 2rem;
            overflow: hidden;
            border: 2px solid #FF6B6B;
        }

        .table-header-custom {
            background: var(--primary-gradient);
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

            .table-header-custom::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient(45deg, transparent, rgba(255,255,255,0.3), transparent);
                animation: shine 3s infinite;
            }

        .table-responsive-xxl {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: thin;
            scrollbar-color: #FF6B6B #f1f1f1;
            padding-bottom: 8px;
        }

            .table-responsive-xxl::-webkit-scrollbar {
                height: 8px;
            }

            .table-responsive-xxl::-webkit-scrollbar-track {
                background: #f1f1f1;
                border-radius: 10px;
            }

            .table-responsive-xxl::-webkit-scrollbar-thumb {
                background: #FF6B6B;
                border-radius: 10px;
            }

                .table-responsive-xxl::-webkit-scrollbar-thumb:hover {
                    background: #e55a5a;
                }

        .user-table {
            min-width: 1200px;
            --hover-scale: 1.02;
            --hover-bg: rgba(255,235,235,0.9);
            width: 100%;
            border-collapse: collapse;
        }

            .user-table tr {
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                background: rgba(255,255,255,0.9);
            }

                .user-table tr:hover {
                    transform: scale(var(--hover-scale));
                    background: var(--hover-bg);
                    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
                }

            .user-table th,
            .user-table td {
                padding: 1rem;
            }

        .table-title {
            font-family: 'Yekan', sans-serif;
            font-size: 2.5rem;
            color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }

        .user-avatar {
            width: 72px;
            height: 72px;
            border: 3px solid #fff;
            box-shadow: var(--neon-shadow);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .user-avatar:hover {
                transform: rotate(15deg) scale(1.1);
                filter: hue-rotate(45deg);
            }

        .status-toggle {
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 1rem;
            background: var(--glass-effect);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
        }

            .status-toggle:hover {
                transform: translateY(-2px);
                box-shadow: var(--neon-shadow);
            }

        .status-badge {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .status-active {
            background: var(--success-color);
            color: white;
        }

        .status-inactive {
            background: var(--danger-color);
            color: white;
        }

        .verification-icon {
            font-size: 1.5rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .verification-icon.verified {
                color: var(--success-color);
                text-shadow: 0 0 15px rgba(46, 204, 113, 0.4);
            }

            .verification-icon.unverified {
                color: var(--danger-color);
                text-shadow: 0 0 15px rgba(231, 76, 60, 0.3);
            }

        .user-email,
        .user-phone {
            direction: ltr;
            font-family: monospace;
            padding: 0.5rem 1rem;
            border-radius: 1rem;
            background: rgba(255,255,255,0.9);
            transition: all 0.3s ease;
        }

        .floating-action-btn {
            background: var(--primary-gradient);
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            box-shadow: var(--neon-shadow);
            transition: all 0.3s ease;
            position: fixed;
            bottom: 2rem;
            left: 2rem;
        }

            .floating-action-btn:hover {
                transform: rotate(360deg) scale(1.1);
            }

        .action-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
        }

        .btn-edit,
        .btn-delete,
        .btn-roles {
            padding: 0.8rem 1.5rem;
            border-radius: 1.5rem;
            border: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
        }

        .btn-edit {
            background: var(--secondary-gradient);
            color: white !important;
            box-shadow: 0 4px 15px rgba(78, 205, 196, 0.3);
        }

        .btn-delete {
            background: var(--primary-gradient);
            color: white !important;
            box-shadow: 0 4px 15px rgba(255, 107, 107, 0.3);
        }

        .btn-roles {
            background: linear-gradient(135deg, #9b59b6 0%, #e74c3c 100%);
            color: white !important;
            box-shadow: 0 4px 15px rgba(155, 89, 182, 0.3);
        }

            .btn-edit:hover,
            .btn-delete:hover,
            .btn-roles:hover {
                transform: translateY(-3px) scale(1.05);
            }

        .btn-edit:hover {
            box-shadow: 0 8px 25px rgba(78, 205, 196, 0.4);
        }

        .btn-delete:hover {
            box-shadow: 0 8px 25px rgba(255, 107, 107, 0.4);
        }

        .btn-roles:hover {
            box-shadow: 0 8px 25px rgba(155, 89, 182, 0.4);
        }

        .btn-edit span::after {
            content: '✏️';
            margin-right: 0.5rem;
            transition: all 0.3s ease;
        }

        .btn-delete span::after {
            content: '🗑️';
            margin-right: 0.5rem;
            transition: all 0.3s ease;
        }

        .btn-roles span::after {
            content: '👑';
            margin-right: 0.5rem;
            transition: all 0.3s ease;
        }

        .btn-edit:hover span::after,
        .btn-delete:hover span::after,
        .btn-roles:hover span::after {
            transform: rotate(15deg) scale(1.2);
        }

        @@keyframes shine {
            100% {
                transform: translate(100%, 100%) rotate(45deg);
            }
        }

        @@media (max-width: 768px) {
            .user-management-card {
                margin: 1rem;
                border-radius: 1.5rem;
            }

            .table-header-custom {
                padding: 1.5rem;
            }

            .table-title {
                font-size: 2rem;
            }

            .user-table {
                display: block;
                overflow-x: auto;
                min-width: unset;
            }

                .user-table thead {
                    display: none;
                }

                .user-table tr {
                    display: block;
                    margin-bottom: 1rem;
                    border-radius: 1rem;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                }

                .user-table td {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    padding: 0.75rem 1rem;
                    border-bottom: 1px solid #eee;
                }

                    .user-table td::before {
                        content: attr(data-label);
                        font-weight: bold;
                        flex: 0 0 120px;
                        color: #FF6B6B;
                        margin-left: 1rem;
                    }

            .action-buttons {
                flex-direction: column;
                gap: 0.5rem;
            }

            .btn-edit,
            .btn-delete,
            .btn-roles {
                width: 100%;
                justify-content: center;
                padding: 0.7rem 1rem;
            }

            .floating-action-btn {
                width: 50px;
                height: 50px;
                bottom: 1rem;
                left: 1rem;
            }
        }

        @@media (max-width: 480px) {
            .user-avatar {
                width: 50px;
                height: 50px;
            }

            .status-toggle {
                flex-direction: column;
                text-align: center;
            }

            .user-table td::before {
                flex: 0 0 100px;
                font-size: 0.8rem;
            }
        }
    </style>
}

<div class="user-management-card">
    <div class="table-header-custom">
        <h5 class="table-title mb-0">
            🎪 مدیریت کاربران
        </h5>
    </div>

    <div class="table-responsive-xxl p-4">
        <table class="table user-table align-middle">
            <thead>
                <tr>
                    <th data-label="تصویر">🎭 تصویر</th>
                    <th data-label="نام کاربری">👤 نام کاربری</th>
                    <th data-label="ایمیل">📧 ایمیل</th>
                    <th data-label="شماره">📱 شماره</th>
                    <th data-label="وضعیت">✅ وضعیت</th>
                    <th data-label="تأیید شماره">📞 شماره</th>
                    <th data-label="تأیید ایمیل">📧 ایمیل</th>
                    <th data-label="عملیات" class="text-center">✨ عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Users.Data)
                {
                    <tr>
                        <td data-label="تصویر">
                            <div class="avatar-wrapper">
                                <img src="@Directories.GetAvatar(item.avatar.Avatar.ToString())"
                                     class="user-avatar"
                                     alt="آواتار کاربر"
                                     loading="lazy">
                            </div>
                        </td>
                        <td data-label="نام کاربری" class="fw-bold">@item.UserName</td>
                        <td data-label="ایمیل">
                            <div class="user-email">
                                @item.Email
                            </div>
                        </td>
                        <td data-label="شماره">
                            <div class="user-phone">
                                @item.PhoneNumber
                            </div>
                        </td>
                        <td data-label="وضعیت">
                            <div class="status-toggle"
                                 onclick="ToggleStatus('IsActive', '@item.Id','@item.IsActive', this)">
                                <div class="status-badge @(item.IsActive ? "status-active" : "status-inactive")">
                                    @(item.IsActive ? "✓" : "✕")
                                </div>
                                <span>@(item.IsActive ? "فعال" : "غیرفعال")</span>
                            </div>
                        </td>
                      @*   <td data-label="تأیید شماره">
                                <div class="status-badge @(item.IsActive ? "status-active" : "status-inactive")">
                                    @(item.IsActive ? "✓" : "✕")
                                </div>
                            <span>@(item.IsActive ? "تاییدشده" : "تاییدنشده")</span>
                        </td>
                        <td data-label="تأیید ایمیل">
                               <div class="status-badge @(item.IsActive ? "status-active" : "status-inactive")">
                                    @(item.IsActive ? "✓" : "✕")
                                </div>
                            <span>@(item.IsActive ? "تاییدشده" : "تاییدنشده")</span>
                        </td> *@
                        <!-- قسمت تأیید شماره تماس -->
                        <td data-label="تأیید شماره">
                            <div class="status-toggle"
                                 onclick="ToggleStatus('PhoneNumberConfirmed', '@item.Id','@item.PhoneNumberConfirmed', this)">
                                <div class="status-badge @(item.PhoneNumberConfirmed ? "status-active" : "status-inactive")">
                                    @(item.PhoneNumberConfirmed ? "✓" : "✕")
                                </div>
                                <span>@(item.PhoneNumberConfirmed ? "تایید شده" : "تایید نشده")</span>
                            </div>
                        </td>

                        <!-- قسمت تأیید ایمیل -->
                        <td data-label="تأیید ایمیل">
                            <div class="status-toggle"
                                 onclick="ToggleStatus('EmailConfirmed', '@item.Id','@item.EmailConfirmed', this)">
                                <div class="status-badge @(item.EmailConfirmed ? "status-active" : "status-inactive")">
                                    @(item.EmailConfirmed ? "✓" : "✕")
                                </div>
                                <span>@(item.EmailConfirmed ? "تایید شده" : "تایید نشده")</span>
                            </div>
                        </td>
                        <td data-label="عملیات">
                            <div class="action-buttons">
                                <a asp-page="Detail"
                                   asp-route-id="@item.Id"
                                   class="btn-details"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="جزئیات کامل">
                                    <span>جزئیات</span>
                                </a>

                                <a asp-page="/Admin/User/SetRoles"
                                   asp-route-id="@item.Id"
                                   class="btn-roles"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="تنظیم نقش‌ها">
                                    <span>نقش‌ها</span>
                                </a>
                                <a asp-page="Edit"
                                   asp-route-id="@item.UserName"
                                   class="btn-edit"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="ویرایش">
                                    <span>ویرایش</span>
                                </a>
                            @*     <button class="btn-delete"
                                        onclick="DeleteItem('@Url.Page("", "index", new {id = item.Id})', '@item.UserName')"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        title="حذف">
                                    <span>حذف</span>
                                </button> *@
                                <button class="btn-delete"
                                        data-user-id="@item.Id"
                                        data-user-name="@item.UserName"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        title="حذف">
                                    <span>حذف</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- Pagination -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center mt-4">
            @if (Model.Users.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-route-pageId="@(Model.Users.CurrentPage - 1)"
                       asp-route-userName="@Model.FilterParams.UserName"
                       asp-route-name="@Model.FilterParams.Name"
                       asp-route-family="@Model.FilterParams.Family"
                       asp-route-email="@Model.FilterParams.Email"
                       asp-route-phoneNumber="@Model.FilterParams.PhoneNumber"
                       aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
            }

            @for (int i = 1; i <= Model.Users.PageCount; i++)
            {
                <li class="page-item @(i == Model.Users.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-route-pageId="@i"
                       asp-route-userName="@Model.FilterParams.UserName"
                       asp-route-name="@Model.FilterParams.Name"
                       asp-route-family="@Model.FilterParams.Family"
                       asp-route-email="@Model.FilterParams.Email"
                       asp-route-phoneNumber="@Model.FilterParams.PhoneNumber">@i</a>
                </li>
            }

            @if (Model.Users.CurrentPage < Model.Users.PageCount)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-route-pageId="@(Model.Users.CurrentPage + 1)"
                       asp-route-userName="@Model.FilterParams.UserName"
                       asp-route-name="@Model.FilterParams.Name"
                       asp-route-family="@Model.FilterParams.Family"
                       asp-route-email="@Model.FilterParams.Email"
                       asp-route-phoneNumber="@Model.FilterParams.PhoneNumber"
                       aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            }
        </ul>
    </nav>
    <a asp-page="Add" class="floating-action-btn">
        ➕
    </a>
</div>

@section Scripts {
    <script>
         // var token = $("#ajax-token input[name='__RequestVerificationToken']").val();

             document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', function() {
                const userId = this.dataset.userId;
                const userName = this.dataset.userName;

                Swal.fire({
                    title: 'آیا مطمئن هستید؟',
                    html: `در حال حذف کاربر <b>${userName}</b> هستید`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#FF6B6B',
                    cancelButtonColor: '#4ECDC4',
                    confirmButtonText: 'تایید حذف',
                    cancelButtonText: 'انصراف'
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`?handler=Delete&id=${userId}`, {
                                method: 'POST',
                                headers: {
                                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                                    'Content-Type': 'application/json'
                                }
                            });

                            if (response.ok) {
                                // حذف ردیف از جدول با انیمیشن
                                const row = this.closest('tr');
                                row.style.transition = 'opacity 0.5s';
                                row.style.opacity = '0';

                                setTimeout(() => {
                                    row.remove();
                                    Swal.fire('حذف شد!', 'کاربر با موفقیت حذف شد', 'success');
                                }, 500);
                            } else {
                                Swal.fire('خطا!', 'حذف کاربر انجام نشد', 'error');
                            }
                        } catch (error) {
                            console.error('خطا در حذف کاربر:', error);
                            Swal.fire('خطا!', 'ارتباط با سرور برقرار نشد', 'error');
                        }
                    }
                });
            });
        });
        // function DeleteItem(url, userName) {
        //     Swal.fire({
        //         title: 'آیا مطمئن هستید؟',
        //         html: `در حال حذف کاربر <b>${userName}</b> هستید`,
        //         icon: 'warning',
        //         showCancelButton: true,
        //         confirmButtonColor: '#FF6B6B',
        //         cancelButtonColor: '#4ECDC4',
        //         confirmButtonText: 'تایید حذف',
        //         cancelButtonText: 'انصراف'
        //     }).then((result) => {
        //         if (result.isConfirmed) {
        //             // عملیات حذف
        //         }
        //     });
        // }
                async function ToggleStatus(fieldType, userId, active, element) {
            try {
                const response = await fetch(`?handler=Toggle${fieldType}&userId=${userId}&IsActive=${active}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const container = element.closest('.status-toggle');
                    const badge = container.querySelector('.status-badge');
                    const label = container.querySelector('span');

                    // تشخیص وضعیت فعلی بر اساس کلاس
                    const isActive = badge.classList.contains('status-active');

                    // تغییر کلاس‌ها و محتوا
                    badge.classList.toggle('status-active', !isActive);
                    badge.classList.toggle('status-inactive', isActive);
                    badge.innerHTML = isActive ? '✕' : '✓';

                    // تنظیم متن بر اساس نوع فیلد
                    switch(fieldType) {
                        case 'IsActive':
                            label.textContent = isActive ? 'غیرفعال' : 'فعال';
                            break;
                        case 'PhoneNumberConfirmed':
                            label.textContent = isActive ? 'تایید نشده' : 'تایید شده';
                            break;
                        case 'EmailConfirmed':
                            label.textContent = isActive ? 'تایید نشده' : 'تایید شده';
                            break;
                    }

                    // انیمیشن
                    container.classList.add('animate__animated', 'animate__rubberBand');
                    setTimeout(() => {
