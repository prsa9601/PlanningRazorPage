@page
@using PlanningRazorPage.Infrastructure.Utils
@using PlanningRazorPage.Models.User.UserPackage
@model PlanningRazorPage.Pages.Admin.UserPackage.UserPackagesDetailModel
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "🎁 مدیریت پکیج‌های کاربران";
}

@section Header {
    <style>
        /* استایل‌های کامل */
        :root {
            --edit-gradient: linear-gradient(135deg, #4ECDC4 0%, #45B7AF 100%);
            --delete-gradient: linear-gradient(135deg, #FF6B6B 0%, #e55a5a 100%);
            --status-active: #2ecc71;
            --status-inactive: #e74c3c;
        }

        .btn-edit {
            background: var(--edit-gradient);
            color: white !important;
            box-shadow: 0 4px 15px rgba(78, 205, 196, 0.3);
            padding: 0.6rem 1.2rem;
            border-radius: 1.5rem;
            border: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            position: relative;
            overflow: hidden;
        }

        .btn-delete {
            background: var(--delete-gradient);
            color: white !important;
            box-shadow: 0 4px 15px rgba(255, 107, 107, 0.3);
            padding: 0.6rem 1.2rem;
            border-radius: 1.5rem;
            border: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            position: relative;
            overflow: hidden;
        }

            .btn-edit:hover,
            .btn-delete:hover {
                transform: translateY(-2px) scale(1.05);
                box-shadow: 0 8px 25px rgba(0,0,0,0.2);
            }

        .btn-edit span::after {
            content: '✏️';
            margin-right: 0.5rem;
            transition: all 0.3s ease;
        }

        .btn-delete span::after {
            content: '🗑️';
            margin-right: 0.5rem;
            transition: all 0.3s ease;
        }

        .btn-edit:hover span::after,
        .btn-delete:hover span::after {
            transform: rotate(15deg) scale(1.2);
        }

        .no-data-box {
            text-align: center;
            padding: 2rem;
            font-size: 1.5rem;
            color: #FF6B6B;
            border: 2px dashed #FF6B6B;
            border-radius: 1rem;
            margin: 2rem;
            background: rgba(255,255,255,0.9);
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
        }

        .expiry-date {
            direction: ltr;
            font-family: monospace;
            background: rgba(255,255,255,0.9);
            padding: 0.5rem 1rem;
            border-radius: 1rem;
            font-weight: bold;
            color: #2c3e50;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .package-id-badge {
            background: linear-gradient(135deg, #FF6B6B 0%, #FFE66D 100%);
            color: white;
            padding: 0.3rem 1rem;
            border-radius: 1rem;
            display: inline-block;
            font-weight: bold;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .status-toggle {
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 1rem;
            background: rgba(255,255,255,0.9);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .status-badge {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .status-active {
            background: var(--status-active);
            color: white;
        }

        .status-inactive {
            background: var(--status-inactive);
            color: white;
        }
    </style>
}

<div class="user-management-card">
    <div class="table-header-custom">
        <h5 class="table-title mb-0">📦 مدیریت پکیج‌های کاربران</h5>
    </div>

    <div class="p-4 bg-light rounded-top">
        <form method="get" class="row g-3">
            <!-- فیلدهای موجود -->
            @*   <div class="col-md-3">
                <input type="number" asp-for="FilterParams.packageId" class="form-control" placeholder="شناسه پکیج">
            </div> *@
          
            <div class="col-md-3">
                <input type="date"
                       asp-for="FilterParams.FilterStartTime"
                       class="form-control"
                       placeholder="از تاریخ">
            </div>

            <div class="col-md-3">
                <input type="date"
                       asp-for="FilterParams.FilterEndTime"
                       class="form-control"
                       placeholder="تا تاریخ">
            </div>

            <div class="col-md-3">
                <select asp-for="FilterParams.search" class="form-select">
                    <option value="None">-- مرتب سازی --</option>
                    <option value="Latest">آخرین پکیج‌ها</option>
                </select>
            </div>
            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input asp-for="FilterParams.ActivePackages"
                           class="form-check-input"
                           type="checkbox">
                    <label class="form-check-label">پکیج‌های فعال</label>
                </div>
            </div>
            <div class="col-md-12 text-center mt-3">
                <button type="submit" class="btn btn-primary w-25">اعمال فیلتر</button>
            </div>
        </form>
    </div>

    <div class="table-responsive-xxl p-4">
        <table class="table user-table align-middle">
            <thead>
                <tr>
                    <th>👤 کاربر</th>
                    <th>📦 شناسه پکیج</th>
                    <th>📧 ایمیل مجاز</th>
                    <th>📱 SMS مجاز</th>
                    <th>⏳ تاریخ انقضا</th>
                    <th>✅ وضعیت</th>
                    <th class="text-center">✨ عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users?.EntityCount > 0)
                {
                    @foreach (var user in Model.Users.Data)
                    {
                        foreach (var package in user.userPackages)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="fw-bold">@user.UserName</div>
                                        <div class="text-muted small">@user.PhoneNumber</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="package-id-badge">#@package.PackageId</span>
                                </td>
                                <td class="fw-bold">@package.AllowedEmailCount</td>
                                <td class="fw-bold">@package.AllowedSmsCount</td>
                                <td>
                                    <div class="expiry-date">
                                        @package.ExpiryDate.ConvertToPersianDateTime()
                                        @*(@"dd\.hh\:mm").ToString("yyyy/MM/dd HH:mm")*@
                                    </div>
                                </td>
                                <td>
                                    <div class="status-toggle" onclick="ToggleStatus('@package.PackageId','@package.IsActive',this)">
                                        <div class="status-badge @(package.IsActive ? "status-active" : "status-inactive")">
                                            @(package.IsActive ? "✓" : "✕")
                                        </div>
                                        <span>@(package.IsActive ? "فعال" : "غیرفعال")</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="action-buttons d-flex gap-2 justify-content-center">
                                        <a asp-page="UserPackagesDetail"
                                           asp-route-userId="@user.UserId"
                                           class="btn-edit">
                                            <span>جزئیات پکیج های کاربر</span>
                                        </a>
                                        <a asp-page="SetPackages"
                                           asp-route-userId="@user.UserId"
                                           class="btn-edit">
                                            <span>ست کردن پکیج برای کاربر</span>
                                        </a>
                                        <button class="btn-delete"
                                                data-user-id="@user.UserId"
                                                data-package-id="@package.PackageId">
                                            <span>حذف</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="no-data-box">
                                🚫 هیچ پکیجی یافت نشد!
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center mt-4">
            @if (Model.Users?.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-route-pageId="@(Model.Users.CurrentPage - 1)"
                       asp-all-route-data="@Model.FilterParams.ToRouteDictionary(Model.Users.CurrentPage-1)">
                        &laquo;
                    </a>
                </li>
            }

            @for (int i = 1; i <= Model.Users?.PageCount; i++)
            {
                <li class="page-item @(i == Model.Users.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-route-pageId="@i"
                       asp-all-route-data="@Model.FilterParams.ToRouteDictionary(i)">
                        @i
                    </a>
                </li>
            }

            @if (Model.Users?.CurrentPage < Model.Users?.PageCount)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-route-pageId="@(Model.Users.CurrentPage + 1)"
                       asp-all-route-data="@Model.FilterParams.ToRouteDictionary(Model.Users.CurrentPage+1)">
                        &raquo;
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', function() {
                const userId = this.dataset.userId;
                const packageId = this.dataset.packageId;

                Swal.fire({
                    title: 'آیا مطمئن هستید؟',
                    html: `در حال حذف پکیج <b>#${packageId}</b> هستید`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#FF6B6B',
                    cancelButtonColor: '#4ECDC4',
                    confirmButtonText: 'تایید حذف',
                    cancelButtonText: 'انصراف'
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`?handler=Delete&userId=${userId}&packageId=${packageId}`, {
                                method: 'POST',
                                headers: {
                                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                                    'Content-Type': 'application/json'
                                }
                            });

                            if (response.ok) {
                                const row = this.closest('tr');
                                row.style.transition = 'all 0.3s ease';
                                row.style.transform = 'scale(0.9)';
                                row.style.opacity = '0';
                                setTimeout(() => row.remove(), 300);
                                Swal.fire('حذف شد!', 'پکیج با موفقیت حذف شد', 'success');
                            } else {
                                Swal.fire('خطا!', 'حذف پکیج انجام نشد', 'error');
                            }
                        } catch (error) {
                            console.error('خطا در حذف پکیج:', error);
                            Swal.fire('خطا!', 'ارتباط با سرور برقرار نشد', 'error');
                        }
                    }
                });
            });
        });

        async function ToggleStatus(packageId, isActive, element) {
            try {
                const response = await fetch(`?handler=ToggleStatus&packageId=${packageId}&isActive=${isActive}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const container = element.closest('.status-toggle');
                    const badge = container.querySelector('.status-badge');
                    const label = container.querySelector('span');

                    const newStatus = !(isActive === 'True');
                    badge.classList.toggle('status-active', newStatus);
                    badge.classList.toggle('status-inactive', !newStatus);
                    badge.innerHTML = newStatus ? '✓' : '✕';
                    label.textContent = newStatus ? 'فعال' : 'غیرفعال';

                    container.animate([
                        { transform: 'scale(1)' },
                        { transform: 'scale(1.1)' },
                        { transform: 'scale(1)' }
                    ], { duration: 300 });
                }
            } catch (error) {
                console.error('خطا در تغییر وضعیت:', error);
                Swal.fire('خطا!', 'تغییر وضعیت انجام نشد', 'error');
            }
        }
    </script>
}