@page
@using PlanningRazorPage.TagHelpers
@model PlanningRazorPage.Pages.Admin.Role.RolesModel
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "🌈 مدیریت نقش‌ها";
    ViewData["selected"] = "roles";
}
@section Header {
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #FF6B6B 0%, #FFE66D 100%);
            --secondary-gradient: linear-gradient(135deg, #4ECDC4 0%, #45B7AF 100%);
            --glass-effect: linear-gradient(145deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05));
            --neon-shadow: 0 0 20px rgba(255,107,107,0.3);
        }

        .roles-management-card {
            border-radius: 2rem;
            background: rgba(255,255,255,0.95);
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            margin: 2rem;
            overflow: hidden;
            border: 2px solid #FF6B6B;
        }

        .roles-header-custom {
            background: var(--primary-gradient);
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

            .roles-header-custom::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient(45deg, transparent, rgba(255,255,255,0.3), transparent);
                animation: shine 3s infinite;
            }

        .table-hover-effect tr {
            transition: all 0.3s ease;
            background: rgba(255,255,255,0.9);
        }

            .table-hover-effect tr:hover {
                transform: scale(1.02);
                background: rgba(255,235,235,0.9);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

        .action-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
        }

        .btn-role-action {
            padding: 0.8rem 1.5rem;
            border-radius: 1rem;
            color: white !important;
            border: none;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-edit-role {
            background: var(--secondary-gradient);
        }

        .btn-delete-role {
            background: var(--primary-gradient);
        }

        .btn-role-action:hover {
            transform: translateY(-3px);
            box-shadow: var(--neon-shadow);
        }

        .pagination-custom .page-item.active .page-link {
            background: var(--primary-gradient);
            border-color: #FF6B6B;
            color: white;
        }

        .page-link {
            color: #FF6B6B;
            transition: all 0.3s ease;
        }

            .page-link:hover {
                color: #4ECDC4;
                transform: scale(1.1);
            }

        .roles-title {
            font-family: 'Yekan', sans-serif;
            font-size: 2.5rem;
            color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }

        .floating-add-btn {
            background: var(--secondary-gradient);
            color: white !important;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            border: none;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

            .floating-add-btn:hover {
                transform: translateY(-3px) rotate(2deg);
                box-shadow: var(--neon-shadow);
            }

        @@keyframes shine {
            100% {
                transform: translate(100%, 100%) rotate(45deg);
            }
        }
    </style>
}

<div class="roles-management-card">
    <div class="roles-header-custom">
        <h3 class="roles-title mb-0 text-center">
            🛡️ مدیریت نقش‌ها
        </h3>
    </div>

    <div class="card-body p-4">
        <div class="d-flex justify-content-end mb-4">
            <a asp-page="Add" class="floating-add-btn">
                ➕ افزودن نقش جدید
            </a>
        </div>

        <div class="table-responsive-xxl">
            <table class="table table-hover table-hover-effect align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="d-none">#</th>
                        <th scope="col">🏷️ عنوان نقش</th>
                        <th scope="col" class="text-center">✨ عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilterResult.Data)
                    {
                        <tr>
                            <td class="d-none">@item.Id</td>
                            <td class="fw-bold">@item.Name</td>
                            <td>
                                <div class="action-buttons">
                                    <a asp-page="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn-role-action btn-edit-role"
                                       data-bs-toggle="tooltip"
                                       title="ویرایش">
                                        ✏️ ویرایش
                                    </a>

                                    <delete-item Url="@Url.Page("Delete","DeleteRole",new{roleId=item.Id})"
                                                 description="آیا از حذف نقش @item.Name اطمینان دارید؟"
                                                 class="btn-role-action btn-delete-role"
                                                 data-bs-toggle="tooltip"
                                                 title="حذف">
                                        🗑️ حذف
                                    </delete-item>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <nav class="d-flex justify-content-center mt-4">
            <ul class="pagination pagination-custom">
                @if (Model.FilterResult.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-route-pageId="@(Model.FilterResult.CurrentPage - 1)"
                           asp-route-take="@Model.FilterResult.Take"
                           asp-route-Name="@Model.FilterParams.Name">
                            ← قبلی
                        </a>
                    </li>
                }

                @for (var i = Model.FilterResult.StartPage; i <= Model.FilterResult.EndPage; i++)
                {
                    <li class="page-item @(i == Model.FilterResult.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-route-pageId="@i"
                           asp-route-take="@Model.FilterResult.Take"
                           asp-route-Name="@Model.FilterParams.Name">@i</a>
                    </li>
                }

                @if (Model.FilterResult.CurrentPage < Model.FilterResult.PageCount)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-route-pageId="@(Model.FilterResult.CurrentPage + 1)"
                           asp-route-take="@Model.FilterResult.Take"
                           asp-route-Name="@Model.FilterParams.Name">
                            بعدی →
                        </a>
                    </li>
                }
            </ul>
        </nav>
 @*        <nav class="d-flex justify-content-center mt-4">
            <ul class="pagination pagination-custom">
                @if (Model.FilterResult.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="?pageId=@(Model.FilterResult.CurrentPage - 1)&take=8">
                            ← قبلی
                        </a>
                    </li>
                }

                @for (var i = Model.FilterResult.StartPage; i <= Model.FilterResult.EndPage; i++)
                {
                    <li class="page-item @(i == Model.FilterResult.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?pageId=@i&take=8">@i</a>
                    </li>
                }

                @if (Model.FilterResult.CurrentPage < Model.FilterResult.EndPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="?pageId=@(Model.FilterResult.CurrentPage + 1)&take=8">
                            بعدی →
                        </a>
                    </li>
                }
            </ul>
        </nav> *@
    </div>
</div>