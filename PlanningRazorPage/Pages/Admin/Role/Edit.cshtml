@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using PlanningRazorPage.TagHelpers
@using PlanningRazorPage.Infrastructure
@model PlanningRazorPage.Pages.Admin.Role.EditModel
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "🌈 ویرایش نقش";
    ViewData["selected"] = "roles";
}
@section Header
{
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #FF6B6B 0%, #FFE66D 100%);
            --secondary-gradient: linear-gradient(135deg, #4ECDC4 0%, #45B7AF 100%);
            --glass-effect: linear-gradient(145deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05));
            --neon-shadow: 0 0 20px rgba(255,107,107,0.3);
        }

        .role-edit-card {
            border-radius: 2rem;
            background: rgba(255,255,255,0.95);
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            margin: 2rem;
            overflow: hidden;
            border: 2px solid #FF6B6B;
        }

        .edit-header-custom {
            background: var(--primary-gradient);
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

            .edit-header-custom::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient(45deg, transparent, rgba(255,255,255,0.3), transparent);
                animation: shine 3s infinite;
            }

        .form-control-edit {
            border: 2px solid #FFE66D;
            border-radius: 1.5rem;
            padding: 1rem 1.5rem;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            background: rgba(255,255,255,0.9);
        }

            .form-control-edit:focus {
                border-color: #FF6B6B;
                box-shadow: var(--neon-shadow);
                transform: scale(1.02);
            }

        .permission-section {
            border: 2px solid #FFE66D;
            border-radius: 1.5rem;
            padding: 2rem;
            margin: 2rem;
            background: var(--glass-effect);
            backdrop-filter: blur(10px);
        }

            .permission-section h6 {
                color: #2c3e50;
                border-bottom: 2px solid #FF6B6B;
                padding-bottom: 1rem;
                font-size: 1.4rem;
                font-weight: 700;
                text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
            }

        .form-check-input:checked {
            background-color: #FF6B6B;
            border-color: #FF6B6B;
        }

        .form-check-label {
            color: #2c3e50;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

        .form-check:hover .form-check-label {
            color: #FF6B6B;
            transform: translateX(10px);
        }

        .btn-cancel-edit {
            background: var(--primary-gradient);
            color: white !important;
            padding: 0.8rem 2rem;
            border-radius: 1rem;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-save-edit {
            background: var(--secondary-gradient);
            color: white !important;
            padding: 0.8rem 2.5rem;
            border-radius: 1rem;
            border: none;
            transition: all 0.3s ease;
        }

            .btn-cancel-edit:hover,
            .btn-save-edit:hover {
                transform: translateY(-3px);
                box-shadow: var(--neon-shadow);
            }

        @@keyframes shine {
            100% {
                transform: translate(100%, 100%) rotate(45deg);
            }
        }

        .edit-title {
            font-family: 'Yekan', sans-serif;
            font-size: 2.2rem;
            color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }
    </style>
}

<div class="role-edit-card">
    <div class="edit-header-custom">
        <h5 class="edit-title mb-0">
            🎪 ویرایش نقش
        </h5>
    </div>

    <form method="post">
        <div class="p-4">
            <div class="mb-5">
                <label class="form-label fs-5 mb-3">
                    🏷 عنوان نقش
                </label>
                @Html.TextBoxFor(f => f.Name, new
                    {
                        @class = "form-control form-control-edit",
                        placeholder = "مثال: مدیر سیستم، کاربر ارشد و..."
                    })
            </div>

            <div class="permission-section">
                <h6 class="mb-4">
                    🔐 دسترسی‌های نقش
                </h6>
                <div class="row g-4">
                    @foreach (var item in Enum.GetNames(typeof(Permission)))
                    {
                        var id = Guid.NewGuid();
                        <div class="col-md-6 col-lg-4">
                            <div class="form-check">
                                <input name="permissions"
                                       class="form-check-input"
                                       type="checkbox"
                                       id="@id"
                                       value="@item"
                                       checked="@(Model.Permissions.Any(f=>f.ToString()==item))">
                                <label class="form-check-label" for="@id">
                                    @item.Replace("_", " ")
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-end gap-3 p-4">
            <a href="/Admin/Role/Roles" class="btn btn-cancel-edit">
                ❌ انصراف
            </a>
            <button type="submit" class="btn btn-save-edit">
                💾 ذخیره تغییرات
            </button>
        </div>
    </form>
</div>
