@page
@using PlanningRazorPage.Pages.TagHelpers
@using PlanningRazorPage.Infrastructure
@using Microsoft.AspNetCore.Mvc.TagHelpers
@* @inject IPackageService _service; *@
@model PlanningRazorPage.Pages.Admin.Package.ListModel
@{
    Layout = "Shared/_Layout";
}
@section Header{
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #FF6B6B 0%, #FFE66D 100%);
            --secondary-gradient: linear-gradient(135deg, #4ECDC4 0%, #45B7AF 100%);
            --glass-effect: linear-gradient(145deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05));
            --neon-shadow: 0 0 20px rgba(255,107,107,0.3);
        } 
        .floating-add-btn {
            background: var(--secondary-gradient);
            color: white !important;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            border: none;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

            .floating-add-btn:hover {
                transform: translateY(-3px) rotate(2deg);
                box-shadow: var(--neon-shadow);
            }

    </style>
}
    @* <p id="result"></p> *@

    <div class="card container">
        <h5 class="card-header">جدول با سرتیتر تیره</h5>
        <div class="table-responsive text-nowrap">  
            <div class="d-flex justify-content-end mb-4">
                <a asp-page="Add" class="floating-add-btn">
                    ➕ افزودن پکیج جدید
                </a>
            </div>
            <table class="table">
                <thead class="table-dark">
                    <tr>
                        <th>عکس پکیج</th>
                        <th>مشتری</th>
                        <th> وضعیت</th>
                        <th> قیمت</th>
                        <th>عملیات ها</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">

                    @{
                        foreach (var item in @Model.Packages)
                        {
                            <tr>
                                <td>
                                    <div class="table-image">
                                        <img style="height:60px;weight:80px;" src="@Directories.GetPackageImage(item.ImageName)" alt="Avatar" class="rounded-circle">
                                    </div>
                                </td>
                                <td>@item.Title</td>

                                @if (item.Active == true)
                                {
                                    <td><span class="badge bg-label-primary me-1">فعال</span></td>
                                }
                                else
                                {
                                    <td><span class="badge bg-label-warning me-1">غیر فعال</span></td>
                                }
                                <td>@item.Price تومان</td>
                                <td>
                                    <div class="dropdown">
                                        <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="mdi mdi-dots-vertical"></i></button>
                                        <div class="dropdown-menu">
                                            @if (item.Active == true)
                                            {
                                                <remove-active-package Url="@Url.Page("List", "RemoveActive", new{packageId = item.Id})" description=" آیا از غیر فعال کردن این پکیج اطمینان دارید ؟">
                                                    <i class="mdi mdi-pencil-outline me-1"></i> غیر فعال کردن
                                                </remove-active-package>
                                            }
                                            else
                                            {
                                                <set-active-package Url="@Url.Page("List", "SetActive", new { packageId = item.Id })" description="آیا از فعال کردن این پکیج اطمینان دارید ؟">
                                                    <i class="mdi mdi-pencil-outline me-1"></i> فعال کردن
                                                </set-active-package>
                                            }
                                            <a class="dropdown-item waves-effect" asp-page="Edit" asp-route-id="@item.Id"><i class="mdi mdi-pencil-outline me-1"></i> ویرایش</a>
                                            <delete-item Url="@Url.Page("List", "DeletePackage", new { packageId = item.Id })" description="آیا از حذف این پکیج اطمینان دارید ؟">
                                                <i class="mdi mdi-trash-can-outline me-1"></i>حذف
                                            </delete-item>

                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </div>
@section Scripts
{
    <script src="~/global.js"></script>
    <script>
                function PostSetActivePackage(url, Description) {
            Swal.fire({
                title: "فعال کردن پکیج",
                text: Description,
                icon: "warning",
                confirmButtonText: "بله ، مطمعا هستم",
                cancelButtonText: "خیر",
                showCancelButton: true,
            }).then((result) => {
                if (result.isConfirmed) {
                    var token = $("#ajax-token input[name='__RequestVerificationToken']").val();
                    $.ajax({
                        url: url,
                        method: "post",
                        data: {
                            // productId: productId
                             __RequestVerificationToken: token
                        },
                        beforeSend: function () {

                            $(".loading").show();
                        },
                        complete: function () {
                            $(".loading").hide();
                        },
                    }).done(function (data) {
                        var res = JSON.parse(data);
                        if (res.Status === 1) {
                            Success("", res.Message, true);
                        } else {
                            ErrorAlert("", res.Message, res.isReloadPage);
                        }
                    });
                }
            });
        }


    </script>
