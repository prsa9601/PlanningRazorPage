@page
@model PlanningRazorPage.Pages.Admin.Package.EditModel
@{
    Layout = "Shared/_Layout";
}
@section Header{

    <link rel="stylesheet" href="~/assets/vendor/libs/bootstrap-select/bootstrap-select.css" />
}
<div class="col-12 container-fluid">
    <div class="card">
        <h5 class="card-header">تکرار کننده فرم</h5>
        <form class="card" method="post" enctype="multipart/form-data">
            <div class="card-body">

                <div class="form-floating form-floating-outline  mb-5">
                    <input asp-for="title" id="Title" class="form-control"
                           type="text"
                           placeholder="متــریالایز"
                           id="html5-text-input" />
                    <label asp-for="title" for="html5-text-input">title</label>
                </div>
                <div class="form-floating form-floating-outline mb-5">
                    <input asp-for="Link" id="Link" class="form-control"
                           type="text"
                           placeholder="متــریالایز"
                           id="html5-text-input" />
                    <label asp-for="Link" for="html5-text-input">link</label>
                </div>
                <div class="mb-3">
                    <label for="formFil" asp-for="Picture" class="form-label">عکس زمینه پکیج</label>
                    <input asp-for="Picture" id="Picture" class="form-control" type="file" id="formFil" />
                </div>
                <span asp-validation-for="@Model.Picture"></span>
                <br />
                <br />
                <div class="mb-3 col-6">
                    <label for="formFile" asp-for="price" class="form-label">قیمت پکیج</label>
                    <input asp-for="price" id="Price" type="number" class="form-control invoice-item-price mb-3" />
                </div>
                <span asp-validation-for="@Model.price"></span>
                <div class="mb-3 col-6">
                    <label for="formFile" asp-for="AllowedEmailCount" class="form-label">تعداد ایمیل های مجاز</label>
                    <input asp-for="AllowedEmailCount" type="number" class="form-control invoice-item-price mb-3" />
                </div>
                <span asp-validation-for="@Model.AllowedEmailCount"></span>
                <div class="mb-3 col-6">
                    <label for="formFile" asp-for="AllowedSmsCount" class="form-label">تعداد پیامک های مجاز</label>
                    <input asp-for="AllowedSmsCount" type="number" class="form-control invoice-item-price mb-3" />
                </div>
                <span asp-validation-for="@Model.AllowedSmsCount"></span>
                <div class="col-6 mb-3">
                    <div class="form-floating form-floating-outline">
                        <select id="selectpickerBasic" asp-for="expiryTime" class="selectpicker w-100" data-style="btn-default">
                            <option value="روزانه">روزانه</option>
                            <option value="یک_ماهه">یک ماهه</option>
                            <option value="سه_ماهه">سه ماهه</option>
                            <option value="شش_ماهه">شش ماهه</option>
                            <option value="یک_ساله">یک ساله</option>
                        </select>
                        <label for="selectpickerBasic">ساده</label>
                    </div>
                </div>
                <br />
                <br />
                @{
                    <div class="col-md-12  ">
                        <h4>مشخصات محصول</h4>
                        <table class="table bg-white p-0 card-primary table-bordered text-center">
                            <thead>
                                <tr class="text-center">
                                    <th>عنوان</th>
                                    <th>مقدار</th>
                                </tr>
                            </thead>
                            <tbody id="table-body">
                                @if (!Model.Keys.Any())
                                {
                                    <tr>
                                        <td>
                                            <input placeholder="وزن" autocomplete="off" type="text" name="Keys" class="form-control" />
                                        </td>
                                        <td>
                                            <input placeholder="1 کیلو" autocomplete="off" type="text" name="Values" class="form-control" />
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-danger" onclick="removeRow(this)">حذف</button>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    for (var i = 0; i < Model.Keys.Count; i++)
                                    {
                                        if (i >= Model.Values.Count)
                                        {
                                            break;
                                        }
                                        <tr>
                                            <td>
                                                <input autocomplete="off" type="text" name="Keys" value="@Model.Keys[i]" class="form-control" />
                                            </td>
                                            <td>
                                                <input autocomplete="off" type="text" name="Values" value="@Model.Values[i]" class="form-control" />
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-danger" onclick="removeRow(this)">حذف</button>
                                            </td>
                                        </tr>
                                    }
                                }

                            </tbody>
                        </table>
                        <div class="form-input">
                            <div class=" mt-2">
                                <input id="rowCount" type="number" placeholder="تعداد مورد نظر را وارد کنید" class="form-control text-right text-right" style="width: 20%; display: inline-block" />
                                <p style="margin: 0 10px; display: inline-block">ردیف</p>
                                <a onclick="AddRow()" class="btn  btn-primary text-white text-center" style="height: fit-content;  display: inline"> اضافه کن</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <br />
            <br />
            <div class="mb-3">
                <button type="submit" class="btn btn-success waves-effect waves-light">افزودن محصول</button>
            </div>
        </form>
     
         
    </div>
</div>

<!-- /Form Repeater -->
@section Scripts {
    <script src="~/assets/js/forms-extras.js"></script>

    <script src="~/assets/vendor/libs/hammer/hammer.js"></script>
    <script src="~/assets/vendor/libs/i18n/i18n.js"></script>
    <script src="~/assets/vendor/libs/typeahead-js/typeahead.js"></script>

    <script src="~/assets/vendor/libs/bootstrap-select/bootstrap-select.js"></script>




    <script src="~/assets/vendor/libs/jquery-repeater/jquery-repeater.js"></script>
}