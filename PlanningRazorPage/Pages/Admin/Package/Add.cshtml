            </div>
            <div class="mb-6 col-lg-9 col-xl-6 col-15 mb-0">
                <label class="form-label" for="form-repeater-1-2">توضیجات</label>
                <input name="Values" value="@Model.Values[i]" type="text" id="form-repeater-1-2" class="form-control text-start" dir="ltr" placeholder="دو کیلوگرم">
            </div>
            <div class="mb-3 col-lg-12 col-xl-2 col-12 d-flex align-items-center mb-0">
