<div class="dashboard-container">
    <div class="dashboard-header">
        <h4 class="mb-0">
            <i class="fab fa-instagram me-2"> </i>
            <b style="color:hotpink;">     مدیریت پیشرفته حسابها</b>
        </h4>
    </div>

    <div class="filter-card">
        <form method="get" class="filter-grid">
            <!-- ردیف اول -->
            <div class="filter-group">
                <label class="filter-label">نام کاربری اینستاگرام</label>
                <input type="text"
                       class="filter-input"
                       placeholder="مثال: example_username"
                       asp-for="FilterParams.InstagramUserName">
            </div>

            <!-- ردیف دوم -->
            <div class="filter-group">
                <label class="filter-label">مرتب سازی بر اساس</label>
                <select class="filter-input"
                        asp-for="FilterParams.SearchOrderBy">
                    <option value="">-- انتخاب کنید --</option>
                    <option value="@PostInstagramAccountSearchOrderBy.latest">جدیدترین ها</option>
                </select>
            </div>

            <!-- ردیف سوم -->
            <div class="filter-group">
                <label class="filter-label">بازه زمانی</label>
                <div class="date-range-group">
                    <input type="text"
                           class="filter-input datepicker"
                           placeholder="تاریخ شروع (شمسی)"
                           id="start-date"
                           readonly
                           autocomplete="off">

                    <input type="text"
                           class="filter-input datepicker"
                           placeholder="تاریخ پایان (شمسی)"
                           id="end-date"
                           readonly
                           autocomplete="off">
                </div>
            </div>

            <!-- دکمه‌های اقدام -->
            <div class="filter-actions">
                <button type="submit" class="filter-btn">
                    <i class="fas fa-filter me-2"></i>اعمال فیلتر
                </button>
                <a href="@Url.Page("./List")" class="filter-btn filter-reset">
                    <i class="fas fa-undo me-2"></i>حذف فیلترها
                </a>
            </div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table smart-table">
            <thead>
                <tr>
                    <th>حساب کاربری</th>
                    <th>نام کاربری اکانت اینستاگرام</th>
                    <th>وضعیت</th>
                    <th>آخرین فعالیت</th>
                    <th>مدیریت</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.FilterResult.Data)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="avatar me-3">
                                    <img src="@Directories.GetInstagramAccountProfile(item.Profile)"
                                         class="rounded-circle"
                                         width="70"
                                         alt="@item.UserName"
                                         onerror="this.onerror=null;this.src='/assets/img/default-profile.jpg';">
                                </div>
                                <div>
                                    <div class="fw-bold">@item.UserName</div>
                                    <small class="text-muted">item.FollowersCount.ToString("N0") دنبال‌کننده</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="text-muted small">
                                <div> @item.UserName</div>
                                @* <div>صفحه: @item.PageId</div> *@
                            </div>
                        </td>
                        <td>
                            <span class="status-indicator @(@* item.IsActive *@ true ? "active" : "inactive")">
                                <i class="fas fa-circle"></i>
                                @(@* item.IsActive *@true ? "فعال" : "غیرفعال")
                            </span>
                        </td>
                        <td>
                            <div class="text-muted small">
                                <div>item.LastActivity.ToPersianDateTime()</div>
                                <div>item.LastAction</div>
                            </div>
                        </td>
        
                        <td>
                            <div class="d-flex gap-2">
                                <!-- دکمه نمایش استوری‌ها -->
                                <a class="btn btn-sm action-btn story-btn"
                                   href="@Url.Page("Story/List", new {accountId = item.Id})">
                                    <i class="fas fa-camera me-1"></i>
                                    استوری‌ها
                                </a>

                                <!-- دکمه نمایش پست‌ها -->
                                <a class="btn btn-sm action-btn post-btn"
                                   href="@Url.Page("Post/List", new {accountId = item.Id})">
                                    <i class="fas fa-image me-1"></i>
                                    پست‌ها
                                </a>

                                <!-- دکمه حذف -->
                                <button class="btn btn-sm action-btn delete-btn"
                                        @@click="deleteAccount(@item.Id)">
                                    <i class="fas fa-trash-alt me-1"></i>
                                    حذف
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <nav class="p-3">
        <ul class="pagination pagination-modern justify-content-center">
            <li class="page-item">
                <a class="page-link" href="#">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
            <li class="page-item active"><a class="page-link" href="#">۱</a></li>
            <li class="page-item"><a class="page-link" href="#">۲</a></li>
            <li class="page-item"><a class="page-link" href="#">۳</a></li>
            <li class="page-item">
                <a class="page-link" href="#">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
        </ul>
    </nav>
</div>

