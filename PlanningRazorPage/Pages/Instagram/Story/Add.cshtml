@page
@model PlanningRazorPage.Pages.Instagram.Story.AddModel
@{
    ViewData["Title"] = "ایجاد استوری جدید";
    Layout = "Shared/_Layout";
}

@section Header {
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />
    <style>
        .media-upload-box {
            border: 2px dashed #d9dee3;
            border-radius: 0.5rem;
            padding: 2rem;
            text-align: center;
            background: #f8f9fa;
            transition: all 0.3s ease;
        }

            .media-upload-box:hover {
                border-color: #696cff;
                background: #f3f4ff;
            }

        .media-preview-container {
            position: relative;
            max-width: 400px;
            margin: 1rem auto;
            border-radius: 0.5rem;
            overflow: hidden;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

        .preview-media {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

        .remove-media-btn {
            position: absolute;
            top: 0.5rem;
            left: 0.5rem;
            z-index: 10;
        }
    </style>
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">
        <span class="text-muted fw-light">اینستاگرام /</span> استوری جدید
    </h4>

    <div class="card mb-4">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0">
                <i class="fas fa-plus-circle me-2"></i>مشخصات استوری
            </h5>
            <small class="text-muted">فیلدهای ستاره دار обязаاری هستند</small>
        </div>

        <form method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
            <div class="card-body">
                <div class="row g-4">
                    <!-- ستون سمت راست -->
                    <div class="col-md-6">
                        <!-- انتخاب حساب -->
                        <div class="form-floating form-floating-outline mb-4">
                            <select class="form-select" asp-for="@Model.InstagramId" required>
                                <option value="">انتخاب حساب اینستاگرام</option>
                                @foreach (var account in Model.Account!)
                                {
                                    <option value="@account.Id">📱 @account.InstagramUserName</option>
                                }
                            </select>
                            <label class="text-primary">
                                <i class="fas fa-instagram me-2"></i>حساب اینستاگرام
                            </label>
                            <div class="invalid-feedback">لطفا حساب اینستاگرام را انتخاب کنید</div>
                        </div>

                        <!-- فیلد لینک -->
                        <div class="form-floating form-floating-outline mb-4">
                            <input type="url"
                                   class="form-control"
                                   placeholder="https://example.com"
                                   asp-for="link"
                                   required>
                            <label class="text-primary">
                                <i class="fas fa-link me-2"></i>لینک استوری
                            </label>
                            <div class="invalid-feedback">لطفا لینک معتبر وارد کنید</div>
                        </div>

                        <!-- تاریخ انتشار -->
                        <div class="form-floating form-floating-outline mb-4">
                            <input class="form-control flatpickr-input"
                                   type="datetime-local"
                                   asp-for="dateOfPosting"
                                   required>
                            <label class="text-primary">
                                <i class="fas fa-calendar-alt me-2"></i>زمان انتشار
                            </label>
                            <div class="invalid-feedback">لطفا تاریخ انتشار را انتخاب کنید</div>
                        </div>
                    </div>

                    <!-- ستون سمت چپ -->
                    <div class="col-md-6">
                        <!-- آپلود رسانه -->
                        <div class="media-upload-box">
                            <div class="mb-3">
                                <label class="btn btn-outline-primary btn-lg">
                                    <i class="fas fa-cloud-upload-alt me-2"></i>
                                    انتخاب فایل
                                    <input type="file"
                                           asp-for="Video"
                                           accept="image/*,video/*"
                                           class="d-none"
                                           onchange="previewMedia(event)"
                                           required>
                                </label>
                                <p class="text-muted mt-2 mb-0">حداکثر حجم فایل: 50MB</p>
                                <p class="text-muted">فرمت‌های مجاز: JPG, PNG, MP4</p>
                            </div>

                            <!-- پیش نمایش رسانه -->
                            <div class="media-preview-container" id="preview-container">
                                <img id="image-preview" class="preview-media" alt="پیش نمایش">
                                <video id="video-preview" class="preview-media" controls></video>
                                <button type="button"
                                        class="btn btn-danger btn-sm remove-media-btn"
                                        onclick="clearMedia()">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- دکمه ارسال -->
                <div class="row mt-5">
                    <div class="col-12 text-center">
                        <button type="submit" class="btn btn-primary btn-lg px-5">
                            <i class="fas fa-save me-2"></i>ذخیره استوری
                        </button>
                        <a href="@Url.Page("List")" class="btn btn-outline-secondary btn-lg px-5">
                            <i class="fas fa-times me-2"></i>انصراف
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // پیش نمایش رسانه
        function previewMedia(event) {
            const file = event.target.files[0];
            const previewContainer = document.getElementById('preview-container');
            const imagePreview = document.getElementById('image-preview');
            const videoPreview = document.getElementById('video-preview');

            previewContainer.style.display = 'block';
            imagePreview.style.display = 'none';
            videoPreview.style.display = 'none';

            if (file.type.startsWith('image/')) {
                imagePreview.src = URL.createObjectURL(file);
                imagePreview.style.display = 'block';
            } else if (file.type.startsWith('video/')) {
                videoPreview.src = URL.createObjectURL(file);
                videoPreview.style.display = 'block';
            }
        }

        // حذف رسانه
        function clearMedia() {
            document.querySelector('input[type="file"]').value = '';
            document.getElementById('preview-container').style.display = 'none';
        }

        // فعال سازی اعتبارسنجی فرم
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()
    </script>
}