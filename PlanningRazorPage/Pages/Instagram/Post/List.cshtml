@section Scripts {

    <script>
        // مدیریت اسلایدرها
        const sliders = {};

        function initSlider(postId, totalSlides) {
            const sliderElement = document.querySelector(`#slider-${postId}`);

            sliders[postId] = {
                currentIndex: 0,
                container: sliderElement.querySelector('.slider-container'),
                dots: sliderElement.querySelectorAll('.slider-dot'),
                totalSlides: totalSlides
            };

            // افزودن رویدادهای لمسی
            let touchStartX = 0;
            let isDragging = false;

            sliderElement.addEventListener('touchstart', e => {
                touchStartX = e.touches[0].clientX;
                isDragging = true;
            });

            sliderElement.addEventListener('touchmove', e => {
                if (!isDragging) return;
                e.preventDefault();
            });

            sliderElement.addEventListener('touchend', e => {
                if (!isDragging) return;
                isDragging = false;

                const touchEndX = e.changedTouches[0].clientX;
                const diff = touchStartX - touchEndX;

                if (Math.abs(diff) > 50) {
                    const direction = diff > 0 ? -1 : 1;
                    const newIndex = Math.max(0, Math.min(
                        sliders[postId].currentIndex + direction,
                        totalSlides - 1
                    ));
                    goToSlide(newIndex, postId);
                }
            });

            updateSlider(postId);
        }


        function goToSlide(index, postId) {
            if (index >= 0 && index < sliders[postId].totalSlides) {
                sliders[postId].currentIndex = index;
                updateSlider(postId);
            }
        }

        // function updateSlider(postId) {
        //     const slider = sliders[postId];
        //     const translateValue = -slider.currentIndex * 100;

        //     // اعمال انتقال با استفاده از transform
        //     slider.container.style.transform = `translateX(${translateValue}%)`;

        //     // به روزرسانی نقاط فعال
        //     slider.dots.forEach((dot, i) => {
        //         dot.classList.toggle('active', i === slider.currentIndex);
        //     });
        // }
                function updateSlider(postId) {
            // const slider = sliders[postId];
            // const translateValue = -slider.currentIndex * 100;
                 const slider = sliders[postId];
            const translateValue = slider.currentIndex * 100; // تغییر به مقدار مثبت
            slider.container.style.transform = `translateX(${translateValue}%)`;

            // slider.container.style.transform = `translateX(${translateValue}%)`;

            // به روزرسانی نقاط فعال
            slider.dots.forEach((dot, i) => {
                dot.classList.toggle('active', i === slider.currentIndex);
            });

            // بخش جدید: به روزرسانی data-media-url و نمایش URL
            const activeSlide = slider.container.children[slider.currentIndex];
            const mediaElement = activeSlide.querySelector('.media-item'); // img یا video

            if (mediaElement) {
                const mediaUrl = mediaElement.getAttribute('data-media-url');

                // 1. به روزرسانی data-media-url در خود المان
                mediaElement.setAttribute('data-media-url', mediaUrl);

                // 2. نمایش URL در رابط کاربری (اگر نیاز دارید)
                // const q = doc.getElementById(`media-${postId}`);
                // const e = q.getAttribute(`data-media-url`);
                // console.log(e);
                const urlDisplay = document.getElementById(`media-url-display-${postId}`);
                if (urlDisplay) {
                    urlDisplay.textContent = mediaUrl;
                }

                // 3. اگر ویدیو است، آن را ریلود کنید
                if (mediaElement.tagName.toLowerCase() === 'video') {
                    const video = mediaElement;
                    video.querySelector('source').src = mediaUrl;
                    video.load();
                }
                // var q = Model.PostResult.Data.
                // id="media-{media.PostId-media.Id}"
                 // data-media-url="Directories.GetInstagramPostVideo(media.VideoName)"

            }
        }

        // مدیریت حذف پست
        async function deletePost(postId) {
            const { isConfirmed } = await Swal.fire({
                title: 'حذف پست',
                text: "آیا مطمئن هستید؟",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'حذف',
                cancelButtonText: 'انصراف',
                customClass: {
                    confirmButton: 'swal-confirm-fa',
                    cancelButton: 'swal-cancel-fa'
                }
            });

            if (isConfirmed) {
                try {
                    const response = await fetch(
                        `?handler=Delete&postId=${postId}&instagramId=${@Model.InstagramId}`,
                        {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': document.querySelector(
                                    'input[name="__RequestVerificationToken"]'
                                ).value
                            }
                        }
                    );
                     const result = await response.json();

                     if (response.ok) {
                         Swal.fire({
                             title: result.message,
                             icon: "success",
                             confirmButtonText: "باشه",
                         }).then(() => {
                             window.location.reload();
                         });
                     } else {
                         throw new Error(result.message || 'خطا در حذف پست');
                     }
                } catch (error) {
                    Swal.fire('خطا!', error.message, 'error');
                }
            }
        }

        // مقداردهی اولیه اسلایدرها
        document.addEventListener('DOMContentLoaded', () => {
        @foreach (var post in Model.PostResult.Data)
        {
            <text>
                                        initSlider('@post.Id', @post.Videos.Count);
            </text>
        }
        });
    </script>
}

