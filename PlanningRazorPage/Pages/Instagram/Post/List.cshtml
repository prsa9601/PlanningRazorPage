@functions {
    private bool IsImage(PostVideoDto media)
    {
        var imageExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp" };
        var extension = System.IO.Path.GetExtension(media.VideoName)?.ToLower();
        return imageExtensions.Contains(extension);
    }
