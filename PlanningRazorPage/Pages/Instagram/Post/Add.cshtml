    <script>
                // تابع پیش‌نمایش و اعتبارسنجی
               // تابع پیش‌نمایش و اعتبارسنجی
        function previewMedia(input, previewId) {
            const MAX_TOTAL_FILES = 6;
            const MAX_FILE_SIZE_MB = 100;

            const previewContainer = document.getElementById(previewId);
            const files = input.files;

            // اعتبارسنجی تعداد فایل‌ها
            if (files.length > MAX_TOTAL_FILES) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطا!',
                    text: `حداکثر ${MAX_TOTAL_FILES} فایل مجاز است`,
                    confirmButtonText: 'متوجه شدم'
                });
                input.value = '';
                return;
            }

            // اعتبارسنجی حجم و فرمت فایل‌ها
            Array.from(files).forEach(file => {
                if (file.size > MAX_FILE_SIZE_MB * 1024 * 1024) {
                    Swal.fire({
                        icon: 'error',
                        title: 'خطا!',
                        text: `حجم فایل ${file.name} باید کمتر از ${MAX_FILE_SIZE_MB} مگابایت باشد`,
                        confirmButtonText: 'متوجه شدم'
                    });
                    input.value = '';
                    return;
                }
            });

            // نمایش پیش‌نمایش
            previewContainer.innerHTML = '';
            Array.from(files).forEach(file => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const previewItem = document.createElement('div');
                    previewItem.className = 'preview-item';

                    if (file.type.startsWith('image')) {
                        previewItem.innerHTML = `
                            <img src="${e.target.result}" alt="Preview">
                            <div class="remove-btn" onclick="removeFile(this, '${input.id}')">&times;</div>
                        `;
                    } else if (file.type.startsWith('video')) {
                        previewItem.innerHTML = `
                            <video controls><source src="${e.target.result}" type="${file.type}"></video>
                            <div class="remove-btn" onclick="removeFile(this, '${input.id}')">&times;</div>
                        `;
                    }

                    previewContainer.appendChild(previewItem);
                };
                reader.readAsDataURL(file);
            });
        }

        // تابع حذف فایل
        function removeFile(element, inputId) {
            const fileInput = document.getElementById(inputId);
            const files = Array.from(fileInput.files);
            const fileName = element.parentNode.querySelector('img, video').src.split('/').pop();

            const newFiles = files.filter(file => file.name !== fileName);
            const dataTransfer = new DataTransfer();
            newFiles.forEach(file => dataTransfer.items.add(file));

            fileInput.files = dataTransfer.files;
            element.parentNode.remove();
        }
    </script>
