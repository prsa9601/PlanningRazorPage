    <style>
        :root {
            --ig-gradient: linear-gradient(45deg, #405DE6, #833AB4, #C13584, #E1306C, #FD1D1D);
            --ig-primary: #E1306C;
        }

        .ig-card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .ig-header {
            background: var(--ig-gradient);
            color: white;
            padding: 1.5rem;
            border-radius: 20px 20px 0 0;
        }

        .ig-btn {
            background: var(--ig-primary);
            color: white;
            padding: 0.8rem 2rem;
            border-radius: 10px;
            transition: all 0.3s;
        }

            .ig-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(225, 48, 108, 0.4);
            }

        .file-upload-box {
            border: 2px dashed #ddd;
            border-radius: 15px;
            padding: 1.5rem;
            transition: border-color 0.3s;
        }

            .file-upload-box:hover {
                border-color: var(--ig-primary);
            }

        .media-preview {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .preview-item {
            position: relative;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

            .preview-item img,
            .preview-item video {
                width: 100%;
                height: 120px;
                object-fit: cover;
            }

        .remove-btn {
            position: absolute;
            top: 5px;
            right: 5px;
            background: rgba(255,255,255,0.9);
            width: 25px;
            height: 25px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .form-switch .form-check-input:not(:checked) {
            background-color: #6B8DD6;
            border-color: #6B8DD6;
        }

        .form-switch .form-check-input:checked {
            background-color: #dee2e6;
            border-color: #dee2e6;
        }

        .form-switch .form-check-input {
            transition: all 0.3s ease;
        }
    </style>

