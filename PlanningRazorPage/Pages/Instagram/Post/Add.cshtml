@page
@model PlanningRazorPage.Pages.Instagram.Post.AddModel
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "ایجاد پست اینستاگرام";
}

@section Header {
    <link rel="stylesheet" href="https://cdn.fontcdn.ir/Font/Persian/IRANSans/IRANSans.css">


    <style>
        /* بهبود استایل راستچین تقویم */
        .flatpickr-calendar {
            font-family: 'IRANSans', sans-serif !important;
            direction: rtl !important;
            text-align: right !important;
        }

        .flatpickr-months .flatpickr-month,
        .flatpickr-weekdays,
        .flatpickr-weekday {
            direction: rtl !important;
        }

        .flatpickr-weekday {
            text-align: center !important;
        }

        .flatpickr-day {
            font-family: 'IRANSans', sans-serif !important;
        }

        .numInputWrapper span.arrowUp:after {
            right: 0 !important;
            left: auto !important;
        }
    </style>

    <style>
        :root {
            --ig-gradient: linear-gradient(45deg, #405DE6, #833AB4, #C13584, #E1306C, #FD1D1D);
            --ig-primary: #E1306C;
        }

        .ig-card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .ig-header {
            background: var(--ig-gradient);
            color: white;
            padding: 1.5rem;
            border-radius: 20px 20px 0 0;
        }

        .ig-btn {
            background: var(--ig-primary);
            color: white;
            padding: 0.8rem 2rem;
            border-radius: 10px;
            transition: all 0.3s;
        }

            .ig-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(225, 48, 108, 0.4);
            }

        .file-upload-box {
            border: 2px dashed #ddd;
            border-radius: 15px;
            padding: 1.5rem;
            transition: border-color 0.3s;
        }

            .file-upload-box:hover {
                border-color: var(--ig-primary);
            }

        .media-preview {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .preview-item {
            position: relative;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

            .preview-item img,
            .preview-item video {
                width: 100%;
                height: 120px;
                object-fit: cover;
            }

        .remove-btn {
            position: absolute;
            top: 5px;
            right: 5px;
            background: rgba(255,255,255,0.9);
            width: 25px;
            height: 25px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .form-switch .form-check-input:not(:checked) {
            background-color: #6B8DD6;
            border-color: #6B8DD6;
        }

        .form-switch .form-check-input:checked {
            background-color: #dee2e6;
            border-color: #dee2e6;
        }

        .form-switch .form-check-input {
            transition: all 0.3s ease;
        }
    </style>

}

<div class="container py-5">
    <div class="ig-card">
        <div class="ig-header text-center">
            <h3><i class="fab fa-instagram me-2"></i>پست جدید اینستاگرام</h3>
        </div>

        <div class="card-body p-4">
            <form method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="InstagramAccountId" />

                <!-- زمان‌بندی -->
                <!-- بخش زمان‌بندی -->
                <!-- بخش زمان‌بندی -->
                <div class="row mb-9">
                    <div class="col-md-8">
                        <div class="d-flex align-items-center gap-4">
                            <div class="form-check form-switch">
                                <!-- اصلاح تگ input با بستن صحیح -->
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="scheduleSwitch"
                                       checked="checked" /> <!-- اضافه شدن اسلش بسته‌کننده -->
                                <label class="form-check-label"
                                       for="scheduleSwitch">
                                    ⏰ زمان‌بندی ارسال
                                </label>
                            </div>

                            <div class="flex-grow-3">
                                <label for="flatpickr-datetime"
                                       class="form-label mb-6 d-block">
                                    📅 تاریخ و زمان ارسال
                                </label>
                                <!-- اصلاح تگ input با بستن صحیح -->
                                <input asp-for="DateOfPosting"
                                       type="text"
                                       class="form-control text-end persian-date"
                                       placeholder="انتخاب تاریخ و زمان"
                                       id="flatpickr-datetime"
                                       dir="ltr"
                                       readonly="readonly" /> <!-- اضافه شدن اسلش بسته‌کننده -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- توضیحات -->
                <div class="mb-4">
                    <label asp-for="Description" class="form-label">📝 متن پست</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="متن پست را وارد کنید..."
                              required></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- لینک -->
                <div class="mb-4">
                    <label asp-for="Link" class="form-label">🔗 لینک در بیو (اختیاری)</label>
                    <input asp-for="Link"
                           class="form-control"
                           type="url"
                           placeholder="https://example.com" />
                    <span asp-validation-for="Link" class="text-danger"></span>
                </div>

                <!-- آپلود مدیا -->
                <div class="row">
                    <div class="col-md-6 mb-4">
                        <div class="file-upload-box">
                            <label class="form-label">🖼️ آپلود عکس‌ها (حداکثر 10)</label>
                            <input asp-for="Images"
                                   class="form-control"
                                   type="file"
                                   multiple
                                   accept=".jpg,.jpeg,.png"
                                   onchange="previewMedia(this, 'imagePreview')" />
                            <div id="imagePreview" class="media-preview"></div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <div class="file-upload-box">
                            <label class="form-label">🎥 آپلود ویدیو (حداکثر 1)</label>
                            <input asp-for="Videos"
                                   class="form-control"
                                   type="file"
                                   accept=".mp4,.mov"
                                   onchange="previewMedia(this, 'videoPreview')" />
                            <div id="videoPreview" class="media-preview"></div>
                        </div>
                    </div>
                </div>

                <button type="submit" class="ig-btn w-100">
                    <i class="fas fa-cloud-upload-alt me-2"></i>ذخیره و برنامه‌ریزی
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/vendor/libs/moment/moment.js"></script>
    <script src="~/assets/vendor/libs/jdate/jdate.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/flatpickr-jdate.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/fa-jdate.js"></script>
    <script src="~/assets/js/forms-pickers.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.29.1/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jalali-moment@3.3.10/dist/jalali-moment.browser.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/fa-jdate.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/moment@2.29.1/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jalali-moment@3.3.10/dist/jalali-moment.browser.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="~/assets/vendor/libs/flatpickr/fa-jdate.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/monthSelect.js"></script>

    <script>
         document.querySelector('form').addEventListener('submit', async (e) => {
                e.preventDefault();

                const form = e.target;
                const formData = new FormData(form);
                const submitBtn = form.querySelector('button[type="submit"]');

                try {
                    // تبدیل تاریخ شمسی به میلادی
                    const persianDate = formData.get('DateOfPosting');
                    const gregorianDate = moment(persianDate, 'jYYYY/jMM/jDD HH:mm', 'fa')
                        .locale('en')
                        .toDate()
                        .toISOString();

                    formData.set('DateOfPosting', gregorianDate);

                    // اعتبارسنجی فایل‌ها
                    const images = formData.getAll('Images');
                    const videos = formData.getAll('Videos');

                    if(images.length + videos.length === 0) {
                        throw new Error('حداقل یک فایل باید انتخاب شود');
                    }

                    // ارسال درخواست
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>در حال ارسال...';

                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('[name="__RequestVerificationToken"]').value
                        }
                    });

                    if (!response.ok) {
                        const error = await response.json();
                        throw new Error(error.message || 'خطا در ارسال اطلاعات');
                    }

                    // نمایش پیام موفقیت
                    Swal.fire({
                        icon: 'success',
                        title: 'پست با موفقیت ثبت شد!',
                        confirmButtonText: 'باشه'
                    }).then(() => window.location.href = '@Url.Page("./Index")');

                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'خطا!',
                        text: error.message,
                        confirmButtonText: 'متوجه شدم'
                    });
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-cloud-upload-alt me-2"></i>ذخیره و برنامه‌ریزی';
                }
            });
        document.addEventListener('DOMContentLoaded', function () {
            // تنظیمات فارسی‌سازی Flatpickr

            flatpickr.localize(flatpickr.l10ns.fa);

            const persianConfig = {
                locale: "fa",
                enableTime: true,
                dateFormat: "Y/m/d H:i",
                time_24hr: true,
                static: true,
                monthSelectorType: "static",
                plugins: [
                    new monthSelectPlugin({
                        shorthand: true,
                        dateFormat: "Y/m",
                        altFormat: "Y/m"
                    })
                ],
                nextArrow: '<i class="fas fa-chevron-right"></i>',
                prevArrow: '<i class="fas fa-chevron-left"></i>'
            };

            const datePicker = flatpickr("#flatpickr-datetime", persianConfig);
            const scheduleSwitch = document.getElementById("scheduleSwitch");

            // مقداردهی اولیه بر اساس وضعیت چک‌باکس
            const updatePickerState = () => {
                if (scheduleSwitch.checked) {
                    datePicker.setDate(moment().format("jYYYY/jMM/jDD HH:mm"));
                    datePicker.close();
                    datePicker.disable();
                } else {
                    datePicker.enable();
                }
            };

            // رویداد تغییر وضعیت چک‌باکس
            scheduleSwitch.addEventListener("change", updatePickerState);
            updatePickerState(); // مقداردهی اولیه
        });

        // تابع پیش‌نمایش مدیا بدون تغییر
        function previewMedia(input, previewId) {
            // ... کد موجود بدون تغییر ...
        }
    </script>
    <script>

        document.addEventListener('DOMContentLoaded', function() {
            const persianDateConfig = {
                locale: "fa",
                enableTime: true,
                dateFormat: "Y/m/d H:i",
                time_24hr: true,
                static: true
            };

            // تابع مقداردهی اولیه تقویم
            const initDateTimePicker = () => {
                const now = moment().locale('fa');
                const formattedDate = now.format('jYYYY/jMM/jDD HH:mm');
                const dateInput = document.getElementById('flatpickr-datetime');
                const scheduleSwitch = document.getElementById('scheduleSwitch');

                // حالت اولیه: چک باکس خاموش و تقویم فعال
                scheduleSwitch.checked = false;
                dateInput.disabled = true;
                flatpickr(dateInput, {...persianDateConfig, defaultDate: formattedDate});

                // مدیریت تغییر وضعیت چک باکس
                scheduleSwitch.addEventListener('change', () => {
                    if (scheduleSwitch.checked) {
                        // اگر چک باکس روشن شد: تقویم غیرفعال و مقدارش پاک شود
                        dateInput.disabled = false;
                        dateInput.value = '';
                    } else {
                        // اگر چک باکس خاموش شد: تقویم فعال و تاریخ فعلی تنظیم شود
                        dateInput.disabled = true;
                        dateInput.value = formattedDate;
                        flatpickr(dateInput, {...persianDateConfig, defaultDate: formattedDate});
                    }
                });
            };

            // تابع مدیریت ارسال فرم
            const handleSubmitClick = async (e) => {
                e.preventDefault();
                const submitBtn = document.getElementById('submitBtn');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> در حال ارسال...';

                try {
                    const formData = new FormData();
                    // ... سایر فیلدها ...

                    // مدیریت فیلد تاریخ فقط وقتی چک باکس خاموش است
                    if (!document.getElementById('scheduleSwitch').checked) {
                        const persianDate = document.getElementById('flatpickr-datetime').value;
                        if (!persianDate) throw new Error('تاریخ ارسال الزامی است');

                        const gregorianDate = moment(persianDate, 'jYYYY/jMM/jDD HH:mm', 'fa')
                            .locale('en')
                            .toDate()
                            .toISOString();
                        formData.append('ScheduleDate', gregorianDate);
                    }

                    // ... بقیه عملیات ارسال ...
                } catch (error) {
                    // ... مدیریت خطاها ...
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="mdi mdi-send-check-outline me-2"></i> ثبت پست';
                }
            };

            // مقداردهی اولیه
            initDateTimePicker();
            // ... بقیه تنظیمات ...
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize Flatpickr with Jalali settings
            const calendar = flatpickr('.flatpickr-datetime', {
                locale: 'fa',
                jalali: true,
                enableTime: true,
                dateFormat: 'Y/m/d H:i',
                time_24hr: true,
                static: true,
                defaultDate: new Date(), // Set default to current time
                plugins: [
                    new monthSelectPlugin({
                        shorthand: true,
                        dateFormat: 'Y/m',
                        altFormat: 'Y/m'
                    })
                ]
            });

            // Toggle calendar function
            window.toggleCalendar = function (checkbox) {
                if (checkbox.checked) {
                    // Set to current time and disable
                    calendar.setDate(new Date());
                    calendar.close();
                    calendar.disable();
                } else {
                    calendar.enable();
                }
            };

            // Initialize checkbox to unchecked and enable calendar
            document.getElementById('scheduleToggle').checked = false;
            calendar.enable();
        });

        // Media preview function remains unchanged

        // Form submission handling
        document.querySelector('form').addEventListener('submit', async (e) => {
            e.preventDefault();

            const checkbox = document.getElementById('scheduleToggle');
            const persianDate = document.querySelector('.flatpickr-datetime').value;

            // Convert to Gregorian date
            const gregorianDate = moment(persianDate, 'jYYYY/jMM/jDD HH:mm', 'fa')
                .locale('en')
                .toDate()
                .toISOString();

            const formData = new FormData(e.target);
            formData.set('DateOfPosting', gregorianDate);

            // Submit formData as before
            // ...
        });
    </script>
}
