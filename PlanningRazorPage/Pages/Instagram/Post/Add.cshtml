@page
@model PlanningRazorPage.Pages.Instagram.Post.AddModel
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "ایجاد پست اینستاگرام";
}

@section Header {
    <link rel="stylesheet" href="https://cdn.fontcdn.ir/Font/Persian/IRANSans/IRANSans.css">
    @* <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"> *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.css">
    <style>
        :root {
            --ig-gradient: linear-gradient(45deg, #405DE6, #833AB4, #C13584, #E1306C, #FD1D1D);
            --ig-primary: #E1306C;
        }

        .ig-card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .ig-header {
            background: var(--ig-gradient);
            color: white;
            padding: 1.5rem;
            border-radius: 20px 20px 0 0;
        }

        .ig-btn {
            background: var(--ig-primary);
            color: white;
            padding: 0.8rem 2rem;
            border-radius: 10px;
            transition: all 0.3s;
        }

        .file-upload-box {
            border: 2px dashed #ddd;
            border-radius: 15px;
            padding: 1.5rem;
            transition: border-color 0.3s;
        }

        .media-preview {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 1rem;
        }

        .preview-item {
            position: relative;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            aspect-ratio: 1;
            flex: 0 0 calc(16.666% - 1rem);
            max-width: calc(16.666% - 1rem);
            cursor: move;
        }

            .preview-item.dragging {
                opacity: 0.5;
                transform: scale(0.95);
            }

            .preview-item img,
            .preview-item video {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center;
            }

        .remove-btn {
            position: absolute;
            top: 8px;
            left: 8px;
            background: rgba(255, 73, 73, 0.9);
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: white;
            font-weight: bold;
            font-size: 16px;
            transition: all 0.2s ease;
        }

            .remove-btn:hover {
                background: #ff0000;
                transform: scale(1.1);
            }

        .file-order {
            position: absolute;
            bottom: 8px;
            left: 8px;
            background: rgba(0, 0, 0, 0.75);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            backdrop-filter: blur(2px);
        }

        .move-buttons {
            position: absolute;
            top: 8px;
            right: 8px;
            display: flex;
            gap: 4px;
        }

        .move-btn {
            background: rgba(0, 0, 0, 0.7);
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: white;
            transition: all 0.2s;
        }

            .move-btn:hover {
                background: rgba(0, 0, 0, 0.9);
                transform: scale(1.1);
            }

        @@media (max-width: 1200px) {
            .preview-item {
                flex: 0 0 calc(20% - 1rem);
                max-width: calc(20% - 1rem);
            }
        }

        @@media (max-width: 992px) {
            .preview-item {
                flex: 0 0 calc(25% - 1rem);
                max-width: calc(25% - 1rem);
            }
        }

        @@media (max-width: 768px) {
            .preview-item {
                flex: 0 0 calc(33.333% - 1rem);
                max-width: calc(33.333% - 1rem);
            }
        }

        @@media (max-width: 576px) {
            .preview-item {
                flex: 0 0 calc(50% - 1rem);
                max-width: calc(50% - 1rem);
            }
        }

        .flatpickr-calendar {
            font-family: 'IRANSans', sans-serif !important;
            direction: rtl !important;
        }
    </style>
}

<div class="container py-5">
    <div class="ig-card">
        <div class="ig-header text-center">
            <h3><i class="fab fa-instagram me-2"></i>پست جدید اینستاگرام</h3>
        </div>

        <div class="card-body p-4">
            <form method="post" enctype="multipart/form-data">
                <div class="row mb-4">
                    <div class="col-md-5">
                        <div class="form-floating">
                            <select class="form-select" asp-for="InstagramId" required>
                                <option value="">انتخاب حساب اینستاگرام</option>
                                @foreach (var account in Model.Account!)
                                {
                                    <option value="@account.Id">📱 @account.InstagramUserName</option>
                                }
                            </select>
                            <label class="text-primary">
                                <i class="fas fa-instagram me-2"></i>حساب اینستاگرام
                            </label>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <div class="d-flex align-items-center gap-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="scheduleSwitch">
                                <label class="form-check-label">⏰ ارسال فوری</label>
                            </div>

                            <div class="flex-grow-1">
                                <input asp-for="DateOfPosting"
                                       type="text"
                                       class="form-control text-end"
                                       placeholder="انتخاب تاریخ"
                                       id="flatpickr-datetime"
                                       dir="ltr"
                                       readonly>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">📝 متن پست</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="متن پست را وارد کنید..."
                              required></textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label">🔗 لینک در بیو</label>
                    <input asp-for="Link"
                           class="form-control"
                           type="url"
                           placeholder="https://example.com">
                </div>

                <div class="file-upload-box mb-4">
                    <label class="form-label">📁 آپلود مدیا (حداکثر ۶ فایل)</label>
                    <input asp-for="Videos"
                           type="file"
                           multiple
                           accept="image/*,video/*"
                           id="mediaInput"
                           hidden
                           onchange="handleFileSelect(event)">
                    <button type="button"
                            onclick="document.getElementById('mediaInput').click()"
                            class="ig-btn mb-3">
                        <i class="fas fa-plus me-2"></i>انتخاب فایل‌ها
                    </button>
                    <div id="mediaPreview" class="media-preview"></div>
                    <span class="text-muted">فرمت‌های مجاز: JPG, PNG, MP4, MOV, MKV (حداکثر ۵۰ مگابایت)</span>
                </div>

                <button type="button" id="submitBtn" class="ig-btn w-100">
                    <i class="fas fa-cloud-upload-alt me-2"></i>ذخیره و برنامه‌ریزی
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.29.1/moment.min.js"></script>
    @* <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script> *@
    <script src="~/assets/vendor/libs/flatpickr/fa-jdate.js"></script><!-- Flatpickr اصلی -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.9/dist/flatpickr.min.js"></script>

    <!-- زبان فارسی برای Flatpickr -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.9/dist/l10n/fa.js"></script>

    <!-- پلاگین تقویم جلالی -->
    <script src="https://unpkg.com/flatpickr-jalali@1.0.1/dist/plugin.js"></script>

    <!-- کتابخانه moment-jalaali برای تبدیل تاریخ -->
    <script src="https://cdn.jsdelivr.net/npm/moment-jalaali@0.9.2/build/moment-jalaali.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>




    <script>
        // مدیریت فایل‌ها
        let selectedFiles = [];
        const MAX_FILES = 6;
        const MAX_SIZE_MB = 50;
        const ALLOWED_MIME_TYPES = [
            'image/jpeg', 'image/png', 'image/gif',
            'video/mp4', 'video/quicktime', 'video/x-matroska',
            'video/webm', 'video/x-msvideo'
        ];
        let sortableInstance = null;

        // --------------- اعتبارسنجی پیشرفته ---------------
        function showFieldError(fieldId, message) {
            const field = document.getElementById(fieldId);
            const errorDiv = document.createElement('div');
            errorDiv.className = 'text-danger mt-1 small';
            errorDiv.id = `${fieldId}-error`;
            errorDiv.textContent = message;

            if (!document.getElementById(`${fieldId}-error`)) {
                field.parentElement.appendChild(errorDiv);
            }
        }

        function clearFieldError(fieldId) {
            const errorElement = document.getElementById(`${fieldId}-error`);
            if (errorElement) errorElement.remove();
        }

        // اعتبارسنجی URL با الگوی اینستاگرام
        function isValidInstagramLink(url) {
            try {
                const parsed = new URL(url);
                return parsed.hostname === 'instagram.com' ||
                       parsed.hostname === 'www.instagram.com';
            } catch {
                return false;
            }
        }

        function isValidURL(url) {
            const pattern = /^(https?:\/\/)?([\da-z.-]+)\.([a-z.]{2,6})([/\w .-]*)*\/?$/;
            return pattern.test(url);
        }
        // اعتبارسنجی پیشرفته فایل‌ها
        function validateFiles(files) {
            let isValid = true;

            // اعتبارسنجی تعداد فایل‌ها
            if (files.length + selectedFiles.length > MAX_FILES) {
                showError(`حداکثر ${MAX_FILES} فایل مجاز است`);
                isValid = false;
            }

            files.forEach(file => {
                // اعتبارسنجی حجم فایل
                if (file.size > MAX_SIZE_MB * 1024 * 1024) {
                    showError(`حجم فایل ${file.name} باید کمتر از ${MAX_SIZE_MB} مگابایت باشد`);
                    isValid = false;
                }

                // اعتبارسنجی نوع فایل
                const fileType = file.type.toLowerCase();
                if (!ALLOWED_MIME_TYPES.includes(fileType)) {
                    showError(`فرمت ${file.name} (${fileType}) پشتیبانی نمی‌شود`);
                    isValid = false;
                }
            });

            return isValid;
        }

        // اعتبارسنجی پیشرفته متن پست
        function validateDescription(text) {
            const forbiddenWords = ['اسپم', 'تبلیغ', 'فیلترشده'];
            const hasForbidden = forbiddenWords.some(word => text.includes(word));
            if (hasForbidden) {
                showFieldError('Description', 'متن حاوی کلمات ممنوعه است');
                return false;
            }
            return true;
        }

        // اعتبارسنجی جامع فرم
        function validateForm() {
            let isValid = true;

            // اعتبارسنجی حساب اینستاگرام
            const instagramId = document.getElementById('InstagramId').value;
            if (!instagramId) {
                showFieldError('InstagramId', 'انتخاب حساب الزامی است');
                isValid = false;
            } else {
                clearFieldError('InstagramId');
            }

            // اعتبارسنجی متن پست
            const description = document.getElementById('Description').value.trim();
            if (!description) {
                showFieldError('Description', 'متن پست الزامی است');
                isValid = false;
            } else if (description.length > 2200) {
                showFieldError('Description', 'حداکثر ۲۲۰۰ کاراکتر مجاز است');
                isValid = false;
            } else if (!validateDescription(description)) {
                isValid = false;
            } else {
                clearFieldError('Description');
            }

            // اعتبارسنجی لینک
            const link = document.getElementById('Link').value;
            // if (link) {
            //     if (!isValidInstagramLink(link)) {
            //         showFieldError('لینک باید مرتبط با اینستاگرام باشد (instagram.com)');
            //         isValid = false;
            //     } else {
            //         clearFieldError('Link');
            //     }
            // }
            if (link) {
                if (!isValidURL(link)) {
                    showFieldError('فزمت لینک اشتباه است ');
                    isValid = false;
                } else {
                    clearFieldError('Link');
                }
            }

            // اعتبارسنجی فایل‌ها
            if (selectedFiles.length === 0) {
                showFieldError('mediaInput', 'حداقل یک فایل الزامی است');
                isValid = false;
            } else {
                clearFieldError('mediaInput');
            }

            // اعتبارسنجی پیشرفته تاریخ
            const scheduleSwitch = document.getElementById('scheduleSwitch');
            if (!scheduleSwitch.checked) {
                const dateValue = document.getElementById('flatpickr-datetime').value;
                const persianDate = moment(dateValue, 'jYYYY/jMM/jDD HH:mm', 'fa');

                if (!persianDate.isValid()) {
                    showFieldError('flatpickr-datetime', 'فرمت تاریخ نادرست است');
                    isValid = false;
                } else if (persianDate.isBefore(moment().add(30, 'minutes'))) {
                    showFieldError('flatpickr-datetime', 'حداقل ۳۰ دقیقه تا ارسال');
                    isValid = false;
                }
            }

            return isValid;
        }

        function initSortable() {
            const previewContainer = document.getElementById('mediaPreview');
            sortableInstance = new Sortable(previewContainer, {
                animation: 150,
                ghostClass: 'dragging',
                onUpdate: function(evt) {
                    const movedItem = selectedFiles[evt.oldIndex];
                    selectedFiles.splice(evt.oldIndex, 1);
                    selectedFiles.splice(evt.newIndex, 0, movedItem);
                    updateOrderNumbers();
                    updateInputFiles();
                }
            });
        }

        function updateOrderNumbers() {
            document.querySelectorAll('.file-order').forEach((el, index) => {
                el.textContent = index + 1;
            });
        }

        function handleFileSelect(e) {
            const newFiles = Array.from(e.target.files);

            if (!validateFiles(newFiles)) {
                e.target.value = '';
                return;
            }

            selectedFiles = [...selectedFiles, ...newFiles].slice(0, MAX_FILES);
            updateFilePreview();
            updateInputFiles();

            if (!sortableInstance) {
                initSortable();
            }
        }

        function updateFilePreview() {
            const previewContainer = document.getElementById('mediaPreview');
            previewContainer.innerHTML = '';

            const previewPromises = selectedFiles.map((file, index) => {
                return new Promise((resolve) => {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const isVideo = file.type.startsWith('video/');
                        const isGif = file.type === 'image/gif';

                        resolve(`
                            <div class="preview-item">
                                ${isVideo || isGif
                                    ? `<video ${isGif ? 'autoplay loop muted playsinline' : 'controls'}>
                                        <source src="${e.target.result}" type="${file.type}">
                                      </video>`
                                    : `<img src="${e.target.result}" alt="Preview">`}
                                <div class="remove-btn" onclick="removeFile(${index})">&times;</div>
                                <div class="file-order">${index + 1}</div>
                                <div class="move-buttons">
                                    <div class="move-btn" onclick="moveUp(${index})">↑</div>
                                    <div class="move-btn" onclick="moveDown(${index})">↓</div>
                                </div>
                            </div>
                        `);
                    };
                    reader.readAsDataURL(file);
                });
            });

            Promise.all(previewPromises).then(htmls => {
                previewContainer.innerHTML = htmls.join('');
                updateOrderNumbers();
            });
        }

        function moveUp(index) {
            if (index > 0) {
                [selectedFiles[index], selectedFiles[index - 1]] = [selectedFiles[index - 1], selectedFiles[index]];
                updateFilePreview();
                updateInputFiles();
            }
        }

        function moveDown(index) {
            if (index < selectedFiles.length - 1) {
                [selectedFiles[index], selectedFiles[index + 1]] = [selectedFiles[index + 1], selectedFiles[index]];
                updateFilePreview();
                updateInputFiles();
            }
        }

        function removeFile(index) {
            selectedFiles.splice(index, 1);
            updateFilePreview();
            updateInputFiles();
        }

        function updateInputFiles() {
            const dataTransfer = new DataTransfer();
            selectedFiles.forEach(file => dataTransfer.items.add(file));
            document.getElementById('mediaInput').files = dataTransfer.files;
        }

        // مدیریت تاریخ
            flatpickr('#flatpickr-datetime', {
            locale: 'fa', // فعالسازی زبان فارسی
            jalali: true, // فعالسازی تقویم جلالی (شمسی)
            enableTime: true, // فعالسازی انتخاب زمان
            dateFormat: 'Y/m/d H:i', // فرمت تاریخ: سال/ماه/روز ساعت:دقیقه
            time_24hr: true, // فرمت 24 ساعته
            static: true, // نمایش ثابت تقویم
          defaultDate: moment().format('jYYYY/jMM/jDD HH:mm'),
        });

        document.getElementById('scheduleSwitch').addEventListener('change', function() {
            document.getElementById('flatpickr-datetime').disabled = this.checked;
        });

        // مدیریت ارسال فرم
        document.getElementById('submitBtn').addEventListener('click', async function(e) {
            e.preventDefault();

            if (!validateForm()) return;

            const form = document.querySelector('form');
            const formData = new FormData(form);

            try {
                this.disabled = true;
                this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>در حال ارسال...';

                // تبدیل تاریخ
                const persianDate = document.getElementById('flatpickr-datetime').value;
                const gregorianDate = moment(persianDate, 'jYYYY/jMM/jDD HH:mm', 'fa')
                    .locale('en')
                    .format('YYYY-MM-DDTHH:mm:ssZ');
                formData.set('DateOfPosting', gregorianDate);

                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                const result = await response.json();

                if (!result.success) {
                    if (result.errorType === 'validation') {
                        // نمایش خطاهای سمت سرور
                        Object.entries(result.errors).forEach(([field, errors]) => {
                            const fieldId = field.replace('Model.', '');
                            showFieldError(fieldId, errors.join(', '));
                        });
                    } else {
                        throw new Error(result.error || 'خطای سرور');
                    }
                } else {
                    Swal.fire({
                        icon: 'success',
                        title: 'پست با موفقیت ثبت شد!',
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() =>{
                        // const accountId = @Model.InstagramId;
                        window.location.href = `./List?instagramId=${result.instagramId}`;
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطا!',
                    text: error.message,
                    confirmButtonText: 'متوجه شدم'
                });
            } finally {
                this.disabled = false;
                this.innerHTML = '<i class="fas fa-cloud-upload-alt me-2"></i>ذخیره و برنامه‌ریزی';
            }
        });
         
        function toggleCalendar() {
            const checkbox = document.getElementById('scheduleSwitch');
            if (checkbox.checked) {
                calendar.disable(); // اگر چکباکس فعال است، تقویم را غیرفعال کن
                calendar.defaultDate = moment().format('jYYYY/jMM/jDD HH:mm');
            } else {
                calendar.enable(); // اگر چکباکس غیرفعال است، تقویم را فعال کن
                calendar.defaultDate = moment().format('jYYYY/jMM/jDD HH:mm');

            }
        }

        function showError(message) {
            Swal.fire({
                icon: 'error',
                title: 'خطا!',
                text: message,
                confirmButtonText: 'متوجه شدم'
            });
        }
    </script>
}
