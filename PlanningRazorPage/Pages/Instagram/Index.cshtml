@section Scripts {

    <script>
        function handleDelete(accountId) {
            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: "این عمل قابل بازگشت نیست!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#E1306C',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'بله، حذف کن!',
                cancelButtonText: 'لغو'
            }).then((result) => {
                if (result.isConfirmed) {
                    // ارسال درخواست حذف به سرور
                    fetch(`?handler=DeleteAccount&accountId=${accountId}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    })
                    .then(response => {
                        // var res = JSON.parse(response);
                        if (response.ok) {
                            Swal.fire({
                                title: 'حذف شد!',
                                text: 'حساب با موفقیت حذف شد.',
                                icon: 'success',
                                confirmButtonColor: '#E1306C'
                            }).then(() => window.location.reload());
                        } else {
                            throw new Error('حذف انجام نشد');
                        }
                    })
                    .catch(error => {
                        Swal.fire({
                            title: 'خطا!',
                            text: error.message,
                            icon: 'error',
                            confirmButtonColor: '#E1306C'
                        });
                    });
                }
            });
        }
    </script>

    <script>
        // مدیریت پیشنمایش تصویر
        const profileImage = document.getElementById('profileImage');
        const previewContainer = document.getElementById('previewContainer');
        const imagePreview = document.getElementById('imagePreview');

        profileImage.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewContainer.style.display = 'block';
                    imagePreview.src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        });

        function removeImage() {
            profileImage.value = '';
            previewContainer.style.display = 'none';
            imagePreview.src = '';
        }

        // مدیریت ارسال فرم با Fetch API
        document.querySelector('form').addEventListener('submit', async function(e) {
            e.preventDefault();

            // اعتبارسنجی فیلدها
            const username = this.UserName.value.trim();
            const token = this.AccessToken.value.trim();
            const terms = this.terms.checked;
            const imageFile = this.ProfileImage.files[0];

            if (!username || !token || !terms || !imageFile) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطا!',
                    text: 'لطفا تمام فیلدهای ضروری را پر کنید',
                    confirmButtonColor: '#E1306C'
                });
                return;
            }
            if (!terms) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطا!',
                    text: 'لطفا قوانین رو مطالعه کرده و تیک تایید قوانین رو بزنید!',
                    confirmButtonColor: '#E1306C'
                });
                return;
            }

            // ایجاد FormData برای آپلود فایل
            const formData = new FormData();
            formData.append('UserName', username);
            formData.append('AccessToken', token);
            formData.append('ProfileImage', imageFile);

            try {
                // ارسال درخواست
                const response = await fetch('', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                if (!response.ok) {
                    throw new Error(await response.text());
                }

                // نمایش موفقیت و ریست فرم
                Swal.fire({
                    icon: 'success',
                    title: 'اتصال موفق!',
                    text: 'حساب با موفقیت اضافه شد',
                    confirmButtonColor: '#E1306C',
                    timer: 2000
                }).then(() => {
                    window.location.reload(); // رفرش صفحه برای نمایش داده‌های جدید
                });

            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطا!',
                    text: error.message || 'مشکلی در ارتباط با سرور پیش آمد',
                    confirmButtonColor: '#E1306C'
                });
            }
        });
    </script>
