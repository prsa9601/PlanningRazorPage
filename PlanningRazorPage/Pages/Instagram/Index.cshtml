@section Scripts {
    <script>
        // مدیریت فرم اتصال
        document.querySelector('.add-account-form').addEventListener('submit', function(e) {
            e.preventDefault();

            const username = this.querySelector('input[type="text"]').value;
            const accessToken = this.querySelector('input[type="password"]').value;
            const terms = this.querySelector('#termsCheck').checked;

            if (!username || !accessToken || !terms) {
                Swal.fire('خطا!', 'لطفا تمام فیلدها را تکمیل کنید', 'error');
                return;
            }

            Swal.fire('موفق!', 'اکانت با موفقیت متصل شد', 'success');
            this.reset();
        });
    </script>
} *@