@using PlanningRazorPage.Infrastructure.Utils
@using PlanningRazorPage.Models.Notification
@using PlanningRazorPage.Services.Notification;
@using PlanningRazorPage.Services.User.UserNotification;
@inject PlanningRazorPage.Services.Notification.INotificationService _notificationService;
@inject PlanningRazorPage.Services.User.UserNotification.IUserNotificationService _userNotificationService;

<nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme" id="layout-navbar">
    <!-- ... کدهای قبلی بدون تغییر ... -->

    <div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">
        <!-- ... کدهای جستجو بدون تغییر ... -->
        @{
            if (User.Identity.IsAuthenticated)
            {

                NotificationFilterResult Notifications;
                Notifications = await _notificationService.GetFilterNotificationsCurrentUser(new NotificationFilterParamViewModel
                {
                    PageId = 1,
                    Take = 8
                });

                <ul class="navbar-nav flex-row align-items-center ms-auto">
                    <!-- Notification -->
                    <li class="nav-item dropdown-notifications navbar-dropdown dropdown me-3 me-xl-1">
                        <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <i class="mdi mdi-bell-outline mdi-24px"></i>

                            @if (Notifications.Data.Any(i => i.IsSeen == false) && User.Identity.IsAuthenticated)
                            {
                                <span id="notificationBadge"
                                class="position-absolute top-0 start-50 translate-middle-y badge badge-dot bg-danger mt-2 border"></span>
                            }
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end py-0">
                            <li class="dropdown-menu-header border-bottom">
                                <div class="dropdown-header d-flex align-items-center py-3">
                                    <h6 class="mb-0 me-auto">اعلان ها</h6>
                                    @{
                                        var unreadCount = Notifications.Data.Count(i => i.IsSeen == false);
                                        if (unreadCount > 0)
                                        {
                                            <span class="badge rounded-pill bg-label-primary notification-count">
                                                @unreadCount
                                            </span>
                                        }
                                    }
                                </div>
                            </li>
                            <li class="dropdown-notifications-list scrollable-container ps">
                                <ul class="list-group list-group-flush">
                                    @if (!Notifications.Data.Any())
                                    {
                                        <li class="list-group-item list-group-item-action dropdown-notifications-item">
                                            <div class="d-flex gap-2 justify-content-center">
                                                <div class="d-flex flex-column flex-grow-1 overflow-hidden w-px-200 text-center">
                                                    <h6 class="mb-1 text-truncate">
                                                        نوتیفیکیشنی یافت نشد!
                                                    </h6>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                    else
                                    {
                                        @foreach (var notification in Notifications.Data)
                                        {
                                            <li class="list-group-item list-group-item-action dropdown-notifications-item
                                                             @(!notification.IsSeen ? "unread" : "")"
                                            data-notification-id="@notification.Id">
                                                @if (!notification.IsSeen)
                                                {
                                                    <span class="badge badge-dot bg-danger position-absolute start-0 top-0 mt-1 ms-1"></span>
                                                }
                                                <div class="d-flex gap-2">
                                                    <div class="flex-shrink-0">
                                                        <div class="avatar me-1">
                                                            <img src="~/assets/img/avatars/1.png"
                                                            alt=""
                                                            class="w-px-40 h-auto rounded-circle" />
                                                        </div>
                                                    </div>
                                                    <div class="d-flex flex-column flex-grow-1 overflow-hidden w-px-200">
                                                        <h6 class="mb-1 text-truncate">@notification.Title</h6>
                                                        <small class="text-truncate text-body">
                                                            @if (!string.IsNullOrEmpty(notification.Description))
                                                            {
                                                                @(notification.Description.Length > 50 ?
                                                                    notification.Description.Substring(0, 50) + "..." :
                                                                    notification.Description)
                                                            }
                                                        </small>
                                                    </div>
                                                    <div class="flex-shrink-0 dropdown-notifications-actions">
                                                        <small class="text-muted">@notification.SendTime.ToPersianDate()</small>
                                                    </div>
                                                </div>
                                            </li>
                                        }
                                    }
                                </ul>
                            </li>
                            <li class="dropdown-menu-footer border-top p-2">
                                <a href="Front/Profile/Notification"
                                class="btn btn-primary d-flex justify-content-center waves-effect waves-light">
                                    مشاهده همه اعلان ها
                                </a>
                            </li>
                        </ul>
                    </li>
                    <!--/ Notification -->
                    <!-- ... کدهای مربوط به کاربر بدون تغییر ... -->
                </ul>
            }
            else
            {
                
            }

        }
    </div>
</nav>
@if (User.Identity.IsAuthenticated)
{

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const notificationList = document.querySelector('.dropdown-notifications-list');

            // تابع علامت گذاری به عنوان خوانده شده
            async function markAsRead(notificationId, element) {
                try {
                    if (!element.classList.contains('unread')) return;

                    const formData = new FormData();
                    formData.append('notificationId', notificationId);

                    const response = await fetch('/Index?handler=MarkNotificationAsRead', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    if (response.ok) {
                        // حذف نشانگر خوانده نشده
                        element.classList.remove('unread');
                        const badge = element.querySelector('.badge-dot');
                        if (badge) badge.remove();

                        // به روزرسانی شمارنده
                        const countElement = document.querySelector('.notification-count');
                        if (countElement) {
                            let count = parseInt(countElement.textContent);
                            count--;

                            if (count <= 0) {
                                countElement.remove();
                                const mainBadge = document.getElementById('notificationBadge');
                                if (mainBadge) mainBadge.remove();
                            } else {
                                countElement.textContent = count;
                            }
                        }
                    }
                } catch (error) {
                    console.error('خطا در بروزرسانی نوتیفیکیشن:', error);
                }
            }

            // مشاهده آیتم‌های نوتیفیکیشن
            document.querySelectorAll('.dropdown-notifications-item.unread').forEach(item => {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const notificationId = item.dataset.notificationId;
                            markAsRead(notificationId, item);
                            observer.disconnect();
                        }
                    });
                }, { threshold: 0.5 });

                observer.observe(item);
            });
        });
    </script>
}