@page "{handler?}"
@using PlanningRazorPage.Infrastructure.Utils
@using PlanningRazorPage.Models.Package
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using PlanningRazorPage.Services.Package
@inject IPackageService _service
@model BillingModel
@{
    Layout = "Shared/_LayoutProfile";
}
 @section Header {
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #FF6B6B 0%, #FFE66D 100%);
            --secondary-gradient: linear-gradient(135deg, #4ECDC4 0%, #45B7AF 100%);
            --glass-effect: linear-gradient(145deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05));
            --neon-shadow: 0 0 20px rgba(255,107,107,0.3);
            --success-color: #2ecc71;
            --danger-color: #e74c3c;
        }

        .detail-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem;
            background: rgba(255,255,255,0.9);
            border-radius: 1rem;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
        }

            .detail-item:hover {
                transform: translateX(10px);
                box-shadow: var(--neon-shadow);
            }

        .detail-icon {
            font-size: 1.5rem;
            padding: 1rem;
            background: var(--primary-gradient);
            border-radius: 50%;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }

        .detail-value {
            margin: 0;
            font-weight: 600;
            color: #2d3436;
        }

        .modal-content {
            border: 2px solid #FF6B6B;
            box-shadow: var(--neon-shadow);
        }
        .billing-card {
            border-radius: 2rem;
            background: rgba(255,255,255,0.95);
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            margin: 2rem;
            padding: 2rem;
            border: 2px solid #FF6B6B;
            position: relative;
            overflow: hidden;
        }

        .table-header-custom {
            background: var(--primary-gradient);
            padding: 2rem;
            color: white;
            border-radius: 2rem 2rem 0 0;
            margin: -2rem -2rem 2rem -2rem;
        }

        .table-container {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 1rem;
        }

        .billing-table {
            --hover-scale: 1.02;
            --hover-bg: rgba(255,235,235,0.9);
            min-width: 1000px;
            width: 100%;
            border-collapse: collapse;
        }

            .billing-table th, 
            .billing-table td {
                padding: 1.5rem 2rem;
                text-align: center;
                white-space: nowrap;
            }

            .billing-table th {
                background: var(--secondary-gradient);
                color: white;
                font-weight: 600;
                position: sticky;
                top: 0;
            }

            .billing-table tr {
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                background: rgba(255,255,255,0.9);
            }

                .billing-table tr:hover {
                    transform: scale(var(--hover-scale));
                    background: var(--hover-bg);
                    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
                }

        .action-btn {
            padding: 0.8rem 1.5rem;
            border-radius: 1.5rem;
            border: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 500;
        }

            .action-btn.view {
                background: var(--secondary-gradient);
                box-shadow: 0 4px 15px rgba(78, 205, 196, 0.3);
                color: white !important;
            }

            .action-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0,0,0,0.15);
            }

        .table-container::-webkit-scrollbar {
            height: 8px;
            background: rgba(255,255,255,0.1);
        }

        .table-container::-webkit-scrollbar-thumb {
            background: var(--primary-gradient);
            border-radius: 4px;
            border: 2px solid white;
        }

        @@media (max-width: 768px) {
            .billing-card {
                margin: 1rem;
                border-radius: 1.5rem;
            }

            .billing-table {
                min-width: 800px;
            }

            .billing-table td {
                white-space: normal;
                padding: 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .billing-table td::before {
                    content: attr(data-label);
                    font-weight: bold;
                    color: #FF6B6B;
                    margin-left: 1rem;
                }

            .billing-table th {
                display: none;
            }

            .action-btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
}

<div class="col-xl-8 col-lg-7 col-md-7 order-0 order-md-1">
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link" asp-page="Account">
                <i class="mdi mdi-account-outline mdi-20px me-1"></i>حساب
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Security">
                <i class="mdi mdi-lock-open-outline mdi-20px me-1"></i>امنیت
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" asp-page="UserPackages">
                <i class="mdi mdi-bookmark-outline mdi-20px me-1"></i>پکیج های فعال
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               asp-page="Notification">
                <i class="mdi mdi-bell-outline mdi-20px me-1"></i>اعلان‌ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="RequestBox">
                <i class="mdi mdi-bell-outline mdi-20px me-1"></i>‌درخواست ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Connections"><i class="mdi mdi-link mdi-20px me-1"></i>اتصالات</a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               asp-page="Friends">
                <i class="mdi mdi-account-supervisor-outline mdi-20px me-1"></i>‌دوستان
            </a>
        </li>
    </ul>

    <div class="billing-card">
        <div class="table-header-custom">
            <h5 class="table-title mb-0">
                💳 مدیریت پکیج های فعال
                <span class="badge bg-light text-dark ms-2">@Model.packages.Count() پکیج</span>
            </h5>
        </div>

        <div class="table-container">
            <table class="table billing-table align-middle">
                <thead>
                    <tr>
                        <th data-label="نام پکیج">📦 نام</th>
                        <th data-label="تعداد ایمیل">📧 ایمیل</th>
                        <th data-label="تعداد پیامک">💬 پیامک</th>
                        <th data-label="قیمت">💰 قیمت</th>
                        <th data-label="تاریخ خرید">📅 خرید</th>
                        <th data-label="تاریخ انقضا">⏳ انقضا</th>
                        <th data-label="مدت زمان">🕒 مدت</th>
                        <th data-label="وضعیت">🔍 وضعیت</th>
                        <th data-label="عملیات">✨ عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.packages.Count() == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4">
                                <div class="empty-state">
                                    <i class="mdi mdi-package-variant-remove mdi-48px text-muted"></i>
                                    <h5 class="mt-3">پکیج فعالی وجود ندارد</h5>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var package in Model.packages)
                        {
                            <tr>
                                <td data-label="نام پکیج">@package.Title</td>
                                <td data-label="تعداد ایمیل">@package.AllowedSmsCount</td>
                                <td data-label="تعداد پیامک">@package.AllowedSmsCount</td>
                                <td data-label="قیمت">@package.Price.ToString("C")</td>
                                <td data-label="تاریخ خرید">@package.CreationDate.ConvertToPersianDateString()</td>
                                <td data-label="تاریخ انقضا">@package.ExpiryDate.ConvertToPersianDateString()</td>
                                <td data-label="مدت زمان">@package.ExpiryTime.ToString().Replace("_", " ")</td>
                                <td data-label="وضعیت">
                                    @if (package!.Active)
                                    {
                                        <span class="badge bg-success" style="padding: 0.6rem 1rem; border-radius: 1rem;">
                                            <i class="mdi mdi-check-circle-outline me-1"></i>
                                            فعال
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" style="padding: 0.6rem 1rem; border-radius: 1rem;">
                                            <i class="mdi mdi-close-circle-outline me-1"></i>
                                            غیرفعال
                                        </span>
                                    }
                                </td>
                                <td data-label="عملیات">
                                    <button class="action-btn view"
                                            onclick="ViewDetails('@Url.Page("UserPackages", "Details", new { id = package.UserPacakgeId })')">
                                        <i class="mdi mdi-information-outline"></i>
                                        جزئیات
                                    </button>
                                </td>
                            </tr>
                            <!-- Add this at the end of the page -->
                            <div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                    <div class="modal-content" style="border-radius: 2rem; background: var(--glass-effect); backdrop-filter: blur(10px);">
                                        <div class="modal-header" style="border-bottom: none;">
                                            <h5 class="modal-title" id="detailsModalLabel">📦 جزئیات پکیج</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="detail-item">
                                                        <span class="detail-icon">🏷️</span>
                                                        <div>
                                                            <small class="text-muted">نام پکیج</small>
                                                            <p class="detail-value" id="packageTitle"></p>
                                                        </div>
                                                    </div>
                                                    <div class="detail-item">
                                                        <span class="detail-icon">📧</span>
                                                        <div>
                                                            <small class="text-muted">تعداد ایمیل</small>
                                                            <p class="detail-value" id="packageEmails"></p>
                                                        </div>
                                                    </div>
                                                    <div class="detail-item">
                                                        <span class="detail-icon">💬</span>
                                                        <div>
                                                            <small class="text-muted">تعداد پیامک</small>
                                                            <p class="detail-value" id="packageSms"></p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="detail-item">
                                                        <span class="detail-icon">💰</span>
                                                        <div>
                                                            <small class="text-muted">قیمت</small>
                                                            <p class="detail-value" id="packagePrice"></p>
                                                        </div>
                                                    </div>
                                                    <div class="detail-item">
                                                        <span class="detail-icon">📅</span>
                                                        <div>
                                                            <small class="text-muted">تاریخ خرید</small>
                                                            <p class="detail-value" id="purchaseDate"></p>
                                                        </div>
                                                    </div>
                                                    <div class="detail-item">
                                                        <span class="detail-icon">⏳</span>
                                                        <div>
                                                            <small class="text-muted">تاریخ انقضا</small>
                                                            <p class="detail-value" id="expiryDate"></p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="modal-footer" style="border-top: none;">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // تابع نمایش جزئیات با انیمیشن
        async function ViewDetails(url) {
            await Swal.fire({
                title: 'در حال انتقال...',
                html: '<div class="spinner-border text-primary"></div>',
                showConfirmButton: false,
                backdrop: 'rgba(0,0,0,0.7)'
            });
            window.location.href = url;
        }

        // افزودن افکت hover به کارت
        document.querySelectorAll('.billing-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.setProperty('--mouse-x', `${x}px`);
                card.style.setProperty('--mouse-y', `${y}px`);
            });
        });
    </script>
    <script>
        // تابع نمایش جزئیات پکیج
        async function ViewDetails(url) {
            try {
                const response = await fetch(url);
                if (!response.ok) throw new Error('خطا در دریافت اطلاعات');

                const packageData = await response.json();

                // پر کردن داده‌ها در مودال
                document.getElementById('packageTitle').textContent = packageData.title;
                document.getElementById('packageEmails').textContent = packageData.allowedEmailCount;
                document.getElementById('packageSms').textContent = packageData.allowedSmsCount;
                document.getElementById('packagePrice').textContent = new Intl.NumberFormat('fa-IR', {
                    style: 'currency',
                    currency: 'IRR'
                }).format(packageData.price);

                document.getElementById('purchaseDate').textContent = new Date(packageData.creationDate).toLocaleDateString('fa-IR');
                document.getElementById('expiryDate').textContent = new Date(packageData.expiryDate).toLocaleDateString('fa-IR');

                // نمایش مودال
                const detailsModal = new bootstrap.Modal(document.getElementById('detailsModal'));
                detailsModal.show();

            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطا!',
                    text: error.message,
                    confirmButtonColor: '#FF6B6B'
                });
            }
        }
    </script>
}