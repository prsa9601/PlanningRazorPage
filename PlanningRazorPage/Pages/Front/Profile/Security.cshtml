</div>

@section Scripts {
    <script>
        // مدیریت قدرت رمز عبور
        function updateStrength(password) {
            let strength = 0;
            if (password.length >= 8) strength += 25;
            if (/[A-Z]/.test(password)) strength += 25;
            if (/[0-9]/.test(password)) strength += 25;
            if (/[^A-Za-z0-9]/.test(password)) strength += 25;

            document.documentElement.style.setProperty('--strength', `${strength}%`);
        }

        // انیمیشن سوئیچ
        document.getElementById('twoFactorSwitch').addEventListener('change', function() {
            if(this.checked) {
                this.parentElement.classList.add('switch-active');
            } else {
                this.parentElement.classList.remove('switch-active');
            }
        });

        // هاور روی ردیف‌های جدول
        document.querySelectorAll('.devices-table tr').forEach(row => {
            row.addEventListener('mouseenter', () => {
                row.style.transform = 'translateY(-2px)';
            });

            row.addEventListener('mouseleave', () => {
                row.style.transform = 'none';
            });
        });
    </script>
    <script>
        // مدیریت نمایش/مخفی کردن رمز عبور
        document.querySelectorAll('.form-password-toggle .input-group-text').forEach(icon => {
            icon.addEventListener('click', function() {
                const input = this.parentElement.querySelector('input');
                const isPassword = input.type === 'password';

                input.type = isPassword ? 'text' : 'password';
                this.querySelector('i').classList.toggle('mdi-eye-off-outline', isPassword);
                this.querySelector('i').classList.toggle('mdi-eye-outline', !isPassword);
            });
        });

        // مدیریت ارسال فرم
        document.querySelector('form').addEventListener('submit', async (e) => {
            e.preventDefault();

            // شبیه‌سازی ارسال درخواست
            await new Promise(resolve => setTimeout(resolve, 1000));

            Swal.fire({
                icon: 'success',
                title: 'رمز عبور با موفقیت تغییر یافت!',
                showConfirmButton: false,
                timer: 1500
            });
        });
    </script>
}