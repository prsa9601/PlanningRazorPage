                            data-bs-toggle="modal"
                            data-bs-target="#upgradePlanModal"
                          >
                            ارتقای پلن
                          </button>
                          <button
                            class="btn btn-outline-danger cancel-subscription"
                          >
                            لغو اشتراک
                          </button>
                        </div>
                      </div>
                    </div>
