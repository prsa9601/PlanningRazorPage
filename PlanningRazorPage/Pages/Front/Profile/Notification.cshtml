                <i class="mdi mdi-account-outline mdi-20px me-1"></i>حساب
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Security">
                <i class="mdi mdi-lock-open-outline mdi-20px me-1"></i>امنیت
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Billing">
                <i class="mdi mdi-bookmark-outline mdi-20px me-1"></i>صورتحساب و پلن‌ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" asp-page="Notification">
                <i class="mdi mdi-bell-outline mdi-20px me-1"></i>اعلان‌ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="RequestBox">
