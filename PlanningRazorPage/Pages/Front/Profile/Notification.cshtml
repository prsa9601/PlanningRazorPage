@page
@model NotificationModel
@{
    Layout = "Shared/_LayoutProfile";
}

@section Header {
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #6B8DD6 0%, #FFE66D 100%);
            --secondary-gradient: linear-gradient(135deg, #FF7E5F 0%, #FEB47B 100%);
            --glass-effect: rgba(255, 255, 255, 0.98);
            --shadow-effect: 0 12px 40px rgba(0, 0, 0, 0.08);
        }

        .notifications-container {
            background: var(--glass-effect);
            border-radius: 2rem;
            box-shadow: var(--shadow-effect);
            margin: 2rem;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .notifications-header {
            background: var(--primary-gradient);
            padding: 2rem;
            color: white;
            position: relative;
            overflow: hidden;
        }

            .notifications-header::after {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient(45deg, transparent, rgba(255,255,255,0.15), transparent);
                animation: shine 8s infinite;
                opacity: 0.3;
            }

        .notifications-table {
            --hover-bg: rgba(245, 245, 245, 0.9);
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 1rem;
            padding: 2rem;
        }

            .notifications-table th {
                color: #6B8DD6;
                font-weight: 600;
                padding: 1.5rem;
                background: rgba(245, 245, 245, 0.9);
                border-radius: 1rem;
            }

            .notifications-table td {
                padding: 1.5rem;
                background: white;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                border-radius: 0.8rem;
            }

                .notifications-table td:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 8px 25px rgba(107, 141, 214, 0.1);
                }

        .notification-type {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

            .notification-type i {
                font-size: 1.5rem;
                color: #6B8DD6;
            }

        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 48px;
            height: 24px;
        }

            .toggle-switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

            .toggle-switch .slider {
                position: absolute;
                cursor: pointer;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background-color: #ccc;
                transition: .4s;
                border-radius: 24px;
            }

                .toggle-switch .slider:before {
                    position: absolute;
                    content: "";
                    height: 20px;
                    width: 20px;
                    left: 2px;
                    bottom: 2px;
                    background-color: white;
                    transition: .4s;
                    border-radius: 50%;
                }

            .toggle-switch input:checked + .slider {
                background: var(--primary-gradient);
            }

                .toggle-switch input:checked + .slider:before {
                    transform: translateX(24px);
                }

        @@keyframes shine {
            100% {
                transform: translate(100%, 100%) rotate(45deg);
            }
        }

        @@media (max-width: 768px) {
            .notifications-container {
                margin: 1rem;
                border-radius: 1.2rem;
            }

            .notifications-table td {
                padding: 1rem;
            }
        }
    </style>
}
<div class="col-xl-8 col-lg-7 col-md-7 order-0 order-md-1">
    <!-- User Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link" asp-page="Acount">
                <i class="mdi mdi-account-outline mdi-20px me-1"></i>حساب
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Security">
                <i class="mdi mdi-lock-open-outline mdi-20px me-1"></i>امنیت
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Billing">
                <i class="mdi mdi-bookmark-outline mdi-20px me-1"></i>صورتحساب و پلن‌ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" asp-page="Notification">
                <i class="mdi mdi-bell-outline mdi-20px me-1"></i>اعلان‌ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="RequestBox">
                <i class="mdi mdi-bell-outline mdi-20px me-1"></i>‌درخواست ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Connections"><i class="mdi mdi-link mdi-20px me-1"></i>اتصالات</a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               asp-page="Friends">
                <i class="mdi mdi-account-supervisor-outline mdi-20px me-1"></i>‌دوستان
            </a>
        </li>
    </ul>
    <!--/ User Tabs -->
    <!-- Current Plan -->
    <div class="card mb-4">
<div class="notifications-container">
    <div class="notifications-header">
        <h3 class="mb-0">🔔 تنظیمات اعلان‌ها</h3>
    </div>

    <div class="notifications-table">
        <table class="w-100">
            <thead>
                <tr>
                    <th>نوع اعلان</th>
                    <th class="text-center">📧 ایمیل</th>
                    <th class="text-center">🖥 مرورگر</th>
                    <th class="text-center">📱 برنامه</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <div class="notification-type">
                            <i class="mdi mdi-bell-alert-outline"></i>
                            <span>اطلاعیه جدید</span>
                        </div>
                    </td>
                    <td class="text-center">
                        <label class="toggle-switch">
                            <input type="checkbox" checked>
                            <span class="slider"></span>
                        </label>
                    </td>
                    <td class="text-center">
                        <label class="toggle-switch">
                            <input type="checkbox" checked>
                            <span class="slider"></span>
                        </label>
                    </td>
                    <td class="text-center">
                        <label class="toggle-switch">
                            <input type="checkbox" checked>
                            <span class="slider"></span>
                        </label>
                    </td>
                </tr>
                <!-- Repeat for other rows -->
            </tbody>
        </table>
    </div>

    <div class="text-end p-4">
        <button class="btn btn-primary"
                style="background: var(--primary-gradient); border: none; padding: 0.8rem 2rem;">
            ذخیره تغییرات
        </button>
        <button class="btn btn-outline-secondary">
            بازنشانی
        </button>
    </div>
</div>
</div>
</div>

@section Scripts {
    <script>
        // مدیریت تغییر وضعیت سوییچ‌ها
        document.querySelectorAll('.toggle-switch input').forEach(switchInput => {
            switchInput.addEventListener('change', function() {
                const parentRow = this.closest('tr');
                if (this.checked) {
                    parentRow.style.background = 'rgba(107, 141, 214, 0.05)';
                } else {
                    parentRow.style.background = 'white';
                }
            });
        });

        // مدیریت ارسال فرم
        document.querySelector('button[type="submit"]').addEventListener('click', async () => {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-start',
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true,
            });

            Toast.fire({
                icon: 'success',
                title: 'تغییرات با موفقیت ذخیره شد!'
            });
        });
    </script>
}