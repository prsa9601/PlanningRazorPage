@page
@using PlanningRazorPage.Infrastructure.Utils
@model PlanningRazorPage.Pages.Front.Profile.NotificationModel
@{
    Layout = "Shared/_LayoutProfile";
}

@section Header {
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #6B8DD6 0%, #FFE66D 100%);
            --secondary-gradient: linear-gradient(135deg, #FF7E5F 0%, #FEB47B 100%);
            --success-color: #2ecc71;
            --danger-color: #e74c3c;
        }

        .notifications-card {
            background: rgba(255,255,255,0.95);
            border-radius: 1.5rem;
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            margin: 2rem;
        }

        .notifications-header {
            background: var(--primary-gradient);
            padding: 2rem;
            color: white;
            border-radius: 1.5rem 1.5rem 0 0;
        }

        .notifications-table {
            --hover-scale: 1.02;
            --hover-bg: rgba(245, 245, 245, 0.9);
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 1rem;
        }

            .notifications-table th {
                color: #6B8DD6;
                padding: 1.5rem;
                font-weight: 600;
            }

            .notifications-table td {
                padding: 1.5rem;
                background: white;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .notifications-table tr:hover td {
                transform: scale(var(--hover-scale));
                box-shadow: 0 4px 15px rgba(107, 141, 214, 0.2);
            }

        .notification-actions {
            display: flex;
            gap: 0.5rem;
            justify-content: flex-end;
        }

            .notification-actions .btn {
                padding: 0.75rem 1.25rem;
                border-radius: 2rem;
                border: none;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .notification-actions .btn-view {
                background: rgba(107, 141, 214, 0.1);
                color: #6B8DD6;
            }

            .notification-actions .btn-mark {
                background: var(--secondary-gradient);
                color: white !important;
                box-shadow: 0 4px 15px rgba(255, 126, 95, 0.3);
            }

            .notification-actions .btn-delete {
                background: var(--primary-gradient);
                color: white !important;
                box-shadow: 0 4px 15px rgba(107, 141, 214, 0.3);
            }

        .notification-status {
            padding: 0.25rem 0.75rem;
            border-radius: 1rem;
            font-size: 0.85rem;
        }

        .status-unread {
            background: rgba(255, 126, 95, 0.15);
            color: #FF7E5F;
        }

        .status-read {
            background: rgba(46, 204, 113, 0.15);
            color: #2ecc71;
        }

        @@media (max-width: 768px) {
            .notifications-card {
                margin: 1rem;
                border-radius: 1rem;
            }

            .notifications-table td {
                display: flex;
                flex-direction: column;
                align-items: start !important;
            }

                .notifications-table td::before {
                    content: attr(data-label);
                    font-weight: 600;
                    color: #6B8DD6;
                    margin-bottom: 0.5rem;
                }

            .notification-actions {
                flex-direction: column;
                width: 100%;
            }

                .notification-actions .btn {
                    width: 100%;
                    justify-content: center;
                }
        }
    </style>
}

<div class="col-xl-8 col-lg-7 col-md-7 order-0 order-md-1">
    <ul class="nav nav-tabs mb-3">
        <!-- سایر تب‌ها -->
       
        <li class="nav-item">
            <a class="nav-link" asp-page="Acount">
                <i class="mdi mdi-account-outline mdi-20px me-1"></i>حساب
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Security">
                <i class="mdi mdi-lock-open-outline mdi-20px me-1"></i>امنیت
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="UserPackages">
                <i class="mdi mdi-bookmark-outline mdi-20px me-1"></i>پکیج های فعال
            </a>
        </li>
     <li class="nav-item">
            <a class="nav-link active" asp-page="Notification">
                <i class="mdi mdi-bell-outline mdi-20px me-1"></i>اعلان‌ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="RequestBox">
                <i class="mdi mdi-bell-outline mdi-20px me-1"></i>‌درخواست ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Connections"><i class="mdi mdi-link mdi-20px me-1"></i>اتصالات</a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               asp-page="Friends">
                <i class="mdi mdi-account-supervisor-outline mdi-20px me-1"></i>‌دوستان
            </a>
        </li>
        <!-- سایر تب‌ها -->
    </ul>
    
    <div class="notifications-card">
        <div class="notifications-header">
            <h3 class="mb-0">🔔 اعلان‌های اخیر</h3>
        </div>

        <div class="px-4 pt-4">
            <div class="table-responsive">
                <table class="notifications-table">
                    <thead>
                        <tr>
                            <th>عنوان</th>
                            <th>وضعیت</th>
                            <th>تاریخ</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Notifications?.Data?.Any() == true)
                        {
                            foreach (var item in Model.Notifications.Data)
                            {
                                <tr>
                                    <td data-label="عنوان">@item.eventDto!.Title</td>
                                    <td data-label="وضعیت">
                                        <span class="notification-status @(item.IsSeen ? "status-read" : "status-unread")">
                                            @(item.IsSeen ? "خوانده شده" : "جدید")
                                        </span>
                                    </td>
                                    <td data-label="تاریخ">@item.CreationDate.ToPersianDate()</td>
                                    <td data-label="عملیات">
                                        <div class="notification-actions">
                                            <button class="btn btn-view"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#notificationModal"
                                                    data-title="@item.eventDto.Title"
                                                    @* data-description="@item.Description" *@
                                                    data-date="@item.CreationDate.ToPersianDateTime()">
                                                <i class="mdi mdi-eye-outline"></i>
                                                مشاهده
                                            </button>
                                            @if (!item.IsSeen)
                                            {
                                                <button class="btn btn-mark"
                                                        onclick="markAsRead('@item.Id')">
                                                    <i class="mdi mdi-check-all"></i>
                                                    علامت‌گذاری
                                                </button>
                                            }
                                            <button class="btn btn-delete"
                                                    onclick="deleteNotification('@item.Id')">
                                                <i class="mdi mdi-delete-outline"></i>
                                                حذف
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4">
                                    🎉 هیچ اعلان جدیدی وجود ندارد!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Notification Detail Modal -->
    <div class="modal fade" id="notificationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalNotificationTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted">توضیحات:</label>
                        <p class="modal-notification-description"></p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted">تاریخ ارسال:</label>
                        <p class="modal-notification-date"></p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // مدیریت نمایش مدال
        document.querySelectorAll('.btn-view').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('modalNotificationTitle').textContent = btn.dataset.title;
                document.querySelector('.modal-notification-description').textContent = btn.dataset.description;
                document.querySelector('.modal-notification-date').textContent = btn.dataset.date;
            });
        });

        // علامت‌گذاری به عنوان خوانده شده
        async function markAsRead(notificationId) {
            const { isConfirmed } = await Swal.fire({
                title: 'تغییر وضعیت اعلان',
                html: `آیا از علامت‌گذاری این اعلان به عنوان خوانده شده اطمینان دارید؟`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#6B8DD6',
                cancelButtonColor: '#FF7E5F',
                confirmButtonText: 'تایید',
                cancelButtonText: 'انصراف'
            });

            if (isConfirmed) {
                try {
                    const response = await fetch(`Notification?handler=MarkAsRead&id=${notificationId}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const result = await response.json();

                    if (result.success) {
                        showToast('success', result.message);
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showToast('error', result.message);
                    }
                } catch (error) {
                    console.error('خطا در انجام عملیات:', error);
                    showToast('error', 'خطا در ارتباط با سرور');
                }
            }
        }

        // حذف اعلان
        async function deleteNotification(notificationId) {
            const { isConfirmed } = await Swal.fire({
                title: 'حذف اعلان',
                html: `آیا از حذف این اعلان اطمینان دارید؟`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#FF7E5F',
                cancelButtonColor: '#6B8DD6',
                confirmButtonText: 'حذف',
                cancelButtonText: 'انصراف'
            });

            if (isConfirmed) {
                try {
                    const response = await fetch(`Notification?handler=Delete&id=${notificationId}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const result = await response.json();

                    if (result.success) {
                        showToast('success', result.message);
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showToast('error', result.message);
                    }
                } catch (error) {
                    console.error('خطا در انجام عملیات:', error);
                    showToast('error', 'خطا در ارتباط با سرور');
                }
            }
        }

        // تابع نمایش نوتیفیکیشن (مشابه کد قبلی)
    </script>
}