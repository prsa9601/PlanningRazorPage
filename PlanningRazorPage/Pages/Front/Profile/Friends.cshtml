    <form method="get">
        <div class="card mb-4">
            <div class="table-responsive mb-3">
                <div id="DataTables_Table_0_wrapper" class="dataTables_wrapper dt-bootstrap5 no-footer">

                    <div class="row mx-4">

                        <div class="col-sm-6 col-12 d-flex align-items-center justify-content-center justify-content-sm-start mb-3 mb-md-0">
                            <div class="col-6 flex-grow-1 input-group input-group-merge rounded-pill" len="282">
                                <button type="submit" class="btn btn-outline-secondary waves-effect"><i class="mdi mdi-magnify lh-1" len="0"></i></button>

                                <input id="q" style="margin-right:10px;" type="text" asp-for="FilterParams.UserName" id="search" class="form-control chat-search-input" placeholder="   جست و جو..." aria-label="  Search..." aria-describedby="basic-addon-search31" len="0">
                            </div>
                            <div style="float: left; margin-right: 160px; margin-top :5px;" class="col-6 dataTables_length" id="DataTables_Table_0_length">
                                <label>
                                    <select  aria-controls="DataTables_Table_0" class="form-select form-select-sm" style="float: left;"><option value="10">10</option><option value="25">25</option><option value="50">50</option><option value="100">100</option></select>
                                </label>

                            </div>
                        </div>
                        <div class="col-sm-6 col-12 d-flex align-items-center justify-content-center justify-content-sm-end">
                            <div class="dt-buttons btn-group flex-wrap">
                                <div class="btn-group"><button class="btn btn-secondary buttons-collection dropdown-toggle btn-label-primary float-sm-end mb-3 mb-sm-0" tabindex="0" aria-controls="DataTables_Table_0" type="button" aria-haspopup="dialog" aria-expanded="false"><span><i class="mdi mdi-export-variant me-1"></i>برون بری</span><span class="dt-down-arrow"></span></button></div>
                            </div>
                        </div>
                    </div><table class="table datatable-invoice dataTable no-footer dtr-column" id="DataTables_Table_0" aria-describedby="DataTables_Table_0_info" style="width: 802px;">
                        <thead class="table-light">

                            <tr>
                                <th class="control sorting dtr-hidden" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 0px; display: none;" aria-label=": activate to sort column ascending"></th>
                                <th class="sorting sorting_desc" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 105px;" aria-label="شناسه: activate to sort column ascending" aria-sort="descending">شناسه</th>
                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 79px;" aria-label=": activate to sort column ascending"><i class="mdi mdi-trending-up"></i></th>
                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 102px;" aria-label="مجموع: activate to sort column ascending"></th>
                                <th style="width:140px;" class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 102px;" aria-label="مجموع: activate to sort column ascending"></th>
                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 143px;" aria-label="تاریخ صدرو: activate to sort column ascending"></th>
                                <th class="sorting_disabled" rowspan="1" colspan="1" style="width: 173px;" aria-label="Actions">Actions</th>
                            </tr>

                        </thead>
                        <tbody id="searchResult">

                            @{
                                // if (Model.Friends.EntityCount > 0)
                                // {
                                if (Model.Friends.EntityCount == 0)
                                {
                                    <tr class="odd">
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td>
                                            دوستی یافت نشد.
                                        </td>
                                        <td></td>
                                        <td></td>

                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in @Model.Friends.Data)
                                    {
                                        <tr class="odd">
                                            <td><img style="width:80px; height:75px;" src="@Directories.GetAvatar(item.avatar)" /></td>
                                            <td id="userNameReceiver">@item.FriendUserName</td>
                                            <td>
                                            </td>
                                            <td>
                                            </td>
                                            <td>
                                            </td>
                                            @if (item.IsFriend)
                                            {
                                                // <td>
                                                //     <button type="button" class="btn rounded-pill btn-icon btn-outline-primary waves-effect">
                                                //         <span class="tf-icons mdi mdi-checkbox-marked-circle-outline"></span>
                                                //     </button>
                                                // </td>

                                                <td style="width:30px; height:30px;">
                                                    <button type="button" onclick="AddFriend()" class="btn rounded-pill btn-icon btn-secondary waves-effect waves-light">

                                                        <span class="mdi mdi-account-multiple-minus-outline"></span>

                                                    </button>
                                                </td>
                                            }  
                                            @if (item.IsSendRequest)
                                            {
                                                // <td>
                                                //     <button type="button" class="btn rounded-pill btn-icon btn-outline-primary waves-effect">
                                                //         <span class="tf-icons mdi mdi-checkbox-marked-circle-outline"></span>
                                                //     </button>
                                                // </td>

                                                <td style="width:30px; height:30px; margin-left:20px; left">
                                                    @*<button type="button" class="btn rounded-pill btn-icon btn-primary waves-effect waves-light">*@
                                                        <button disabled="true" type="button" class="btn rounded-pill btn-icon btn-secondary waves-effect waves-light">

                                                            <span class="mdi mdi-account-multiple-plus-outline"></span>

                                                        </button>
                                                </td>
                                            }  
                                          
                                            else
                                            {
                                                      <td style="width:30px; height:30px; margin-left:20px; left">
                                                              @*<button type="button" class="btn rounded-pill btn-icon btn-primary waves-effect waves-light">*@
                                                          <add-Request url="@Url.Page("AddRequest", "AddRequest", new{ FriendUserName = @item.FriendUserName})" description="آیا از این عملیات مطمئن هستید؟">
                                                              <button type="button" class="btn rounded-pill btn-icon btn-secondary waves-effect waves-light">

                                                                  <span class="mdi mdi-account-multiple-plus-outline"></span>

                                                               </button>
                                                          </add-Request>
                                                      </td>



                                            }


                </tr>
                                    }

                                }


                            }

    </tbody>
    </table>
    <div class="row mx-4">

        <div class="col-md-12 col-lg-6 text-center text-lg-start pb-md-2 pb-lg-0">
            <div class="dataTables_info" id="DataTables_Table_0_info" role="status" aria-live="polite">نمایش 1 از 10 از 50 رکورد</div>
        </div>
        <div class="col-md-12 col-lg-6 d-flex justify-content-center justify-content-lg-end">
            <div class="dataTables_paginate paging_simple_numbers" id="DataTables_Table_0_paginate">
                <ul class="pagination">
                    
                    @{
                        int i = 1;
                        @if ( i <= @Model.FilterParams.PageId && @Model.Friends.EntityCount != 0)
                        {

                            @if (@Model.Friends.CurrentPage == @Model.Friends.StartPage)
                            {
                                int n = @Model.Friends.CurrentPage - 1;

                                <li class="paginate_button page-item previous disabled" id="DataTables_Table_0_previous">
                                    <a onclick="ChangePage(@n);" aria-controls="DataTables_Table_0" data-dt-idx="previous" tabindex="0" class="page-link">قبلی</a>
                                </li>
                            }
                            else
                            { 
                                int n = @Model.Friends.CurrentPage - 1;

                                <li class="paginate_button page-item previous " id="DataTables_Table_0_previous">
                                    <a onclick="ChangePage(@n);" aria-controls="DataTables_Table_0" data-dt-idx="previous" tabindex="0" class="page-link">قبلی</a>
                                </li>
                            }
                        
                            
                            @if (i - 1 > @Model.Friends.StartPage || i - 2 > @Model.Friends.StartPage)
                            {
                                int n = @Model.Friends.CurrentPage - 2; 

                                <li class="paginate_button page-item">
                                    <a onclick="ChangePage(@n);" onclick="@i-=2;" asp-for="@Model.Friends.FilterParams.PageId" aria-controls="DataTables_Table_0" data-dt-idx="0" tabindex="0" class="page-link"> @n</a>
                                </li>
                            }
                            @if (@Model.Friends.CurrentPage > @Model.Friends.StartPage || i - 1 >@Model.Friends.StartPage)
                            { 
                                 int n = @Model.Friends.CurrentPage - 1; 
                                 
                                 <li class="paginate_button page-item">
                                     <a onclick="ChangePage(@n);" onclick="@i-=1;" asp-for="@Model.Friends.FilterParams.PageId" aria-controls="DataTables_Table_0" data-dt-idx="0" tabindex="0" class="page-link">@n</a>
                                 </li>
                            }
                          
                            <li class="paginate_button page-item active">
                                <a onclick="ChangePage(@i);" asp-for="@Model.Friends.FilterParams.PageId" aria-controls="DataTables_Table_0" data-dt-idx="0" tabindex="0" class="page-link">@i</a>
                            </li>
                            // @if (i + 1 < @Model.Friends.EndPage)
                            // { 
                            //     int n = @Model.Friends.CurrentPage + 1; 

                            //     <li class="paginate_button page-item">
                            //         <a href="#" onclick="@i+=1;" asp-for="@Model.Friends.FilterParams.PageId" aria-controls="DataTables_Table_0" data-dt-idx="0" tabindex="0" class="page-link">@n</a>
                            //     </li>
                            // }
                            @if (@Model.Friends.CurrentPage + 1 <= @Model.Friends.EndPage)
                            { 
                                int n = @Model.Friends.CurrentPage + 1; 

                                <li class="paginate_button page-item">
                                    <a onclick="ChangePage(@n);" asp-for="@Model.FilterParams.PageId" aria-controls="DataTables_Table_0" data-dt-idx="0" tabindex="0" class="page-link">@n</a>
                                </li>
                            }
                            @if (i + 2 <= @Model.Friends.EndPage)
                            { 
                                int n = @Model.Friends.CurrentPage + 2; 

                                <li class="paginate_button page-item">
                                    <a onclick="ChangePage(@n);" onclick="@i+=2;" asp-for="@Model.Friends.FilterParams.PageId" aria-controls="DataTables_Table_0" data-dt-idx="0" tabindex="0" class="page-link">@n</a>
                                </li>
                            }
                            // @if (@Model.Friends.EndPage != @Model.Friends.StartPage)
                            // {
                            //     int n = @Model.Friends.CurrentPage + 1;

                            //     <li class="paginate_button page-item">
                            //         <a href="&pageId=@n" onclick="@i+=1;" asp-for="@Model.Friends.EndPage" aria-controls="DataTables_Table_0" data-dt-idx="0" tabindex="0" class="page-link">@Model.Friends.EndPage </a>
                            //     </li>
                            // }

                            if (@Model.Friends.CurrentPage == @Model.Friends.EndPage)
                            {
                                int n = @Model.Friends.CurrentPage + 1;

                                <li class="paginate_button page-item next disabled" id="DataTables_Table_0_next">
                                    <a onclick="ChangePage(@n);" aria-controls="DataTables_Table_0" data-dt-idx="next" tabindex="0" class="page-link">بعدی</a>
                                </li>
                            }
                            else
                            { 
                                int n = @Model.Friends.CurrentPage + 1;

                                <li class="paginate_button page-item next" id="DataTables_Table_0_next">
                                    <a onclick="ChangePage(@n);" aria-controls="DataTables_Table_0" data-dt-idx="next" tabindex="0" class="page-link">بعدی</a>
                                </li>
                            }
                          
                         
                        }
                     }
                 
                  
                </ul>
            </div>
        </div>
    </div>

</div>
            </div>
        </div>
    </form>

