@page "{handler?}"
@using PlanningRazorPage.Infrastructure
@using PlanningRazorPage.Models.Friend
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using PlanningRazorPage.Services.Friend
@using System.Text
@using Microsoft.CodeAnalysis.CSharp.Syntax
@inject IFriendService _service;
@model FriendsModel
@{
    Layout = "Shared/_LayoutProfile";
}

@section Header {
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #FF6B6B 0%, #FFE66D 100%);
            --secondary-gradient: linear-gradient(135deg, #4ECDC4 0%, #45B7AF 100%);
            --glass-effect: linear-gradient(145deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05));
            --neon-shadow: 0 0 20px rgba(255,107,107,0.3);
            --success-color: #2ecc71;
            --danger-color: #e74c3c;
        }

        .friend-action-btn.cancel {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white !important;
            box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
        }

            .friend-action-btn.cancel:hover {
                box-shadow: 0 8px 25px rgba(231, 76, 60, 0.4);
            }
        .friends-management-card {
            border-radius: 2rem;
            background: rgba(255,255,255,0.95);
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            margin: 2rem;
            overflow: hidden;
            border: 2px solid #FF6B6B;
        }

        .table-header-custom {
            background: var(--primary-gradient);
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

        .friends-table {
            --hover-scale: 1.02;
            --hover-bg: rgba(255,235,235,0.9);
            width: 100%;
            border-collapse: collapse;
        }

            .friends-table tr {
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                background: rgba(255,255,255,0.9);
            }

                .friends-table tr:hover {
                    transform: scale(var(--hover-scale));
                    background: var(--hover-bg);
                    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
                }

        .friend-avatar {
            width: 72px;
            height: 72px;
            border: 3px solid #fff;
            box-shadow: var(--neon-shadow);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .friend-avatar:hover {
                transform: rotate(15deg) scale(1.1);
                filter: hue-rotate(45deg);
            }

        .friend-action-btn {
            padding: 0.8rem 1.5rem;
            border-radius: 1.5rem;
            border: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .friend-action-btn.add {
                background: var(--secondary-gradient);
                color: white !important;
                box-shadow: 0 4px 15px rgba(78, 205, 196, 0.3);
            }

            .friend-action-btn.remove {
                background: var(--primary-gradient);
                color: white !important;
                box-shadow: 0 4px 15px rgba(255, 107, 107, 0.3);
            }

        .search-box {
            background: var(--glass-effect);
            backdrop-filter: blur(10px);
            border-radius: 2rem;
            padding: 1rem 2rem;
            margin: 1rem;
        }

        @@media (max-width: 768px) {
            .friends-management-card {
                margin: 1rem;
                border-radius: 1.5rem;
            }

            .friends-table td::before  {
                content: attr(data-label);
                font-weight: bold;
                color: #FF6B6B;
            }


            .action-buttons .d-flex {
                flex-direction: column;
                gap: 0.5rem;
            }

            .friend-action-btn {
            width: 100%;
            justify-content: center;
        }
        }
       
       
    </style>
   
}
<div class="col-xl-8 col-lg-7 col-md-7 order-0 order-md-1">
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link" asp-page="Account">
                <i class="mdi mdi-account-outline mdi-20px me-1"></i>حساب
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Security">
                <i class="mdi mdi-lock-open-outline mdi-20px me-1"></i>امنیت
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="UserPackages">
                <i class="mdi mdi-bookmark-outline mdi-20px me-1"></i>پکیج های فعال
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               asp-page="Notification">
                <i class="mdi mdi-bell-outline mdi-20px me-1"></i>اعلان‌ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="RequestBox">
                <i class="mdi mdi-bell-outline mdi-20px me-1"></i>‌درخواست ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Connections"><i class="mdi mdi-link mdi-20px me-1"></i>اتصالات</a>
        </li>
        <li class="nav-item">
            <a class="nav-link active"
               asp-page="Friends">
                <i class="mdi mdi-account-supervisor-outline mdi-20px me-1"></i>‌دوستان
            </a>
        </li>
    </ul>
    <div class="friends-management-card">
        <div class="table-header-custom">
            <h5 class="table-title mb-0">
                👥 مدیریت دوستان
            </h5>
        </div>

        <form method="get" class="search-box">
            <div class="input-group input-group-merge rounded-pill">
                <input id="q" type="text" asp-for="FilterParams.UserName"
                       class="form-control"
                       placeholder="جستجوی دوستان..."
                       style="background: rgba(255,255,255,0.9)">
                <button type="submit" class="btn btn-primary rounded-pill">
                    <i class="mdi mdi-magnify"></i>
                </button>
            </div>
        </form>

        <div class="table-responsive-xxl p-4">
            <table class="table friends-table align-middle">
                <thead>
                    <tr>
                        <th data-label="آواتار">🖼️ آواتار</th>
                        <th data-label="نام کاربری">👤 نام کاربری</th>
                        <th data-label="وضعیت">🔍 وضعیت</th>
                        <th data-label="عملیات">✨ عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Friends.EntityCount == 0)
                    {
                        <tr>
                            <td></td>
                            <td></td>
                            <td>کاربری یافت نشد</td>
                            <td></td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Friends!.Data!)
                        {
                            <tr>
                                <td data-label="آواتار">
                                    <img src="@Directories.GetAvatar(item.avatar)"
                                         class="friend-avatar"
                                         alt="آواتار دوست">
                                </td>
                                <td data-label="نام کاربری" class="fw-bold">@item.FriendUserName</td>
                                <td data-label="وضعیت">
                                    @if (item.IsFriend)
                                    {
                                        <span class="badge bg-success">✅ دوست شما</span>
                                    }
                                    else if (item.IsSendRequest)
                                    {
                                        <span class="badge bg-warning">⏳ در انتظار پاسخ</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">🔍 یافت شده</span>
                                    }
                                </td>
                                <td data-label="عملیات">
                                    <div class="action-buttons">
                                        @if (item.IsFriend)
                                        {
                                            <button class="friend-action-btn remove"
                                                    onclick="RemoveFriend('@Url.Page("SetFriend", "RemoveFriend", new { FriendUserName = @item.FriendUserName })', '@item.FriendUserName')">
                                                <i class="mdi mdi-account-minus"></i>
                                                حذف دوست
                                            </button>
                                        }
                                        else if (item.IsSendRequest)
                                        {
                                            <div class="d-flex gap-2">
                                                <button class="friend-action-btn cancel"
                                                        onclick="CancelRequest('@Url.Page("AddRequest", "RemoveRequestForSender", new{ FriendUserName = @item.FriendUserName})', '@item.FriendUserName')">
                                                    <i class="mdi mdi-close-circle"></i>
                                                    لغو درخواست
                                                </button>
                                                <button class="friend-action-btn" disabled>
                                                    <i class="mdi mdi-clock-outline"></i>
                                                    در انتظار تایید
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <button class="friend-action-btn add"
                                                    onclick="AddFriend('@Url.Page("AddRequest", "AddRequest", new { FriendUserName = @item.FriendUserName })', '@item.FriendUserName')">
                                                <i class="mdi mdi-account-plus"></i>
                                                افزودن دوست
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mt-4">
                @if (Model.Friends.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-route-pageId="@(Model.Friends.CurrentPage - 1)"
                           asp-route-userName="@Model.FilterParams.UserName">
                            قبلی
                        </a>
                    </li>
                }

                @for (int i = 1; i <= Model.Friends.PageCount; i++)
                {
                    <li class="page-item @(i == Model.Friends.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-route-pageId="@i"
                           asp-route-userName="@Model.FilterParams.UserName">@i</a>
                    </li>
                }

                @if (Model.Friends.CurrentPage < Model.Friends.PageCount)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-route-pageId="@(Model.Friends.CurrentPage + 1)"
                           asp-route-userName="@Model.FilterParams.UserName">
                            بعدی
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

 @section Scripts {
    <script>
        // تابع مدیریت افزودن دوست
        async function AddFriend(url, userName) {
            const { isConfirmed } = await Swal.fire({
                title: 'افزودن دوست',
                html: `آیا مایل به افزودن <b>${userName}</b> به لیست دوستان هستید؟`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#4ECDC4',
                cancelButtonColor: '#FF6B6B',
                confirmButtonText: 'تایید',
                cancelButtonText: 'انصراف'
            });

            if (isConfirmed) {
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    if (response.ok) {
                        location.reload();
                    }
                } catch (error) {
                    console.error('خطا در افزودن دوست:', error);
                }
            }
        }

        // تابع مدیریت حذف دوست
        async function RemoveFriend(url, userName) {
            const { isConfirmed } = await Swal.fire({
                title: 'حذف دوست',
                html: `آیا از حذف <b>${userName}</b> از لیست دوستان اطمینان دارید؟`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#FF6B6B',
                cancelButtonColor: '#4ECDC4',
                confirmButtonText: 'حذف',
                cancelButtonText: 'انصراف'
            });

            if (isConfirmed) {
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    if (response.ok) {
                        location.reload();
                    }
                } catch (error) {
                    console.error('خطا در حذف دوست:', error);
                }
            }
        }
        // تابع مدیریت لغو درخواست
async function CancelRequest(url, userName) {
    const { isConfirmed } = await Swal.fire({
        title: 'لغو درخواست',
        html: `آیا از لغو درخواست برای <b>${userName}</b> اطمینان دارید؟`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#e74c3c',
        cancelButtonColor: '#4ECDC4',
        confirmButtonText: 'لغو درخواست',
        cancelButtonText: 'انصراف'
    });

    if (isConfirmed) {
        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            });

            if (response.ok) {
                location.reload();
            }
        } catch (error) {
            console.error('خطا در لغو درخواست:', error);
        }
    }
        }
    </script>

}
