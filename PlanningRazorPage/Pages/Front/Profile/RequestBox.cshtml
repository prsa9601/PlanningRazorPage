                                                    <!-- Modal -->
                                                    <div class="modal fade"
                                                         id="modalCenter"
                                                         tabindex="-1"
                                                         aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered"
                                                             role="document">
                                                            <div class="modal-content">
