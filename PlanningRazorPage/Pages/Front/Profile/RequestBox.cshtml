@page "{handler?}"
@using PlanningRazorPage.Models.Request
@model PlanningRazorPage.Pages.Front.Profile.RequestBoxModel
@{
    Layout = "Shared/_LayoutProfile";
}

@section Header {
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #6B8DD6 0%, #FFE66D 100%);
            --secondary-gradient: linear-gradient(135deg, #FF7E5F 0%, #FEB47B 100%);
            --success-color: #2ecc71;
            --danger-color: #e74c3c;
        }

        .requests-card {
            background: rgba(255,255,255,0.95);
            border-radius: 1.5rem;
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            margin: 2rem;
        }

        .requests-header {
            background: var(--primary-gradient);
            padding: 2rem;
            color: white;
            border-radius: 1.5rem 1.5rem 0 0;
        }

        .requests-table {
            --hover-scale: 1.02;
            --hover-bg: rgba(245, 245, 245, 0.9);
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 1rem;
        }

            .requests-table th {
                color: #6B8DD6;
                padding: 1.5rem;
                font-weight: 600;
            }

            .requests-table td {
                padding: 1.5rem;
                background: white;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .requests-table tr:hover td {
                transform: scale(var(--hover-scale));
                box-shadow: 0 4px 15px rgba(107, 141, 214, 0.2);
            }

        .request-actions {
            display: flex;
            gap: 0.5rem;
            justify-content: flex-end;
        }

            .request-actions .btn {
                padding: 0.75rem 1.25rem;
                border-radius: 2rem;
                border: none;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .request-actions .btn-view {
                background: rgba(107, 141, 214, 0.1);
                color: #6B8DD6;
            }

            .request-actions .btn-accept {
                background: var(--primary-gradient);
                color: white !important;
                box-shadow: 0 4px 15px rgba(107, 141, 214, 0.3);
            }

            .request-actions .btn-reject {
                background: var(--secondary-gradient);
                color: white !important;
                box-shadow: 0 4px 15px rgba(255, 126, 95, 0.3);
            }

        @@media (max-width: 768px) {
            .requests-card {
                margin: 1rem;
                border-radius: 1rem;
            }

            .requests-table td {
                display: flex;
                flex-direction: column;
                align-items: start !important;
            }

                .requests-table td::before {
                    content: attr(data-label);
                    font-weight: 600;
                    color: #6B8DD6;
                    margin-bottom: 0.5rem;
                }

            .request-actions {
                flex-direction: column;
                width: 100%;
            }

                .request-actions .btn {
                    width: 100%;
                    justify-content: center;
                }
        }
    </style>
}

<div class="col-xl-8 col-lg-7 col-md-7 order-0 order-md-1">
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link" asp-page="Account">
                <i class="mdi mdi-account-outline mdi-20px me-1"></i>حساب
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Security">
                <i class="mdi mdi-lock-open-outline mdi-20px me-1"></i>امنیت
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="UserPackages">
                <i class="mdi mdi-bookmark-outline mdi-20px me-1"></i>پکیج های فعال
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               asp-page="Notification">
                <i class="mdi mdi-bell-outline mdi-20px me-1"></i>اعلان‌ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" asp-page="RequestBox">
                <i class="mdi mdi-bell-outline mdi-20px me-1"></i>‌درخواست ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Connections"><i class="mdi mdi-link mdi-20px me-1"></i>اتصالات</a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               asp-page="Friends">
                <i class="mdi mdi-account-supervisor-outline mdi-20px me-1"></i>‌دوستان
            </a>
        </li>
    </ul>
    <div class="requests-card">
        <div class="requests-header">
            <h3 class="mb-0">📨 درخواست های دریافت شده</h3>
        </div>

        <div class="px-4 pt-4">
            <div class="table-responsive">
                <table class="requests-table">
                    <thead>
                        <tr>
                            <th>ارسال کننده</th>
                            <th>گیرنده</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.requestBox?.Data?.Any() == true)
                        {
                            foreach (var item in Model.requestBox.Data)
                            {
                                <tr>
                                    <td data-label="ارسال کننده">@item.UserNameSender</td>
                                    <td data-label="گیرنده">@item.UserNameReceived</td>
                                    <td data-label="عملیات">
                                        <div class="request-actions">
                                            <button class="btn btn-view"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#requestModal"
                                                    data-title="@item.Title"
                                                    data-description="@item.Description"
                                                    data-sender="@item.UserNameSender">
                                                <i class="mdi mdi-eye-outline"></i>
                                                مشاهده
                                            </button>
                                            <button class="btn btn-accept"
                                                    onclick="handleRequest('AddFriend', '@item.UserNameSender')">
                                                <i class="mdi mdi-check-circle-outline"></i>
                                                قبول
                                            </button>
                                            <button class="btn btn-reject"
                                                    onclick="handleRequest('RemoveRequest', '@item.UserNameSender')">
                                                <i class="mdi mdi-close-circle-outline"></i>
                                                رد
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4">
                                    🎉 هیچ درخواست جدیدی وجود ندارد!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>


<!-- Request Detail Modal -->
<div class="modal fade" id="requestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-muted">توضیحات:</label>
                    <p class="modal-description"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script>
        // مدیریت نمایش مدال
        document.querySelectorAll('.btn-view').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('modalTitle').textContent = btn.dataset.title;
                document.querySelector('.modal-description').textContent = btn.dataset.description;
            });
        });

        // مدیریت عملیات درخواست
        async function handleRequest(action, sender) {
            const actionText = action === 'AddFriend' ? 'پذیرش' : 'رد';
            const { isConfirmed } = await Swal.fire({
                title: `${actionText} درخواست`,
                html: `آیا از ${actionText} درخواست <b>${sender}</b> اطمینان دارید؟`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#6B8DD6',
                cancelButtonColor: '#FF7E5F',
                confirmButtonText: actionText,
                cancelButtonText: 'انصراف'
            });

            if (isConfirmed) {
                try {
                    const response = await fetch(`SetFriend?handler=${action}&FriendUserName=${sender}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    location.reload();
                    // const result = await JSON.parse(response);
                    // // const result = await response.json();

                    // if (result.success) {
                    //     showToast('success', result.message);
                    //     setTimeout(() => window.reload(), 1500);
                    // } else {
                    //     showToast('error', result.message);
                    // }
                } catch (error) {
                    console.error('خطا در انجام عملیات:', error);
                    showToast('error', 'خطا در ارتباط با سرور');
                }
            }
        }

        // // نمایش نوتیفیکیشن
        function showToast(type, message) {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-start',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
            });

            Toast.fire({
                icon: type,
                title: message
            });
        }
    </script>
}
