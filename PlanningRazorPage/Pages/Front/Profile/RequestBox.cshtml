@page
@using PlanningRazorPage.Models.Request
@model PlanningRazorPage.Pages.Front.Profile.RequestBoxModel
@{
}

@{
    Layout = "Shared/_LayoutProfile";
}
@section Header {
    <link rel="icon"
          type="image/x-icon"
          href="~/assets/img/favicon/favicon.ico" />

    <link rel="stylesheet"
          href="~/assets/vendor/css/pages/page-user-view.css" />
    <!-- Helpers -->
}
<div class="col-xl-8 col-lg-7 col-md-7 order-0 order-md-1">
    <!-- User Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link" asp-page="Acount">
                <i class="mdi mdi-account-outline mdi-20px me-1"></i>حساب
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Security">
                <i class="mdi mdi-lock-open-outline mdi-20px me-1"></i>امنیت
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Billing">
                <i class="mdi mdi-bookmark-outline mdi-20px me-1"></i>صورتحساب و پلن‌ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Notification">
                <i class="mdi mdi-bell-outline mdi-20px me-1"></i>اعلان‌ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" asp-page="RequestBox">
                <i class="mdi mdi-bell-outline mdi-20px me-1"></i>‌درخواست ها
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-page="Connections"><i class="mdi mdi-link mdi-20px me-1"></i>اتصالات</a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               asp-page="Friends">
                <i class="mdi mdi-account-supervisor-outline mdi-20px me-1"></i>‌دوستان
            </a>
        </li>
    </ul>
    <!--/ User Tabs -->
    <!-- Current Plan -->
    <div class="card mb-4">
        <!-- Notifications -->
        <h5 class="card-header border-bottom">ریکوئست های ارسالی به شما</h5>
        <div class="card-body py-3">
            <span class="text-heading fw-semibold">در صورت تغییر تنظیمات اعلان، کاربر به‌روزرسانی خواهد شد</span>
        </div>
        <div class="table-responsive">
            <table class="table border-top">
                <thead class="table-light">
                    <tr>
                        @if (Model.requestBox != null)
                        {
                            <th class="text-nowrap">نوع</th>
                            <th class="text-nowrap text-center">✉️ ایمیل</th>
                            <th class="text-nowrap text-center">🖥 مرورگر</th>
                        }
                        else
                        {
                            <th class="text-nowrap"></th>
                            <th class="text-nowrap text-center"></th>
                            <th class="text-nowrap text-center"></th>
                            <th class="text-nowrap text-center"></th>
                            <th class="text-nowrap text-center"></th>
                        }

                    </tr>
                </thead>
                <tbody>
                    @{
                        @if (Model.requestBox != null)
                        {
                            foreach (var item in @Model.requestBox.Data)
                            {
                                <tr>
                                    <td class="text-nowrap">@item.UserNameSender</td>

                                    <td>
                                        <div class="form-check d-flex justify-content-center">
                                            <p>@item.UserNameReceived</p>
                                        </div>
                                    </td>

                                    <td class="col-3" style="">
                                        <div>

                                            <a style="color:cornflowerblue; cursor:pointer;" data-bs-toggle="modal" data-bs-target="#modalCenter" class="col-1" style="margin-right:40px;" @*asp-page="Detail" asp-route-id="@item.Id"*@>
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                            </a>

                                            @*<a class="col-1" asp-route-id="@item.Id" asp-page="Edit">
                                            <svg width="24" height="24" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                                                <path d="M410.3 231l11.3-11.3-33.9-33.9-62.1-62.1L291.7 89.8l-11.3 11.3-22.6 22.6L58.6 322.9c-10.4 10.4-18 23.3-22.2 37.4L1 480.7c-2.5 8.4-.2 17.5 6.1 23.7s15.3 8.5 23.7 6.1l120.3-35.4c14.1-4.2 27-11.8 37.4-22.2L387.7 253.7 410.3 231zM160 399.4l-9.1 22.7c-4 3.1-8.5 5.4-13.3 6.9L59.4 452l23-78.1c1.4-4.9 3.8-9.4 6.9-13.3l22.7-9.1v32c0 8.8 7.2 16 16 16h32zM362.7 18.7L348.3 33.2 325.7 55.8 314.3 67.1l33.9 33.9 62.1 62.1 33.9 33.9 11.3-11.3 22.6-22.6 14.5-14.5c25-25 25-65.5 0-90.5L453.3 18.7c-25-25-65.5-25-90.5 0zm-47.4 168l-144 144c-6.2 6.2-16.4 6.2-22.6 0s-6.2-16.4 0-22.6l144-144c6.2-6.2 16.4-6.2 22.6 0s6.2 16.4 0 22.6z" />
                                            </svg>
                                        </a>*@


                                            <delete-item style="color:cornflowerblue; cursor:pointer;" class="col-1" Url="@Url.Page("SetFriend" ,"RemoveRequest", new { friendUserName = item.UserNameSender  })" description="">

                                                <svg xmlns="http:www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M6 7H5v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7zm4 12H8v-9h2zm6 0h-2v-9h2zm.618-15L15 2H9L7.382 4H3v2h18V4z" /></svg>
                                            </delete-item>

                                            <div class="col-lg-4 col-md-6">
                                                <div class="mt-3">
                                                    <!-- Button trigger modal -->
                                                    <!-- Modal -->
                                                    <div class="modal fade"
                                                         id="modalCenter"
                                                         tabindex="-1"
                                                         aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered"
                                                             role="document">
                                                            <div class="modal-content">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title" id="modalCenterTitle">
                                                                        @item.Title
                                                                    </h5>
                                                                    <button type="button"
                                                                            class="btn-close"
                                                                            data-bs-dismiss="modal"
                                                                            aria-label="Close"></button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <div class="row">
                                                                        <div class="col mb-4 mt-2">
                                                                            <div class="form-floating form-floating-outline">
                                                                                <p disabled="true" type="text">@item.Description</p>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="row g-2">
                                                                        <div class="col mb-2">
                                                                            <div class="form-floating form-floating-outline">
                                                                                <input type="email"
                                                                                       id="emailWithTitle"
                                                                                       class="form-control"
                                                                                       placeholder="xxxx@xxx.xx" />
                                                                                <label for="emailWithTitle">ایمیل</label>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col mb-2">
                                                                            <div class="form-floating form-floating-outline">
                                                                                <input type="date"
                                                                                       id="dobWithTitle"
                                                                                       class="form-control"
                                                                                       placeholder="DD / MM / YY" />
                                                                                <label for="dobWithTitle">تاریخ تولد</label>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <remove-request url="@Url.Page("AddRequest", "RemoveRequest", new{ FriendUserName = @item.UserNameSender})" description="آیا از این عملیات مطمئن هستید؟">
                                                                        <button type="button"
                                                                                class="btn btn-label-secondary"
                                                                                data-bs-dismiss="modal">
                                                                            رد کردن درخواست
                                                                        </button>
                                                                    </remove-request>
                                                                    <add-friend url="@Url.Page("SetFriend", "AddFriend", new{ FriendUserName = @item.UserNameSender})" description="آیا از این عملیات مطمئن هستید؟">
                                                                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                                                                            افزودن دوست
                                                                        </button>
                                                                    </add-friend>

                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>


                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td class="text-nowrap"></td>
                                <td></td>
                                <td>
                                    @*<div class="form-check d-flex justify-content-center">
                                    <input class="form-check-input" type="checkbox" id="defaultCheck1" checked="" />
                                </div>*@

                                </td>
                                <td><b>NotFound</b></td>
                                <td>
                                    @*<div class="form-check d-flex justify-content-center">
                                    <input class="form-check-input" type="checkbox" id="defaultCheck2" checked="">
                                </div>*@
                                </td>

                            </tr>

                        }

                    }


                    @*     <td>
                            <div class="form-check d-flex justify-content-center">
                                <input class="form-check-input" type="checkbox" id="defaultCheck12">
                            </div>
                        </td> *@

                </tbody>
            </table>
        </div>
        <div class="card-body">
            <button type="submit" class="btn btn-primary me-2 waves-effect waves-light">ذخیره تغییرات</button>
            <button type="reset" class="btn btn-outline-secondary waves-effect">انصراف</button>
        </div>
        <!-- /Notifications -->
    </div>
    <!-- /Current Plan -->





</div>

@section Scripts {
    <script>
        // var modal = document.getElementById('modalCenter');

        // // سپس یک تابع برای بستن مدال تعریف کنید
        // function closeModal() {
        //     var modalInstance = bootstrap.Modal.getInstance(modal);
        //     modalInstance.hide();
        // }
        // document.querySelector('.btn-close').addEventListener('click', closeModal);
        function AddFriend(url, Description) {

                Swal.fire({
                title: "افزودن دوست",
                text: Description,
                icon: "warning",
                confirmButtonText: "بله ، مطمعا هستم",
                cancelButtonText: "خیر",
                showCancelButton: true,
                }).then((result) => {
                if (result.isConfirmed) {
               var token = $("#ajax-token input[name='__RequestVerificationToken']").val();
                $.ajax({
                url: url,
                method: "post",
                data: {
                //productId: productId
               __RequestVerificationToken: token
                },
                beforeSend: function () {

                $(".loading").show();
                },
                complete: function () {
                $(".loading").hide();
                },
                }).done(function (data) {
                var res = JSON.parse(data);
                if (res.Status === 1) {
                Success("", res.Message, true);
                } else {
                ErrorAlert("", res.Message, res.isReloadPage);
                }
                });
                }
                });
                }
        function RemoveRequest(url, Description) {
         Swal.fire({
         title: "افزودن دوست",
         text: Description,
         icon: "warning",
         confirmButtonText: "بله ، مطمعا هستم",
         cancelButtonText: "خیر",
         showCancelButton: true,
         }).then((result) => {
         if (result.isConfirmed) {
        var token = $("#ajax-token input[name='__RequestVerificationToken']").val();
         $.ajax({
         url: url,
         method: "post",
         data: {
         //productId: productId
        __RequestVerificationToken: token
         },
         beforeSend: function () {

         $(".loading").show();
         },
         complete: function () {
         $(".loading").hide();
         },
         }).done(function (data) {
         var res = JSON.parse(data);
         if (res.Status === 1) {
         Success("", res.Message, true);
         } else {
         ErrorAlert("", res.Message, res.isReloadPage);
         }
         });
         }
         });
         }
    </script>
    <script src="~/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="~/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/assets/vendor/js/bootstrap.js"></script>
    <script src="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/assets/vendor/libs/node-waves/node-waves.js"></script>

    <script src="~/assets/vendor/libs/hammer/hammer.js"></script>
    <script src="~/assets/vendor/libs/i18n/i18n.js"></script>
    <script src="~/assets/vendor/libs/typeahead-js/typeahead.js"></script>

    <script src="~/assets/vendor/js/menu.js"></script>
    <!-- endbuild -->
    <!-- Vendors JS -->
    <script src="~/assets/vendor/libs/moment/moment.js"></script>
    <script src="~/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/cleavejs/cleave.js"></script>
    <script src="~/assets/vendor/libs/cleavejs/cleave-phone.js"></script>
    <script src="~/assets/vendor/libs/select2/select2.js"></script>
    <script src="~/assets/vendor/libs/formvalidation/dist/js/FormValidation.min.js"></script>
    <script src="~/assets/vendor/libs/formvalidation/dist/js/plugins/Bootstrap5.min.js"></script>
    <script src="~/assets/vendor/libs/formvalidation/dist/js/plugins/AutoFocus.min.js"></script>

    <!-- Main JS -->
    <script src="~/assets/js/main.js"></script>

    <!-- Page JS -->
    <script src="~/assets/js/modal-edit-user.js"></script>
    <script src="~/assets/js/app-user-view.js"></script>
    <script src="~/assets/js/app-user-view-account.js"></script>
}