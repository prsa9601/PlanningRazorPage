                                                                    @*<button type="button"
                                                                            class="RemoveRequest btn btn-label-secondary"
                                                                            data-bs-dismiss="modal">
                                                                        لغو درخواست
                                                                    </button>*@           
                                                                    @*</remove-request>*@
                                                                    @*<add-friend url="@Url.Page("SetFriend", "AddFriend", new{ FriendUserName = @item.UserNameSender})" description="آیا از این عملیات مطمئن هستید؟">*@
                                                                    <button value="@requestBoxUserNames[id]" asp-route="SetFriend/AddFriend?FriendUserName=@requestBoxUserNames[id]" type="button" id="AddFriend" class="btn btn-primary AddFriend" data-bs-dismiss="modal">
                                                                        افزودن دوست
                                                                    </button>
                                                                    @*</add-friend>*@

                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>


                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td class="text-nowrap"></td>
                                <td></td>
                                <td>
                                </td>
                                <td><b>NotFound</b></td>
                                <td>
                                </td>

                            </tr>

                        }

                    }
                </tbody>
            </table>
        </div>
        <div class="card-body">
            <button type="submit" class="btn btn-primary me-2 waves-effect waves-light">ذخیره تغییرات</button>
            <button type="reset" class="btn btn-outline-secondary waves-effect">انصراف</button>
        </div>
        <!-- /Notifications -->
    </div>
    <!-- /Current Plan -->





</div>

@section Scripts {
    <script>
        // var modal = document.getElementById('modalCenter');

        // // سپس یک تابع برای بستن مدال تعریف کنید
        // function closeModal() {
        //     var modalInstance = bootstrap.Modal.getInstance(modal);
        //     modalInstance.hide();
        // }
        // document.querySelector('.btn-close').addEventListener('click', closeModal);
        function AddFriend(url, Description) {

                Swal.fire({
                title: "افزودن دوست",
                text: Description,
                icon: "warning",
                confirmButtonText: "بله ، مطمعا هستم",
                cancelButtonText: "خیر",
                showCancelButton: true,
                }).then((result) => {
                if (result.isConfirmed) {
               var token = $("#ajax-token input[name='__RequestVerificationToken']").val();
                $.ajax({
                url: url,
                method: "post",
                data: {
                //productId: productId
               __RequestVerificationToken: token
                },
                beforeSend: function () {

                $(".loading").show();
                },
                complete: function () {
                $(".loading").hide();
                },
                }).done(function (data) {
                var res = JSON.parse(data);
                if (res.Status === 1) {
                Success("", res.Message, true);
                } else {
                ErrorAlert("", res.Message, res.isReloadPage);
                }
                });
                }
                });
                }
        function RemoveRequest(url, Description) {
         Swal.fire({
         title: "افزودن دوست",
         text: Description,
         icon: "warning",
         confirmButtonText: "بله ، مطمعا هستم",
         cancelButtonText: "خیر",
         showCancelButton: true,
         }).then((result) => {
         if (result.isConfirmed) {
        var token = $("#ajax-token input[name='__RequestVerificationToken']").val();
         $.ajax({
         url: url,
         method: "post",
         data: {
         //productId: productId
        __RequestVerificationToken: token
         },
         beforeSend: function () {

         $(".loading").show();
         },
         complete: function () {
         $(".loading").hide();
         },
         }).done(function (data) {
         var res = JSON.parse(data);
         if (res.Status === 1) {
         Success("", res.Message, true);
         } else {
         ErrorAlert("", res.Message, res.isReloadPage);
         }
         });
         }
         });
         }
    </script>
    <script>
              $(".OpenModal").click(function(){
                  //var pr = $(this).closest("tr").find("td:eq(1)").text();
                  // var pr = $(this).find("td:eq(0)").text();
                   var Descriptin =  $(this).closest("tr").find("td:eq(1)").text();
                   var Title =  $(this).closest("tr").find("td:eq(2)").text();
                   var FriendUserName =  $(this).closest("tr").find("td:eq(0)").text();
                  //var p = $(this).closest("tr").find("td:eq(2)").text();
                  $("#modalCenterTitle").text(Title);
                  $(".DescriptionRequest").text(Descriptin);
                  $(".FriendUserNameModal").val(FriendUserName);

              });

        $(".AddFriend").click(function(){
                          var token = $("#ajax-token input[name='__RequestVerificationToken']").val();

            var friendUserName = $(".FriendUserNameModal").val();
                                          $.post("/Front/Profile/SetFriend?handler=AddFriend", { FriendUserName: friendUserName,   __RequestVerificationToken: token}).done(function(){
                                              location.reload();
                                          });
              });


        $(".RemoveRequest").click(function(){

             var token = $("#ajax-token input[name='__RequestVerificationToken']").val();

            var friendUserName = $(".FriendUserNameModal").val();
                                          $.post("/Front/Profile/AddRequest?handler=RemoveRequest", { FriendUserName: friendUserName,   __RequestVerificationToken: token}).done(function(){
                                              location.reload();
                                          });;
              });

    </script>
