                                // List<string> Values = new List<string>();
                                //Values.Add(item.UserNameSender);
                                //Keys.Add(item.Description);
                                requestBoxUserNames.Add(id, item.UserNameSender);


                                <tr>
                                    <td class="text-nowrap">@item.UserNameSender</td>
