@page
@* "{chatId:long}" *@
@model PlanningRazorPage.Pages.Telegram.Post.AddModel
@{
    Layout = "Shared/_Layout";
}

@section Header {
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #6B8DD6 0%, #FFE66D 100%);
            --input-focus-border: #6B8DD6;
            --input-focus-shadow: rgba(107, 141, 214, 0.25);
        }

        .media-preview {
            position: relative;
            max-width: 100%;
            border-radius: 1rem;
            overflow: hidden;
            margin-top: 1rem;
            transition: all 0.3s ease;
        }

            .media-preview img,
            .media-preview video {
                width: 100%;
                max-height: 400px;
                object-fit: contain;
                border-radius: 1rem;
            }

        .remove-media-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.9);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }

            .remove-media-btn:hover {
                background: white;
                transform: rotate(90deg);
            }

        .form-card {
            background: rgba(255,255,255,0.95);
            border-radius: 1.5rem;
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            border: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .form-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 40px rgba(107, 141, 214, 0.2);
            }

        .card-header {
            background: var(--primary-gradient);
            color: white;
            border-radius: 1.5rem 1.5rem 0 0;
            padding: 1.5rem;
            font-size: 1.25rem;
            font-weight: 600;
            border: none;
        }

        .form-floating-outline .form-control {
            border: 2px solid #eee;
            border-radius: 1rem;
            padding: 1rem;
            transition: all 0.3s ease;
        }

            .form-floating-outline .form-control:focus {
                border-color: var(--input-focus-border);
                box-shadow: 0 0 0 4px var(--input-focus-shadow);
            }

        .file-upload {
            position: relative;
            overflow: hidden;
            border: 2px dashed #6B8DD6;
            border-radius: 1rem;
            padding: 2rem;
            text-align: center;
            background: rgba(107, 141, 214, 0.05);
        }

            .file-upload input[type="file"] {
                position: absolute;
                left: 0;
                top: 0;
                opacity: 0;
                cursor: pointer;
                width: 100%;
                height: 100%;
            }

            .file-upload:hover {
                background: rgba(107, 141, 214, 0.1);
            }

        .flatpickr-input {
            border: 2px solid #eee !important;
            border-radius: 1rem !important;
            padding: 1rem !important;
        }

            .flatpickr-input:focus {
                border-color: var(--input-focus-border) !important;
                box-shadow: 0 0 0 4px var(--input-focus-shadow) !important;
            }

        .btn-success {
            background: var(--primary-gradient);
            border: none;
            padding: 1rem 2rem;
            border-radius: 1rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-success:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(107, 141, 214, 0.3);
            }

        .media-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .media-item {
            position: relative;
            border-radius: 0.8rem;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }

            .media-item:hover {
                transform: translateY(-3px);
            }

            .media-item img,
            .media-item video {
                width: 100%;
                height: 180px;
                object-fit: cover;
                border-radius: 0.8rem;
            }

        .remove-btn {
            position: absolute;
            top: 5px;
            right: 5px;
            width: 28px;
            height: 28px;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .remove-btn:hover {
                background: white;
                transform: rotate(90deg);
            }

        .form-switch .form-check-input:not(:checked) {
            background-color: #6B8DD6;
            border-color: #6B8DD6;
        }

        .form-switch .form-check-input:checked {
            background-color: #dee2e6;
            border-color: #dee2e6;
        }

        .form-switch .form-check-input {
            transition: all 0.3s ease;
        }
    </style>

    <!-- لینک فایل‌های ضروری -->
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/bootstrap-datepicker/bootstrap-datepicker.css" />
}

<div class="col-12 container-fluid">
    <div class="form-card">
        <h5 class="card-header">📬 ایجاد پست تلگرامی</h5>
        <form method="post" class="form-repeater p-4" id="mainForm">

         
            <div class="mb-3">
                <label asp-for="Description" class="form-label">📝 توضیحات</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          required></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- لینک -->
            <div class="mb-3">
                <label asp-for="Link" class="form-label">🔗 لینک (اختیاری)</label>
                <input asp-for="Link"
                       id="Input_Link"
                       class="form-control"
                       type="url"
                       placeholder="https://example.com" />
                <span asp-validation-for="Link" class="text-danger"></span>
            </div>

            <!-- Slug -->
            <div class="mb-3">
                <label asp-for="Slug" class="form-label">🏷️ Slug</label>
                <input asp-for="Slug"
                       id="Input_Slug"
                       class="form-control"
                       placeholder="my-post-slug"
                       required />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

