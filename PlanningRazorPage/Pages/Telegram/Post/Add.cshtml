@section Scripts {
    <script src="~/assets/vendor/libs/moment/moment.js"></script>
    <script src="~/assets/vendor/libs/jdate/jdate.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/flatpickr-jdate.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/fa-jdate.js"></script>
    <script src="~/assets/js/forms-pickers.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.29.1/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jalali-moment@3.3.10/dist/jalali-moment.browser.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const persianDateConfig = {
                locale: "fa",
                enableTime: true,
                dateFormat: "Y/m/d H:i",
                time_24hr: true,
                static: true
            };

            // تابع مقداردهی اولیه تقویم
            const initDateTimePicker = () => {
                const now = moment().locale('fa');
                const formattedDate = now.format('jYYYY/jMM/jDD HH:mm');
                const dateInput = document.getElementById('flatpickr-datetime');
                const scheduleSwitch = document.getElementById('scheduleSwitch');

                // حالت اولیه: چک باکس خاموش و تقویم فعال
                scheduleSwitch.checked = false;
                dateInput.disabled = false;
                flatpickr(dateInput, {...persianDateConfig, defaultDate: formattedDate});

                // مدیریت تغییر وضعیت چک باکس
                scheduleSwitch.addEventListener('change', () => {
                    if (scheduleSwitch.checked) {
                        // اگر چک باکس روشن شد: تقویم غیرفعال و مقدارش پاک شود
                        dateInput.disabled = false;
                        dateInput.value = '';
                    } else {
                        // اگر چک باکس خاموش شد: تقویم فعال و تاریخ فعلی تنظیم شود
                        dateInput.disabled = true;
                        dateInput.value = formattedDate;
                        flatpickr(dateInput, {...persianDateConfig, defaultDate: formattedDate});
                    }
                });
            };

            // تابع مدیریت ارسال فرم
            const handleSubmitClick = async (e) => {
                e.preventDefault();
                const submitBtn = document.getElementById('submitBtn');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> در حال ارسال...';

                try {
                    const formData = new FormData();
                    // ... سایر فیلدها ...

                    // مدیریت فیلد تاریخ فقط وقتی چک باکس خاموش است
                    if (!document.getElementById('scheduleSwitch').checked) {
                        const persianDate = document.getElementById('flatpickr-datetime').value;
                        if (!persianDate) throw new Error('تاریخ ارسال الزامی است');

                        const gregorianDate = moment(persianDate, 'jYYYY/jMM/jDD HH:mm', 'fa')
                            .locale('en')
                            .toDate()
                            .toISOString();
                        formData.append('ScheduleDate', gregorianDate);
                    }

                    // ... بقیه عملیات ارسال ...
                } catch (error) {
                    // ... مدیریت خطاها ...
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="mdi mdi-send-check-outline me-2"></i> ثبت پست';
                }
            };

            // مقداردهی اولیه
            initDateTimePicker();
            // ... بقیه تنظیمات ...
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // تنظیمات اولیه
            const persianDateConfig = {
                locale: "fa",
                enableTime: true,
                dateFormat: "Y/m/d H:i",
                time_24hr: true,
                static: true
            };

            // مقداردهی اولیه تاریخ
            const initDateTimePicker = () => {
                const now = moment().locale('fa');
                const formattedDate = now.format('jYYYY/jMM/jDD HH:mm');
                const dateInput = document.getElementById('flatpickr-datetime');

                dateInput.value = formattedDate;
                flatpickr(dateInput, {...persianDateConfig, defaultDate: formattedDate});
            };

            // مدیریت آپلود مدیا
            const setupMediaUpload = (inputId, previewId, maxSize, type) => {
                const input = document.getElementById(inputId);
                const preview = document.getElementById(previewId);

                input.addEventListener('change', (e) => {
                    preview.innerHTML = '';
                    Array.from(e.target.files).forEach(file => {
                        if(file.size > maxSize) {
                            alert(`حجم ${type === 'image' ? 'عکس' : 'ویدیو'} باید کمتر از ${maxSize/1024/1024} مگابایت باشد!`);
                            return;
                        }

                        const reader = new FileReader();
                        reader.onload = (e) => {
                            const mediaItem = createMediaElement(e.target.result, file.type);
                            const removeBtn = createRemoveButton(file, input);
                            preview.appendChild(createMediaWrapper(mediaItem, removeBtn));
                        };
                        reader.readAsDataURL(file);
                    });
                });
            };

            // توابع کمکی
            const createMediaElement = (src, type) => {
                const element = type.startsWith('image/') ?
                    document.createElement('img') :
                    document.createElement('video');

                element.src = src;
                if(element.tagName === 'VIDEO') element.controls = true;
                return element;
            };

            const createRemoveButton = (file, input) => {
                const btn = document.createElement('div');
                btn.className = 'remove-btn';
                btn.innerHTML = '<i class="mdi mdi-close text-danger"></i>';
                btn.onclick = () => removeMedia(file, input);
                return btn;
            };

            const createMediaWrapper = (...elements) => {
                const wrapper = document.createElement('div');
                wrapper.className = 'media-item';
                elements.forEach(el => wrapper.appendChild(el));
                return wrapper;
            };

            const removeMedia = (file, input) => {
                const files = Array.from(input.files);
                const newFiles = files.filter(f => f !== file);

                const dataTransfer = new DataTransfer();
                newFiles.forEach(f => dataTransfer.items.add(f));
                input.files = dataTransfer.files;
                input.dispatchEvent(new Event('change'));
            };

            // مدیریت کلیک روی دکمه ارسال
            const handleSubmitClick = async (e) => {
                e.preventDefault();
                const submitBtn = document.getElementById('submitBtn');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> در حال ارسال...';

                try {
                    // جمع‌آوری تمام اطلاعات فرم
                    const formData = new FormData();

                    // افزودن عنوان
                    const title = document.getElementById('Description').value;
                    if (!title || title.trim().length < 3) {
                        throw new Error('عنوان باید حداقل ۳ کاراکتر داشته باشد');
                    }
                    formData.append('Description', title.trim());
                    formData.append('ChatId', @Model.ChatId);
                    formData.append('Link', document.getElementById('Input_Link').value);
                    formData.append('Slug', document.getElementById('Input_Slug').value);

                    // افزودن عکس‌ها
                    const imageFiles = document.getElementById('imageUpload').files;
                    // if (imageFiles.length === 0) {
                    //     throw new Error('حداقل یک عکس باید انتخاب شود');
                    // }
                    Array.from(imageFiles).forEach(file => {
                        formData.append('ImageFiles', file);
                    });

                    // افزودن ویدیوها
                    const videoFiles = document.getElementById('videoUpload').files;
                    Array.from(videoFiles).forEach(file => {
                        formData.append('VideoFiles', file);
                    });

                    // تبدیل و افزودن تاریخ
                    const persianDate = document.getElementById('flatpickr-datetime').value;
                    const gregorianDate = moment(persianDate, 'jYYYY/jMM/jDD HH:mm', 'fa')
                        .locale('en')
                        .toDate()
                        .toISOString();
                    formData.append('ScheduleDate', gregorianDate);

                    // ارسال درخواست
                    const response = await fetch('@Url.Page("Add")', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('[name="__RequestVerificationToken"]').value
                        },
                        body: formData
                    });

                    const result = await response.json();

                    if (!response.ok || !result.success) {
                        throw new Error(result.message || 'خطا در ارسال اطلاعات');
                    }

                    // نمایش نتیجه موفق
                    Swal.fire({
                        icon: 'success',
                        title: 'ارسال موفق',
                        html: `
                            <div class="text-start">
                                <p><strong>عنوان:</strong> ${result.data.title}</p>
                                <p><strong>تعداد عکس:</strong> ${result.data.imageCount}</p>
                                <p><strong>تعداد ویدیو:</strong> ${result.data.videoCount}</p>
                                <p><strong>زمان ارسال:</strong> ${new Date(result.data.scheduleDate).toLocaleString('fa-IR')}</p>
                            </div>
                        `,
                        confirmButtonText: 'متوجه شدم'
                    }).then(() => {
                        window.location.reload();
                    });

                } catch (error) {
                    // نمایش خطا
                    Swal.fire({
                        icon: 'error',
                        title: 'خطا!',
                        text: error.message,
                        confirmButtonText: 'متوجه شدم'
                    });
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="mdi mdi-send-check-outline me-2"></i> ثبت پست';
                }
            };

            // مقداردهی اولیه
            initDateTimePicker();
            setupMediaUpload('imageUpload', 'imagePreview', 5 * 1024 * 1024, 'image');
            setupMediaUpload('videoUpload', 'videoPreview', 50 * 1024 * 1024, 'video');
            document.getElementById('submitBtn').addEventListener('click', handleSubmitClick);
        });
    </script>
