                const persianDate = document.getElementById('flatpickr-datetime').value;
                const gregorianDate = moment(persianDate, 'jYYYY/jMM/jDD HH:mm', 'fa')
                    .locale('en')
                    .toDate()
                    .toISOString();
                formData.append('ScheduleDate', gregorianDate);

                // ارسال داده
                const response = await fetch('@Url.Page("Add")', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('[name="__RequestVerificationToken"]').value
                    },
                    body: formData
                });

                const result = await response.json();

                if(result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'ارسال موفق!',
                        html: `
                            <div class="text-start">
                                <p>عنوان: ${result.data.title}</p>
                                <p>تعداد عکس: ${result.data.imageCount}</p>
                                <p>تعداد ویدیو: ${result.data.videoCount}</p>
                                <p>تاریخ ارسال: ${new Date(result.data.scheduleDate).toLocaleString('fa-IR')}</p>
                            </div>
                        `
                    });
                } else {
                    throw new Error(result.message);
                }
            } catch (error) {
                Swal.fire('خطا!', error.message, 'error');
                console.error('Submission error:', error);
            } finally {
                submitBtn.disabled = false;
            }
        };

            // مقداردهی اولیه
            initDateTimePicker();
            setupMediaUpload('imageUpload', 'imagePreview', 5 * 1024 * 1024, 'image');
            setupMediaUpload('videoUpload', 'videoPreview', 50 * 1024 * 1024, 'video');
            document.getElementById('mainForm').addEventListener('submit', handleFormSubmit);
        });
