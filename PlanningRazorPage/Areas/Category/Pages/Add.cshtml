            //                 // نمایش پیام خطا
            //                 const errorSpan = field.closest('.mb-3, .mb-4')?.querySelector('.invalid-feedback');
            //                 if (errorSpan) {
            //                     errorSpan.style.display = 'block';
            //                 }
            //             } else if (field) {
            //                 field.classList.remove('is-invalid');
            //             }
            //         });

            //         if (!isValid) {
