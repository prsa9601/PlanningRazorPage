            //             const errorAlert = document.querySelector('.validation-summary');
            //             if (errorAlert) {
            //                 errorAlert.classList.remove('d-none');
            //                 window.scrollTo({ top: 0, behavior: 'smooth' });
            //             }
            //         }
            //     });
            // }
               var checkBox = document.getElementById("seoData.IndexPage");
            checkBox.value = true;
            if (checkBox) {
                checkBox.addEventListener('change', function() {
                    if (this.checked) {
                         checkBox.value = true;
                    } else {
                    checkBox.value = false;
                    }
                });
            }

        });
    </script>
}