@page
@model PlanningRazorPage.Areas.AdminPanel.Blog.AddModel
@{
}
@section Header {
    @*     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css"> *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/css/persian-datepicker.min.css">
    <style>
        :root {
            --primary-color: #4e73df;
            --secondary-color: #6f42c1;
            --success-color: #1cc88a;
            --dark-color: #2e3a59;
            --darker-color: #1a233a;
        }

        body {
            background-color: #f8f9fc;
            font-family: 'Vazir', 'Segoe UI', Tahoma, sans-serif;
            color: #4e4e4e;
        }

        .card {
            border-radius: 15px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            border: none;
            margin-left: 0;
            margin-right: 0;
            width: 100%;
        }

        .card-header {
            background-color: var(--dark-color);
            color: white;
            border-radius: 15px 15px 0 0 !important;
            font-weight: 700;
            padding: 1.25rem 1.5rem;
        }

        .form-control, .form-select {
            border-radius: 10px;
            padding: 12px 15px;
            border: 1px solid #ddd;
            transition: all 0.3s;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.25rem rgba(78, 115, 223, 0.25);
            }

        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            border-radius: 10px;
            padding: 10px 25px;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-primary:hover {
                background-color: #2e59d9;
                border-color: #2653d4;
                transform: translateY(-2px);
            }

        .form-label {
            font-weight: 600;
            margin-bottom: 8px;
            color: #4e4e4e;
        }

        .validation-summary {
            border-radius: 10px;
            border-left: 5px solid #e74a3b;
        }

        .seo-section {
            background-color: #f8f9fe;
            border-radius: 10px;
            padding: 20px;
            border-left: 3px solid var(--secondary-color);
        }

        .upload-area {
            border: 2px dashed #ddd;
            border-radius: 10px;
            padding: 30px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }

            .upload-area:hover {
                border-color: var(--primary-color);
                background-color: rgba(78, 115, 223, 0.05);
            }

        .upload-icon {
            font-size: 50px;
            color: #6c757d;
            margin-bottom: 15px;
        }

        .dark-mode {
            background-color: var(--darker-color);
            color: #d1d4e7;
        }

            .dark-mode .card {
                background-color: #252d48;
                box-shadow: 0 0.15rem 1.75rem 0 rgba(0, 0, 0, 0.3);
            }

            .dark-mode .form-control, .dark-mode .form-select {
                background-color: #1e263e;
                border-color: #2a3655;
                color: #d1d4e7;
            }

            .dark-mode .form-label {
                color: #d1d4e7;
            }

            .dark-mode .seo-section {
                background-color: #1e263e;
            }

        .ckeditor-container {
            width: 100%;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid #ddd;
            margin-top: 20px;
        }

        .ck-editor {
            width: 100% !important;
        }

        .ck-editor__editable {
            min-height: 400px !important;
            width: 100% !important;
            background-color: white !important;
            color: #333 !important;
            padding: 15px !important;
        }

        .dark-mode .ck-editor__editable {
            background-color: #1e263e !important;
            color: #d1d4e7 !important;
            border: 1px solid #2a3655 !important;
        }

        .container-fluid {
            padding-left: 0;
            padding-right: 0;
        }

        .col-lg-10 {
            max-width: 100%;
            flex: 0 0 100%;
        }

        .card-body {
            padding: 2rem;
        }

        .layout-page {
            margin-right: 0 !important;
        }

        .layout-menu-fixed .layout-page {
            padding-top: 0;
        }

        .content-wrapper {
            padding: 0 !important;
        }

        /* media (max-width: 768px) {
                                    .row

                                {
                                    flex-direction: column;
                                }

                                .col-md-8, .col-md-4 {
                                    width: 100%;
                                    max-width: 100%;
                                }

                                .ck-editor__editable {
                                    min-height: 300px !important;
                                }

                                 */ }

        .switch-container {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
        }

        .form-check-input:checked {
            background-color: var(--success-color);
            border-color: var(--success-color);
        }

        .form-check-label {
            margin-right: 10px;
            font-weight: 600;
            color: var(--dark-color);
        }

        .dark-mode .form-check-label {
            color: #d1d4e7;
        }

        .flatpickr-input[disabled] {
            background-color: #e9ecef;
            cursor: not-allowed;
        }

        .dark-mode .flatpickr-input[disabled] {
            background-color: #2a3655;
        }

        .file-manager-modal .modal-content {
            border-radius: 15px;
            overflow: hidden;
        }

        .file-manager-header {
            background-color: var(--primary-color);
            color: white;
            padding: 15px 20px;
        }

        .file-item {
            border: 1px solid #eee;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            transition: all 0.3s;
            cursor: pointer;
        }

            .file-item:hover {
                transform: translateY(-3px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
                border-color: var(--primary-color);
            }

        .file-icon {
            font-size: 36px;
            color: #6c757d;
        }

        .file-name {
            font-weight: 600;
            margin-top: 10px;
            text-overflow: ellipsis;
            overflow: hidden;
            white-space: nowrap;
        }

        .file-size {
            color: #6c757d;
            font-size: 0.9rem;
        }

        .file-manager-body {
            max-height: 500px;
            overflow-y: auto;
        }

        .file-type-filter {
            margin-bottom: 20px;
        }

        .file-type-btn {
            margin: 0 5px;
            border-radius: 20px;
        }

        .file-manager-footer {
            padding: 15px;
            background-color: #f8f9fa;
            border-top: 1px solid #eee;
        }
    </style>
}
<div class="container-fluid px-4 py-3">
    <div class="row">
        <div class="col-12">
