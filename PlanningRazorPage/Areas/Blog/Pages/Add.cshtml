                                </div>

                                <div class="mb-4">
                                    <label for="CategoryId" class="form-label">دسته بندی</label>
                                    <select asp-for="@Model.CategoryId" name="CategoryId" class="form-select" id="CategoryId">
                                        <option value="">انتخاب دسته بندی</option>
                                        <option value="1">تکنولوژی</option>
                                        <option value="2">برنامه نویسی</option>
                                        <option value="3">طراحی وب</option>
                                        <option value="4">هوش مصنوعی</option>
                                        <option value="5">مدیریت پروژه</option>
                                    </select>
                                    <div class="invalid-feedback">لطفاً دسته بندی را انتخاب کنید</div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">تصویر شاخص</label>
                                    <div class="upload-area" id="upload-area">
                                        <i class="bi bi-cloud-arrow-up upload-icon"></i>
                                        <p class="mb-2">برای آپلود تصویر کلیک کنید</p>
                                        <p class="text-muted small mb-0">فرمت‌های مجاز: JPG, PNG (حداکثر 2MB)</p>
                                        <input asp-for="@Model.Image" name="Image" type="file" class="d-none" id="Image">
                                    </div>
                                    <div class="preview mt-3 text-center d-none" id="image-preview">
                                        <img src="" class="img-thumbnail" style="max-height: 150px">
                                        <button type="button" class="btn btn-sm btn-danger mt-2" id="remove-image">
                                            <i class="bi bi-trash"></i> حذف تصویر
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label for="Description" class="form-label">متن وبلاگ</label>
                                        @*  <button type="button" class="btn btn-sm btn-outline-primary" id="open-file-manager">
                                                <i class="bi bi-folder2-open"></i> انتخاب از فایل‌ها
                                            </button> *@
                                    </div>
                                    <div class="ckeditor-container">
                                        <textarea asp-for="@Model.Description" name="Description" class="form-control" id="Description" rows="6" placeholder="محتویات وبلاگ را بنویسید..."></textarea>
                                    </div>
                                    <div class="invalid-feedback">لطفاً متن وبلاگ را وارد کنید</div>
                                </div>
                            </div>
                        </div>

                        @*        <div class="seo-section mb-4">
                                <h5 class="mb-4"><i class="bi bi-search me-2"></i>تنظیمات سئو</h5>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="MetaTitle" class="form-label">عنوان متا</label>
                                        <input type="text" class="form-control" id="MetaTitle" placeholder="عنوان برای موتورهای جستجو">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="MetaKeywords" class="form-label">کلمات کلیدی</label>
                                        <input type="text" class="form-control" id="MetaKeywords" placeholder="کلمات کلیدی را با کاما جدا کنید">
                                    </div>
                                    <div class="col-12 mb-3">
                                        <label for="MetaDescription" class="form-label">توضیحات متا</label>
                                        <textarea class="form-control" id="MetaDescription" rows="3" placeholder="توضیحات مختصر برای موتورهای جستجو"></textarea>
                                    </div>
                                </div>
                            </div> *@
                        <div class="seo-section mb-4">
                            <h5 class="mb-4"><i class="bi bi-search me-2"></i>تنظیمات سئو</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="MetaTitle" class="form-label">عنوان متا</label>
                                    <input asp-for="@Model.SeoData.MetaTitle" name="SeoData.MetaTitle" type="text" class="form-control" id="MetaTitle" placeholder="عنوان برای موتورهای جستجو">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="MetaKeywords" class="form-label">کلمات کلیدی</label>
                                    <input asp-for="@Model.SeoData.MetaKeyWords" name="SeoData.MetaKeyWords" type="text" class="form-control" id="MetaKeywords" placeholder="کلمات کلیدی را با کاما جدا کنید">
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="MetaDescription" class="form-label">توضیحات متا</label>
                                    <textarea asp-for="@Model.SeoData.MetaDescription" name="SeoData.MetaDescription" class="form-control" id="MetaDescription" rows="3" placeholder="توضیحات مختصر برای موتورهای جستجو"></textarea>
                                </div>

                                <!-- New SEO Fields -->
                                <div class="col-md-6 mb-3">
                                    <div class="form-check form-switch">
