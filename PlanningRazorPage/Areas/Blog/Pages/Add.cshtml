                                        <label class="form-check-label" for="IndexPage">فهرست‌بندی در موتورهای جستجو</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="Canonical" class="form-label">لینک کانونیکال</label>
                                    <input asp-for="@Model.SeoData.Canonical" name="SeoData.Canonical" type="text" class="form-control" id="Canonical" placeholder="https://example.com/page">
                                </div>
