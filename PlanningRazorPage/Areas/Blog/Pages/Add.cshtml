                                    <label for="Schema" class="form-label">ساختار داده‌ها (Schema)</label>
                                    <textarea asp-for="@Model.SeoData.Schema" name="SeoData.Schema" class="form-control" id="Schema" rows="5" placeholder='{"context":"https://schema.org","type":"BlogPosting"...}'></textarea>
