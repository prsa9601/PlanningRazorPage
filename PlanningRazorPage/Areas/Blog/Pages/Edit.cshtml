@page
@using PlanningRazorPage.Infrastructure
@model PlanningRazorPage.Areas.Blog.Pages.EditModel
@{
    ViewData["Title"] = "ویرایش وبلاگ";
}

@section Header {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/css/persian-datepicker.min.css">
    <style>
        :root {
            --primary-color: #4e73df;
            --secondary-color: #6f42c1;
            --success-color: #1cc88a;
            --dark-color: #2e3a59;
            --darker-color: #1a233a;
        }

        body {
            background-color: #f8f9fc;
            font-family: 'Vazir', 'Segoe UI', Tahoma, sans-serif;
            color: #4e4e4e;
        }

        .card {
            border-radius: 15px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            border: none;
            margin-left: 0;
            margin-right: 0;
            width: 100%;
        }

        .card-header {
            background-color: var(--dark-color);
            color: white;
            border-radius: 15px 15px 0 0 !important;
            font-weight: 700;
            padding: 1.25rem 1.5rem;
        }

        .form-control, .form-select {
            border-radius: 10px;
            padding: 12px 15px;
            border: 1px solid #ddd;
            transition: all 0.3s;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.25rem rgba(78, 115, 223, 0.25);
            }

        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            border-radius: 10px;
            padding: 10px 25px;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-primary:hover {
                background-color: #2e59d9;
                border-color: #2653d4;
                transform: translateY(-2px);
            }

        .form-label {
            font-weight: 600;
            margin-bottom: 8px;
            color: #4e4e4e;
        }

        .validation-summary {
            border-radius: 10px;
            border-left: 5px solid #e74a3b;
        }

        .seo-section {
            background-color: #f8f9fe;
            border-radius: 10px;
            padding: 20px;
            border-left: 3px solid var(--secondary-color);
        }

        .upload-area {
            border: 2px dashed #ddd;
            border-radius: 10px;
            padding: 30px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }

            .upload-area:hover {
                border-color: var(--primary-color);
                background-color: rgba(78, 115, 223, 0.05);
            }

        .upload-icon {
            font-size: 50px;
            color: #6c757d;
            margin-bottom: 15px;
        }

        .dark-mode {
            background-color: var(--darker-color);
            color: #d1d4e7;
        }

            .dark-mode .card {
                background-color: #252d48;
                box-shadow: 0 0.15rem 1.75rem 0 rgba(0, 0, 0, 0.3);
            }

            .dark-mode .form-control, .dark-mode .form-select {
                background-color: #1e263e;
                border-color: #2a3655;
                color: #d1d4e7;
            }

            .dark-mode .form-label {
                color: #d1d4e7;
            }

            .dark-mode .seo-section {
                background-color: #1e263e;
            }

        .ckeditor-container {
            width: 100%;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid #ddd;
            margin-top: 20px;
        }

        .ck-editor {
            width: 100% !important;
        }

        .ck-editor__editable {
            min-height: 400px !important;
            width: 100% !important;
            background-color: white !important;
            color: #333 !important;
            padding: 15px !important;
        }

        .dark-mode .ck-editor__editable {
            background-color: #1e263e !important;
            color: #d1d4e7 !important;
            border: 1px solid #2a3655 !important;
        }

        .container-fluid {
            padding-left: 0;
            padding-right: 0;
        }

        .col-lg-10 {
            max-width: 100%;
            flex: 0 0 100%;
        }

        .card-body {
            padding: 2rem;
        }

        .layout-page {
            margin-right: 0 !important;
        }

        .layout-menu-fixed .layout-page {
            padding-top: 0;
        }

        .content-wrapper {
            padding: 0 !important;
        }

        .switch-container {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
        }

        .form-check-input:checked {
            background-color: var(--success-color);
            border-color: var(--success-color);
        }

        .form-check-label {
            margin-right: 10px;
            font-weight: 600;
            color: var(--dark-color);
        }

        .dark-mode .form-check-label {
            color: #d1d4e7;
        }

        .flatpickr-input[disabled] {
            background-color: #e9ecef;
            cursor: not-allowed;
        }

        .dark-mode .flatpickr-input[disabled] {
            background-color: #2a3655;
        }

        .current-image {
            margin-bottom: 15px;
            border-radius: 10px;
            overflow: hidden;
            max-width: 200px;
            border: 1px solid #eee;
        }

        .no-category-alert {
            border-radius: 10px;
            border-left: 5px solid #e74a3b;
            margin-bottom: 20px;
        }

        .disabled-form {
            opacity: 0.6;
            pointer-events: none;
        }

    </style>
}

<div class="container-fluid px-4 py-3">
    <div class="row">
        <div class="col-12">
            <div class="card">

                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>ویرایش وبلاگ</h5>
                    <button id="theme-toggle" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-moon"></i> تغییر تم
                    </button>
                </div>
                <div class="card-body">
                    <!-- Category Warning -->
                    @if (Model.Categories.Count() == 0)
                    {
                        <div class="alert alert-danger no-category-alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>دسته بندی وجود ندارد!</strong> برای افزودن دسته بندی روی این دکمه کلیک کنید
                            <div class="mt-3">
                                <a asp-area="Blog" asp-page="AddCategory" class="btn btn-primary">
                                    <i class="bi bi-plus-circle me-2"></i>افزودن دسته بندی
                                </a>
                            </div>
                        </div>
                    }

                    <div class="alert alert-danger validation-summary mb-4 d-none">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <span id="error-message">لطفا خطاهای فرم را برطرف کنید</span>
                    </div>

                    @*   <div class="alert alert-danger validation-summary mb-4 d-none">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <span id="error-message">لطفا خطاهای فرم را برطرف کنید</span>
                    </div> *@

                    <form asp-area="AdminPanel" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-4">
                                    <label for="Title" class="form-label">عنوان</label>
                                    <input asp-for="Title" type="text" class="form-control" name="Title" id="Title" value="@Model.Title" placeholder="عنوان وبلاگ را وارد کنید">
                                    <div class="invalid-feedback">لطفاً عنوان را وارد کنید</div>
                                </div>

                                <div class="mb-4">
                                    <label for="Slug" class="form-label">Slug</label>
                                    <input asp-for="Slug" type="text" class="form-control" name="Slug" id="Slug" value="@Model.Slug" placeholder="slug-مطلب">
                                    <div class="invalid-feedback">لطفاً slug را وارد کنید</div>
                                </div>
                            </div>
                            @Html.AntiForgeryToken()
                            <div class="col-md-4">
                                <div class="mb-4">
                                    <div class="switch-container">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="scheduleSwitch"
                                        @(Model.SendTime <= DateTime.Now ? "checked" : "")>
                                        <label class="form-check-label" for="scheduleSwitch">⏰ ارسال فوری</label>
                                    </div>
                                    <label for="SendTime" class="form-label">تاریخ ارسال</label>
                                    <input asp-for="SendTime" type="text" value="@Model.SendTime" class="form-control" id="SendTime" readonly>
                                    <div class="invalid-feedback">لطفاً تاریخ ارسال را انتخاب کنید</div>
                                </div>

                                <div class="mb-4">
                                    <label for="CategoryId" class="form-label">دسته بندی</label>
                                    <select asp-for="CategoryId" class="form-select" id="CategoryId" name="CategoryId">
                                        <option value="">انتخاب دسته بندی</option>
                                        @foreach (var category in Model.Categories)
                                        {
                                            <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">
                                                @category.Title
                                            </option>
                                        }
                                    </select>
                                    <div class="invalid-feedback">لطفاً دسته بندی را انتخاب کنید</div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">تصویر شاخص</label>

                                    @if (!string.IsNullOrEmpty(Model.CurrentImage))
                                    {
                                        <div class="current-image mb-3">
                                            <img src="@Directories.GetBlogImage(Model.CurrentImage)" asp-for="@Model.CurrentImage" id="CurrentImage" class="img-fluid" alt="تصویر فعلی">
                                        </div>
                                    }

                                    <div class="upload-area" id="upload-area">
                                        <i class="bi bi-cloud-arrow-up upload-icon"></i>
                                        <p class="mb-2">برای تغییر تصویر کلیک کنید</p>
                                        <p class="text-muted small mb-0">فرمت‌های مجاز: JPG, PNG (حداکثر 2MB)</p>
                                        <input asp-for="Image" type="file" class="d-none" id="Image" name="Image">
                                    </div>
                                    <div class="preview mt-3 text-center d-none" id="image-preview">
                                        <img src="" class="img-thumbnail" style="max-height: 150px">
                                        <button type="button" class="btn btn-sm btn-danger mt-2" id="remove-image">
                                            <i class="bi bi-trash"></i> حذف تصویر
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label for="Description" class="form-label">متن وبلاگ</label>
                                    </div>
                                    <div class="ckeditor-container">
                                        <textarea asp-for="Description" class="form-control" name="Description" id="Description" rows="6" placeholder="محتویات وبلاگ را بنویسید..."> @Model.Description</textarea>
                                    </div>
                                    <div class="invalid-feedback">لطفاً متن وبلاگ را وارد کنید</div>
                                </div>
                            </div>
                        </div>

                        <div class="seo-section mb-4">
                            <h5 class="mb-4"><i class="bi bi-search me-2"></i>تنظیمات سئو</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="MetaTitle" class="form-label">عنوان متا</label>
                                    <input asp-for="SeoData.MetaTitle" type="text" class="form-control" name="MetaTitle" id="MetaTitle" value="@Model.SeoData.MetaTitle" placeholder="عنوان برای موتورهای جستجو">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="MetaKeywords" class="form-label">کلمات کلیدی</label>
                                    <input asp-for="SeoData.MetaKeyWords" type="text" class="form-control" name="MetaKeywords" id="MetaKeywords" value="@Model.SeoData.MetaKeyWords" placeholder="کلمات کلیدی را با کاما جدا کنید">
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="MetaDescription" class="form-label">توضیحات متا</label>
                                    <textarea asp-for="SeoData.MetaDescription" class="form-control" name="MetaDescription" id="MetaDescription" rows="3" placeholder="توضیحات مختصر برای موتورهای جستجو">@Model.SeoData.MetaDescription</textarea>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <div class="form-check form-switch">
                                        <input asp-for="SeoData.IndexPage" class="form-check-input" type="checkbox" name="IndexPage" id="IndexPage">
                                        <label class="form-check-label" for="IndexPage">فهرست‌بندی در موتورهای جستجو</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="Canonical" class="form-label">لینک کانونیکال</label>
                                    <input asp-for="SeoData.Canonical" type="text" class="form-control" name="Canonical" id="Canonical" value="@Model.SeoData.Canonical" placeholder="https://example.com/page">
                                </div>
                                <div class="col-12 mb-3">
                                    <label for="Schema" class="form-label">ساختار داده‌ها (Schema)</label>
                                    <textarea asp-for="SeoData.Schema" class="form-control" name="Schema" id="Schema" rows="5" placeholder='{"context":"https://schema.org","type":"BlogPosting"...}'>@Model.SeoData.Schema</textarea>
                                    <div class="form-text">داده‌های ساختاریافته به صورت JSON-LD وارد کنید</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-area="AdminPanel" asp-page="List" class="btn btn-secondary">
                                <i class="bi bi-x-circle me-2"></i>انصراف
                            </a>
                            <button type="submit" id="submitButton" class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>ذخیره تغییرات
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/persian-date@1.1.0/dist/persian-date.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/js/persian-datepicker.min.js"></script>
    <script src="https://cdn.ckeditor.com/4.21.0/full/ckeditor.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize Persian Datepicker
            $("#SendTime").persianDatepicker({
                format: 'YYYY/MM/DD HH:mm',
                observer: true,
                autoClose: true,
                initialValue: true,
                timePicker: {
                    enabled: true,
                    meridiem: {
                        enabled: true
                    }
                }
            });

            // Theme toggle
            const themeToggle = document.getElementById('theme-toggle');
            if (themeToggle) {
                themeToggle.addEventListener('click', () => {
                    document.body.classList.toggle('dark-mode');
                    const icon = themeToggle.querySelector('i');
                    if (document.body.classList.contains('dark-mode')) {
                        icon.classList.remove('bi-moon');
                        icon.classList.add('bi-sun');
                    } else {
                        icon.classList.remove('bi-sun');
                        icon.classList.add('bi-moon');
                    }
                });
            }

            // Schedule switch functionality
            const scheduleSwitch = document.getElementById('scheduleSwitch');
            if (scheduleSwitch) {
                scheduleSwitch.addEventListener('change', function() {
                    if (this.checked) {
                        $("#SendTime").attr('disabled', true);
                        const now = new persianDate();
                        $("#SendTime").val(now.toLocale('fa').format('YYYY/MM/DD HH:mm'));
                    } else {
                        $("#SendTime").attr('disabled', false);
                        const now = new persianDate();
                        $("#SendTime").val(now.toLocale('fa').format('YYYY/MM/DD HH:mm'));
                    }
                });

                // Set initial state
                if (scheduleSwitch.checked) {
                    $("#SendTime").attr('disabled', true);
                }
            }

            // Upload image preview
            const uploadArea = document.getElementById('upload-area');
            const imageInput = document.getElementById('Image');
            const imagePreview = document.getElementById('image-preview');
            const previewImg = imagePreview ? imagePreview.querySelector('img') : null;
            const removeImageBtn = document.getElementById('remove-image');

            if (uploadArea && imageInput) {
                uploadArea.addEventListener('click', () => {
                    imageInput.click();
                });
            }

            if (imageInput) {
                imageInput.addEventListener('change', function() {
                    if (this.files && this.files[0]) {
                        const reader = new FileReader();

                        reader.onload = function(e) {
                            if (previewImg) {
                                previewImg.src = e.target.result;
                            }
                            if (imagePreview) {
                                imagePreview.classList.remove('d-none');
                            }
                            if (uploadArea) {
                                uploadArea.classList.add('d-none');
                            }
                        }

                        reader.readAsDataURL(this.files[0]);
                    }
                });
            }

            if (removeImageBtn) {
                removeImageBtn.addEventListener('click', () => {
                    if (imageInput) {
                        imageInput.value = '';
                    }
                    if (previewImg) {
                        previewImg.src = '';
                    }
                    if (imagePreview) {
                        imagePreview.classList.add('d-none');
                    }
                    if (uploadArea) {
                        uploadArea.classList.remove('d-none');
                    }
                });
            }

            // Initialize CKEditor
            function initializeCKEditor() {
                try {
                    if (typeof CKEDITOR === 'undefined') {
                        console.error('کتابخانه CKEditor لود نشده است!');
                        document.getElementById('Description').style.display = 'block';
                        return null;
                    }

                    CKEDITOR.plugins.addExternal('filebrowser', 'https://cdn.ckeditor.com/4.21.0/standard/plugins/filebrowser/', 'plugin.js');
                    CKEDITOR.plugins.addExternal('uploadimage', 'https://cdn.ckeditor.com/4.21.0/standard/plugins/uploadimage/', 'plugin.js');

                    const editor = CKEDITOR.replace('Description', {
                        language: 'fa',
                        height: 500,
                        width: '100%',
                        removePlugins: 'resize',
                        skin: 'moono-lisa',
                        extraPlugins: 'filebrowser,uploadimage',
                        filebrowserBrowseUrl: '/file-manager',
                        filebrowserUploadUrl: '/upload',
                        filebrowserImageUploadUrl: '/Upload/Article',
                        toolbar: [
                            { name: 'document', items: ['Source', '-', 'Save', 'NewPage', 'Preview', 'Print', '-', 'Templates'] },
                            { name: 'clipboard', items: ['Cut', 'Copy', 'Paste', 'PasteText', 'PasteFromWord', '-', 'Undo', 'Redo'] },
                            { name: 'editing', items: ['Find', 'Replace', '-', 'SelectAll', '-', 'Scayt'] },
                            { name: 'forms', items: ['Form', 'Checkbox', 'Radio', 'TextField', 'Textarea', 'Select', 'Button', 'ImageButton', 'HiddenField'] },
                            '/',
                            { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike', 'Subscript', 'Superscript', '-', 'CopyFormatting', 'RemoveFormat'] },
                            { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', 'CreateDiv', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock', '-', 'BidiLtr', 'BidiRtl', 'Language'] },
                            { name: 'links', items: ['Link', 'Unlink', 'Anchor'] },
                            { name: 'insert', items: ['Image', 'Flash', 'Table', 'HorizontalRule', 'Smiley', 'SpecialChar', 'PageBreak', 'Iframe'] },
                            '/',
                            { name: 'styles', items: ['Styles', 'Format', 'Font', 'FontSize'] },
                            { name: 'colors', items: ['TextColor', 'BGColor'] },
                            { name: 'tools', items: ['Maximize', 'ShowBlocks'] },
                            { name: 'about', items: ['About'] },
                            { name: 'filemanager', items: ['FileBrowser', 'Upload'] }
                        ],
                        on: {
                            instanceReady: function(evt) {
                                console.log('CKEditor با موفقیت مقداردهی اولیه شد!');
                            },
                            error: function(evt) {
                                console.error('خطای CKEditor:', evt.message);
                            }
                        }
                    });

                    // Apply styles to editor
                    editor.on('instanceReady', function() {
                        const editorElement = document.querySelector('.ck-editor');
                        if (editorElement) {
                            editorElement.style.borderRadius = '10px';
                            editorElement.style.overflow = 'hidden';
                        }
                    });

                    return editor;
                } catch (error) {
                    console.error('خطا در مقداردهی اولیه CKEditor:', error);
                    document.getElementById('Description').style.display = 'block';
                    return null;
                }
            }

            // Initialize CKEditor with delay
            setTimeout(initializeCKEditor, 300);

            if(@Model.Categories.Count() == 0){

                const submitButton = document.querySelector("#submitButton");
                submitButton.disabled = true; // Disable the button
            }


             var checkBox = document.getElementById("IndexPage");

            if( @Json.Serialize(Model.SeoData.IndexPage) === true){
                checkBox.checked = true;
                checkBox.value = true;

            }else{
                checkBox.checked = false;
                checkBox.value = false;

            }

            if (checkBox) {
                checkBox.addEventListener('change', function() {
                    if (this.checked) {
                         checkBox.value = true;
                    } else {
                    checkBox.value = false;
                    }
                });
            }
        });
    </script>
}