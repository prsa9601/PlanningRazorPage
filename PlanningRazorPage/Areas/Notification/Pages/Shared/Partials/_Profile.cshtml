                                   placeholder="example@domain.com" />
                            <label for="modalEditUserEmail">ایمیل</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-floating form-floating-outline">
                            <select id="modalEditUserStatus"
